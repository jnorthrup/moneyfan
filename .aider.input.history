+    void testCsvRecordParser() {
+        ByteBuffer buffer = ByteBuffer.wrap("field1,field2,field3\nrest_of_buffer".getBytes(StandardCharsets.UTF_8));
+        Cursive<List<String>> parser = CsvProcessor.csvRecordParser((byte) ',');
+        List<String> record = parser.apply(buffer);
+        assertEquals(3, record.size());
+        assertEquals("field1", record.get(0));
+        assertEquals("field2", record.get(1));
+        assertEquals("field3", record.get(2));
+        assertEquals("rest_of_buffer".length(), buffer.remaining()); // Only consumes the first line
+    }
