+**`bikeshed/src/main/java/com/yourdomain/bikeshed/core/CowSeriesHandle.java`**
+(Copy-On-Write series implementation)
+
+```java
+package com.yourdomain.bikeshed.core;
+
+import java.util.Objects;
+import java.util.function.IntFunction;
+import java.util.function.BiConsumer;
+
+/**
+ * A Copy-On-Write (COW) implementation of {@link MutableSeries}.
+ * This class acts as a handle (envelope) to an internal immutable {@link Series} (the letter).
+ * Any mutation operation ({@code set}, {@code add}, {@code remove}, {@code clear})
+ * creates a *new* immutable backing series, ensuring that previous references
+ * to the `CowSeriesHandle` logically represent a different state without
+ * direct modification of the previously exposed internal series.
+ *
+ * This design promotes functional purity and simplifies concurrent access patterns
+ * (readers don't need locks, writers perform atomic swaps of the internal reference).
+ *
+ * @param <T> The type of elements in the series.
+ */
+public class CowSeriesHandle<T> implements MutableSeries<T>, VersionedSeries<T> {
+
+    // The internal, immutable backing series. This reference is atomically swapped on mutation.
+    private volatile Series<T> backingSeries;
+    private long versionCounter; // Monotonically increasing version for changes
+
+    // Observers can be registered to react to changes in the backing series or version.
+    private BiConsumer<Series<T>, Series<T>> seriesObserver;
+    private BiConsumer<Long, Long> versionObserver;
+
+
+    /**
+     * Constructs a new {@code CowSeriesHandle} with an initial series.
+     *
+     * @param initialSeries The initial immutable series.
+     */
+    public CowSeriesHandle(Series<T> initialSeries) {
+        this.backingSeries = Objects.requireNonNull(initialSeries, "Initial series cannot be null.");
+        this.versionCounter = 0L; // Start version from 0
+    }
+
+    /**
+     * Creates a new, empty {@code CowSeriesHandle}.
+     *
+     * @param <T> The type of elements.
+     * @return An empty {@code CowSeriesHandle}.
+     */
+    public static <T> CowSeriesHandle<T> empty() {
+        return new CowSeriesHandle<>(Series.of(0, i -> null)); // Use a provider that always returns null for empty
+    }
+
+    /**
+     * Sets a callback to be invoked when the backing series changes.
+     * The callback receives the old and new backing series.
+     *
+     * @param observer The callback function.
+     */
+    public void setSeriesObserver(BiConsumer<Series<T>, Series<T>> observer) {
+        this.seriesObserver = observer;
+    }
+
+    /**
+     * Sets a callback to be invoked when the version changes.
+     * The callback receives the old and new version numbers.
+     *
+     * @param observer The callback function.
+     */
+    public void setVersionObserver(BiConsumer<Long, Long> observer) {
+        this.versionObserver = observer;
+    }
+
+    // --- Series interface implementations (delegated to backingSeries) ---
+
+    @Override
+    public Integer getFst() {
+        return backingSeries.getFst();
+    }
+
+    @Override
+    public IntFunction<T> getSnd() {
+        return backingSeries.getSnd();
+    }
+
+    @Override
+    public T get(int index) {
+        return backingSeries.get(index);
+    }
+
+    @Override
+    public int size() {
+        return backingSeries.size();
+    }
+
+    @Override
+    public Long getVersion() {
+        return versionCounter;
+    }
+
+    // --- MutableSeries interface implementations (trigger COW) ---
+
+    private void updateBackingSeries(Series<T> newBacking) {
+        Series<T> oldBacking = this.backingSeries;
+        long oldVersion = this.versionCounter;
+
+        this.backingSeries = newBacking;
+        this.versionCounter++;
+
+        if (seriesObserver != null) {
+            seriesObserver.accept(oldBacking, newBacking);
+        }
+        if (versionObserver != null) {
+            versionObserver.accept(oldVersion, this.versionCounter);
+        }
+    }
+
+    @Override
+    public void set(int index, T item) {
+        if (index < 0 || index >= size()) {
+            throw new IndexOutOfBoundsException("Index " + index + " out of bounds for size " + size());
+        }
+        updateBackingSeries(backingSeries.map(i -> (i == index) ? item : backingSeries.get(i)));
+    }
+
+    @Override
+    public void add(T item) {
+        add(size(), item); // Append to the end
+    }
+
+    @Override
+    public void add(int index, T item) {
+        if (index < 0 || index > size()) { // Allow adding at size() for append
+            throw new IndexOutOfBoundsException("Index " + index + " out of bounds for add operation (size " + size() + ")");
+        }
+
+        final int newSize = size() + 1;
+        updateBackingSeries(Series.of(newSize, i -> {
+            if (i < index) {
+                return backingSeries.get(i);
+            } else if (i == index) {
+                return item;
+            } else { // i > index
+                return backingSeries.get(i - 1);
+            }
+        }));
+    }
+
+    @Override
+    public T removeAt(int index) {
+        if (index < 0 || index >= size()) {
+            throw new IndexOutOfBoundsException("Index " + index + " out of bounds for remove operation (size " + size() + ")");
+        }
+
+        T removedItem = backingSeries.get(index); // Get item before modification
+        final int newSize = size() - 1;
+
+        if (newSize == 0) {
+            updateBackingSeries(Series.of(0, i -> null)); // Empty series
+        } else {
+            updateBackingSeries(Series.of(newSize, i -> {
+                if (i < index) {
+                    return backingSeries.get(i);
+                } else { // i >= index
+                    return backingSeries.get(i + 1);
+                }
+            }));
+        }
+        return removedItem;
+    }
+
+    @Override
+    public boolean remove(T item) {
+        // Linear scan for simplicity. For large series, consider more efficient removal if needed.
+        int indexToRemove = -1;
+        for (int i = 0; i < size(); i++) {
+            if (Objects.equals(backingSeries.get(i), item)) {
+                indexToRemove = i;
+                break;
+            }
+        }
+        if (indexToRemove != -1) {
+            removeAt(indexToRemove);
+            return true;
+        }
+        return false;
+    }
+
+    @Override
+    public void clear() {
+        updateBackingSeries(Series.of(0, i -> null));
+    }
+
+    @Override
+    public MutableSeries<T> plus(T item) {
+        add(item);
+        return this;
+    }
+
+    @Override
+    public MutableSeries<T> minus(T item) {
+        remove(item);
+        return this;
+    }
+
+    @Override
+    public void plusAssign(T item) {
+        add(item);
+    }
+
+    @Override
+    public void minusAssign(T item) {
+        remove(item);
+    }
+}
+```
