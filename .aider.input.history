+    private Path getResourcePath(String resourceName) {
+        try {
+            return Paths.get(Objects.requireNonNull(getClass().getResource(resourceName)).toURI());
+        } catch (Exception e) {
+            throw new RuntimeException("Cannot find resource: " + resourceName, e);
+        }
+    }
