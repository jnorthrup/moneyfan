+         * Modified classic sigmoid.
+         *
+        apply
+         */
+        override fun invoke(input: Double ): Double = (2.0 / (1.0 + exp(-(input * SLOPE))) - 1.0).toDouble ()
+
+        override fun applyDiff(x: Double ): Double = // As given by Wolfram Alpha
+            (2.0 * exp(-SLOPE * x) * SLOPE / (1 + exp(-SLOPE * x)).pow(2.0)).toDouble ()
+
+        /**
+        getMaxValue
+         */
+        override fun getMaxValue(): Double = 1.0
+
+        /**
+        getMinValue
+         */
+        override fun getMinValue(): Double = -1.0
+
+        /**
+        cost
+         */
+        override fun cost(): Long = 497
