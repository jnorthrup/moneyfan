+```java
+package com.yourdomain.bikeshed.types;
+
+import java.util.Objects;
+
+/**
+ * Represents metadata for a data column, combining its name and type information.
+ * This is effectively a `Join<String, TypeMemento>`.
+ * Using an interface with default methods for Kotlin-style mix-ins and static factory.
+ */
+public interface ColumnMeta {
+    String name();
+    TypeMemento type();
+
+    /**
+     * Static factory method to create a ColumnMeta instance.
+     *
+     * @param name The name of the column.
+     * @param type The type information for the column.
+     * @return A new ColumnMeta instance.
+     */
+    static ColumnMeta of(String name, TypeMemento type) {
+        Objects.requireNonNull(name, "Column name must not be null");
+        Objects.requireNonNull(type, "TypeMemento must not be null");
+        return new ColumnMeta() {
+            @Override
+            public String name() {
+                return name;
+            }
+
+            @Override
+            public TypeMemento type() {
+                return type;
+            }
+        };
+    }
+}
+```
