+/**
+ * Series->Set */
+fun <S> Join<Int, (Int) -> S>.toSet(opt: MutableSet<S>? = null): MutableSet<S> = (
+        opt
+            ?: LinkedHashSet(size)
+        ).also { hs -> hs.addAll(this.`▶`) }
