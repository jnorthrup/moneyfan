+**`bikeshed/src/main/java/com/yourdomain/bikeshed/core/VersionedSeries.java`**
+
+```java
+package com.yourdomain.bikeshed.core;
+
+/**
+ * Extends {@link Series} to include a version identifier.
+ * This is useful in Copy-On-Write (COW) contexts to track changes
+ * without resorting to deep equality checks, especially for memoization
+ * and cache invalidation.
+ *
+ * @param <T> The type of elements in the series.
+ */
+public interface VersionedSeries<T> extends Series<T> {
+    /**
+     * Gets the version of this series instance.
+     * A {@code null} version indicates that object identity should be used
+     * as the version discriminator (e.g., for simple immutable series
+     * where every modification creates a new object anyway).
+     * For COW implementations, this might be a monotonically increasing long.
+     *
+     * @return The version identifier, or {@code null} if not versioned explicitly.
+     */
+    Long getVersion();
+}
+```
