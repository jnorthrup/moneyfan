+        //        }
+        /**
+         * Returns 0 if the input <= 0, otherwise the input value.
+         *
+        apply
+         */
+        override fun invoke(x: Double ): Double = max(0.0, x)
+
+        override fun applyDiff(x: Double ): Double {
+            return if (x < 0) {
+                0.0
+            } else {
+                1.0
+            }
+        }
+
+        /**
+        getMaxValue
+         */
+        override fun getMaxValue(): Double = Double .MAX_VALUE
+
+        /**
+        getMinValue
