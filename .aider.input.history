+                    agentId, quantity, assetKey.baseAsset(), price, cost, assetKey.quoteAsset(), newWallet.getBaseBalance(assetKey), newWallet.getQuoteBalance(assetKey));
+                return D.jn(true, newWallet);
+            } else {
