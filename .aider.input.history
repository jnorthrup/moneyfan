+    public Series<T> plus(Series<T> other) {
+        Objects.requireNonNull(other, "other Series must not be null");
+        int newSize = this.size + other.size;
+        return new Series<>(newSize, i -> {
+            return (i < this.size) ? this.get(i) : other.get(i - this.size);
+        });
+    }
