+**3.3. `bikeshed/src/main/java/com/yourdomain/bikeshed/core/Series.java`**
+```java
+package com.yourdomain.bikeshed.core;
+
+import org.jetbrains.annotations.NotNull;
+
+import java.util.ArrayList;
+import java.util.Iterator;
+import java.util.List;
+import java.util.Objects;
+import java.util.function.Function;
+import java.util.function.IntFunction;
+import java.util.function.Predicate;
+import java.util.stream.IntStream;
+import java.util.stream.StreamSupport;
+
+/**
+ * Represents a cursor-based, immutable series of data.
+ * Internally, it's modeled as a `Join<Integer, Function<Integer, T>>`,
+ * where the first element is the size and the second is a provider function
+ * that generates an element at a given index.
+ * This structure enables lazy evaluation and efficient slicing/access patterns.
+ *
+ * @param <T> The type of elements in the series.
+ */
+public record Series<T>(Integer size, IntFunction<T> provider) implements Iterable<T> {
+
+    /**
+     * Factory method for creating a Series instance.
+     *
+     * @param size The number of elements in the series.
+     * @param provider A function that, given an integer index, returns the element at that index.
+     * @param <T> The type of elements.
+     * @return A new immutable Series instance.
+     */
+    public static <T> Series<T> of(int size, IntFunction<T> provider) {
+        if (size < 0) throw new IllegalArgumentException("Size cannot be negative.");
+        Objects.requireNonNull(provider, "Provider function must not be null.");
+        return new Series<>(size, provider);
+    }
+
+    /**
+     * Retrieves the element at the specified index.
+     *
+     * @param index The index of the element to retrieve.
+     * @return The element at the given index.
+     * @throws IndexOutOfBoundsException if the index is out of bounds (index < 0 or index >= size).
+     */
+    public T get(int index) {
+        if (index < 0 || index >= size) {
+            throw new IndexOutOfBoundsException("Index " + index + " out of bounds for Series of size " + size);
+        }
+        return provider.apply(index);
+    }
+
+    /**
+     * Returns a new Series representing a slice of the original Series.
+     * The new Series is also lazily evaluated.
+     *
+     * @param startIndex The inclusive start index of the slice.
+     * @param endIndex The exclusive end index of the slice.
+     * @return A new Series representing the specified slice.
+     * @throws IndexOutOfBoundsException if startIndex or endIndex are out of bounds or startIndex > endIndex.
+     */
+    public Series<T> slice(int startIndex, int endIndex) {
+        if (startIndex < 0 || startIndex > size || endIndex < 0 || endIndex > size || startIndex > endIndex) {
+            throw new IndexOutOfBoundsException("Slice indices [" + startIndex + ", " + endIndex + ") are out of bounds for Series of size " + size);
+        }
+        int newSize = endIndex - startIndex;
+        return new Series<>(newSize, i -> provider.apply(startIndex + i));
+    }
+
+    /**
+     * Applies a mapping function to each element, producing a new Series of transformed elements.
+     * This operation is compositional and lazy.
+     *
+     * @param mapper The function to apply to each element.
+     * @param <R> The type of elements in the new Series.
+     * @return A new Series with transformed elements.
+     */
+    public <R> Series<R> map(Function<? super T, ? extends R> mapper) {
+        Objects.requireNonNull(mapper, "Mapper function must not be null.");
+        return new Series<>(size, i -> mapper.apply(provider.apply(i)));
+    }
+
+    /**
+     * Filters the elements of the Series based on a predicate, producing a new Series.
+     * This operation is compositional. For simplicity in this DSEL stub, the filtered
+     * elements are eagerly collected into a list, and a new Series is created from it.
+     * A fully lazy implementation would involve more complex index mapping.
+     *
+     * @param predicate The predicate to apply to each element.
+     * @return A new Series containing only the elements that satisfy the predicate.
+     */
+    public Series<T> filter(Predicate<? super T> predicate) {
+        Objects.requireNonNull(predicate, "Predicate must not be null.");
+        List<T> materializedFilteredList = new ArrayList<>();
+        for (int i = 0; i < size; i++) {
+            T element = provider.apply(i);
+            if (predicate.test(element)) {
+                materializedFilteredList.add(element);
+            }
+        }
+        return new Series<>(materializedFilteredList.size(), materializedFilteredList::get);
+    }
+
+    /**
+     * Provides an iterator over the elements of the series.
+     *
+     * @return An iterator for the series.
+     */
+    @Override
+    public @NotNull Iterator<T> iterator() {
+        return new Iterator<>() {
+            private int currentIndex = 0;
+
+            @Override
+            public boolean hasNext() {
+                return currentIndex < size;
+            }
+
+            @Override
+            public T next() {
+                if (!hasNext()) {
+                    throw new java.util.NoSuchElementException();
+                }
+                return get(currentIndex++);
+            }
+        };
+    }
+
+    /**
+     * Convention-based operator overloading for '+' (concatenation).
+     * Creates a new Series by appending the elements of 'other' to this Series.
+     *
+     * @param other The Series to append.
+     * @return A new Series representing the concatenation.
+     */
+    public Series<T> plus(Series<T> other) {
+        Objects.requireNonNull(other, "other Series must not be null");
+        int newSize = this.size + other.size;
+        return new Series<>(newSize, i -> {
+            return (i < this.size) ? this.get(i) : other.get(i - this.size);
+        });
+    }
+
+    /**
+     * Convention-based operator overloading for '-' (difference or subtraction).
+     * Returns a new Series containing elements from this Series that do NOT satisfy the given predicate.
+     *
+     * @param condition The predicate used to determine which elements to remove.
+     * @return A new Series with elements filtered out.
+     */
+    public Series<T> minus(Predicate<T> condition) {
+        return filter(condition.negate());
+    }
+
+    /**
+     * Provides a Java Stream API view for compatibility.
+     *
+     * @return A Stream of elements from this Series.
+     */
+    public java.util.stream.Stream<T> stream() {
+        return StreamSupport.stream(spliterator(), false);
+    }
+}
+```
