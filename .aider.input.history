+**`bikeshed/src/main/java/com/yourdomain/bikeshed/core/D.java`**
+(Omnibus DSEL operations for `bikeshed`)
+
+```java
+package com.yourdomain.bikeshed.core;
+
+import java.util.List;
+import java.util.function.Function;
+import java.util.function.IntFunction;
+import java.util.function.Predicate;
+import java.util.stream.Collectors;
+
+/**
+ * Omnibus enum for common DSEL operations and factory methods.
+ * Provides concise, static-like access to core functionalities,
+ * mirroring Kotlin's extension functions and utility objects.
+ * This enum itself has no instances and its primary purpose is to group
+ * related static methods.
+ */
+public enum D {
+    // No instances needed, just a container for static methods.
+    ;
+
+    // --- Join related utilities ---
+
+    /**
+     * Shorthand for {@link Join#of(Object, Object)}.
+     * Glyph: `jn` for Join
+     *
+     * @param f   The first element.
+     * @param s   The second element.
+     * @param <F> The type of the first element.
+     * @param <S> The type of the second element.
+     * @return A new `Join` instance.
+     */
+    public static <F, S> Join<F, S> jn(F f, S s) {
+        return Join.of(f, s);
+    }
+
+    /**
+     * Shorthand for {@link Twin#of(Object, Object)}.
+     * Glyph: `tw` for Twin
+     *
