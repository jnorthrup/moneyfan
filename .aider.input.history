+(Omnibus utility functions for `bbcursive`)
+
+```java
+package com.yourdomain.bbcursive;
+
+import java.nio.ByteBuffer;
+import java.util.List;
+import java.util.Optional;
+import java.util.function.Function;
+import java.util.function.Predicate;
+
+/**
+ * Omnibus enum for common DSEL operations related to `bbcursive`.
+ * Provides concise, static-like access to core functionalities,
+ * mirroring Kotlin's extension functions and utility objects.
+ *
+ * This enum itself has no instances and its primary purpose is to group
+ * related static methods.
+ */
+public enum D {
+    // No instances needed, just a container for static methods.
+    // This is a common pattern for grouping utility methods in Java.
+    ;
+
+    // --- BBAtom related utilities ---
+
+    /**
+     * Shorthand for {@link BBAtom#readByte()}.
+     * Glyph: `β` (beta) for byte
+     * @return A Cursive to read a byte.
+     */
+    public static Cursive<Byte> β() {
+        return BBAtom.readByte();
+    }
+
+    /**
+     * Shorthand for {@link BBAtom#readInt()}.
+     * Glyph: `ι` (iota) for int
+     * @return A Cursive to read an int.
+     */
+    public static Cursive<Integer> ι() {
+        return BBAtom.readInt();
+    }
+
+    /**
+     * Shorthand for {@link BBAtom#readLong()}.
+     * Glyph: `λ` (lambda) for long (or potentially for function, but here used for Long)
+     * @return A Cursive to read a long.
+     */
+    public static Cursive<Long> λ() {
+        return BBAtom.readLong();
+    }
+
+    /**
+     * Shorthand for {@link BBAtom#readString(int)}.
+     * Glyph: `ς` (sigma, final form) for string
+     * @param length The length of the string to read.
+     * @return A Cursive to read a string.
+     */
+    public static Cursive<String> ς(int length) {
+        return BBAtom.readString(length);
+    }
+
+    /**
+     * Shorthand for {@link BBAtom#skip(int)}.
+     * Glyph: `⏩` (fast-forward) for skip
+     * @param offset The number of bytes to skip.
+     * @return A Cursive to skip bytes.
+     */
+    public static Cursive<Void> ⏩(int offset) {
+        return BBAtom.skip(offset);
+    }
+
+    /**
+     * Shorthand for {@link BBAtom#position(int)}.
+     * Glyph: `🅿` (P for position)
+     * @param newPosition The new position.
+     * @return A Cursive to set position.
+     */
+    public static Cursive<Void> 🅿(int newPosition) {
+        return BBAtom.position(newPosition);
+    }
+
+    /**
+     * Shorthand for {@link BBAtom#limit(int)}.
+     * Glyph: `🇱` (L for limit)
+     * @param newLimit The new limit.
+     * @return A Cursive to set limit.
+     */
+    public static Cursive<Void> 🇱(int newLimit) {
+        return BBAtom.limit(newLimit);
+    }
+
+    /**
+     * Shorthand for {@link BBAtom#slice()}.
+     * Glyph: `✂` (scissors for slice)
+     * @return A Cursive that returns a sliced ByteBuffer.
+     */
+    public static Cursive<ByteBuffer> ✂() {
+        return BBAtom.slice();
+    }
+
+    // --- BBCombinator related utilities ---
+
+    /**
+     * Shorthand for {@link BBCombinator#many(Cursive)}.
+     * Glyph: `*` (asterisk for zero or more)
+     * @param parser The parser to apply repeatedly.
+     * @param <T> The type of the parsed result for each application.
+     * @return A Cursive that returns a List of parsed results.
+     */
+    public static <T> Cursive<List<T>> star(Cursive<T> parser) {
+        return BBCombinator.many(parser);
+    }
+
+    /**
+     * Shorthand for {@link BBCombinator#many1(Cursive)}.
+     * Glyph: `+` (plus for one or more)
+     * @param parser The parser to apply repeatedly.
+     * @param <T> The type of the parsed result for each application.
+     * @return A Cursive that returns a List of parsed results.
+     */
+    public static <T> Cursive<List<T>> plus(Cursive<T> parser) {
+        return BBCombinator.many1(parser);
+    }
+
+
+    /**
+     * Shorthand for {@link BBCombinator#optional(Cursive)}.
+     * Glyph: `?` (question mark for optional)
+     * @param parser The parser to apply.
+     * @param <T> The type of the parsed result.
+     * @return A Cursive that returns an Optional of the parsed result.
+     */
+    public static <T> Cursive<Optional<T>> q(Cursive<T> parser) {
+        return BBCombinator.optional(parser);
+    }
+
+    /**
+     * Shorthand for {@link BBCombinator#map(Cursive, Function)}.
+     * Glyph: `α` (alpha) for map/transform
+     * @param parser The parser to apply.
+     * @param mapper The function to transform the result.
+     * @param <T> The original type of the parsed result.
+     * @param <R> The transformed type of the result.
+     * @return A Cursive that applies the parser and then maps its result.
+     */
+    public static <T, R> Cursive<R> α(Cursive<T> parser, Function<T, R> mapper) {
+        return BBCombinator.map(parser, mapper);
+    }
+
+    /**
+     * Shorthand for {@link BBCombinator#choice(Cursive[])}.
+     * Glyph: `|` (pipe for choice)
+     * @param parsers An array of parsers to try.
+     * @param <T> The common result type of the parsers.
+     * @return A Cursive that returns the result of the first successful parser.
+     */
+    @SafeVarargs
+    public static <T> Cursive<T> or(Cursive<T>... parsers) {
+        return BBCombinator.choice(parsers);
+    }
+
+    /**
+     * Shorthand for {@link Cursive#sequence(Cursive, Function)}.
+     * Glyph: `»` (double right arrow for sequence)
+     * @param first The first parser.
+     * @param second The second parser, which takes the result of the first.
+     * @param <A> The result type of the first parser.
+     * @param <B> The result type of the second parser.
+     * @return A Cursive that applies first then second.
+     */
+    public static <A, B> Cursive<B> seq(Cursive<A> first, Function<A, Cursive<B>> second) {
+        return Cursive.sequence(first, second);
+    }
+}
