+
+        // Test decoding
+        ByteBuffer buffer = ByteBuffer.wrap("test      ".getBytes(StandardCharsets.UTF_8)); // Padded string
+        assertEquals("test", ((String) IOMemento.IoString.createDecoder(fixedStringSize).apply(buffer)).trim());
+
+        ByteBuffer buffer2 = ByteBuffer.wrap("abcd".getBytes(StandardCharsets.UTF_8)); // Short string in buffer
+        assertEquals("abcd", ((String) IOMemento.IoString.createDecoder(4).apply(buffer2)).trim());
+    }
