+`bikeshed/src/main/java/com/yourdomain/bikeshed/dsel/D.java`
+```java
+package com.yourdomain.bikeshed.dsel;
+
+import com.yourdomain.bikeshed.core.Join;
+import com.yourdomain.bikeshed.core.Series;
+import com.yourdomain.bikeshed.core.RowVec;
+import com.yourdomain.bikeshed.core.Twin;
+import com.yourdomain.bikeshed.types.ColumnMeta;
+import com.yourdomain.bikeshed.types.IOMemento;
+
+import java.util.List;
+import java.util.Objects;
+import java.util.function.BiFunction;
+import java.util.function.Function;
+import java.util.function.IntFunction;
+import java.util.function.Predicate;
+import java.util.function.Supplier;
+
+public enum D {
+    INSTANCE;
+
+    // --- Join Operations (Glyph: jn) ---
+    public static <F, S> Join<F, S> jn(F f, S s) { return Join.of(f, s); }
+    public static <F, S, R> Join<R, S> αFst(Join<F, S> join, Function<? super F, ? extends R> mapper) {
+        Objects.requireNonNull(join, "join must not be null"); Objects.requireNonNull(mapper, "mapper must not be null");
+        return join.mapFst(mapper);
+    }
+    public static <F, S, R> Join<F, R> αSnd(Join<F, S> join, Function<? super S, ? extends R> mapper) {
+        Objects.requireNonNull(join, "join must not be null"); Objects.requireNonNull(mapper, "mapper must not be null");
+        return join.mapSnd(mapper);
+    }
+    public static <F, S, R1, R2> Join<R1, R2> αBoth(Join<F, S> join, Function<? super F, ? extends R1> fstMapper, Function<? super S, ? extends R2> sndMapper) {
+        Objects.requireNonNull(join, "join must not be null"); Objects.requireNonNull(fstMapper, "fstMapper must not be null"); Objects.requireNonNull(sndMapper, "sndMapper must not be null");
+        return join.mapBoth(fstMapper, sndMapper);
+    }
+    public static <F, S> Join<S, F> swap(Join<F, S> join) { Objects.requireNonNull(join, "join must not be null"); return join.swap(); }
+    public static <F, S, R> R α(Join<F, S> join, BiFunction<? super F, ? super S, ? extends R> mapper) {
+        Objects.requireNonNull(join, "join must not be null"); Objects.requireNonNull(mapper, "mapper must not be null");
+        return join.map(mapper);
+    }
+
+    // --- Series Operations (Glyph: sr) ---
+    public static <T> Series<T> sr(int size, IntFunction<T> provider) { return Series.of(size, provider); }
+    public static <T> Series<T> sr(List<T> list) { Objects.requireNonNull(list, "list must not be null"); return Series.of(list.size(), list::get); }
+    public static <T, R> Series<R> α(Series<T> series, Function<? super T, ? extends R> mapper) {
+        Objects.requireNonNull(series, "series must not be null"); Objects.requireNonNull(mapper, "mapper must not be null");
+        return series.map(mapper);
+    }
+    public static <T> Series<T> filter(Series<T> series, Predicate<? super T> predicate) {
+        Objects.requireNonNull(series, "series must not be null"); Objects.requireNonNull(predicate, "predicate must not be null");
+        return series.filter(predicate);
+    }
+    public static <T> T get(Series<T> series, int index) { Objects.requireNonNull(series, "series must not be null"); return series.get(index); }
+    public static <T> Series<T> slice(Series<T> series, int startIndex, int endIndex) {
+        Objects.requireNonNull(series, "series must not be null"); return series.slice(startIndex, endIndex);
+    }
+    public static <T> Series<T> plus(Series<T> s1, Series<T> s2) {
+        Objects.requireNonNull(s1, "series1 must not be null"); Objects.requireNonNull(s2, "series2 must not be null");
+        return s1.plus(s2);
+    }
+    public static <T> Series<T> minus(Series<T> s1, Predicate<T> predicate) {
+        Objects.requireNonNull(s1, "series must not be null"); Objects.requireNonNull(predicate, "predicate must not be null");
+        return s1.minus(predicate);
+    }
+
+    // --- RowVec Operations (Glyph: rv) ---
+    @SafeVarargs
+    public static RowVec rv(Join<Object, Supplier<ColumnMeta>>... valuesAndMeta) { return RowVec.of(valuesAndMeta); }
+
+    // --- Twin Operations (Glyph: tw) ---
+    public static <T> Twin<T> tw(T value1, T value2) { return Twin.of(value1, value2); }
+
+    // --- Type Memento Operations (Glyph: typ) ---
+    public static class Typ {
+        public final IOMemento IoBoolean = IOMemento.IoBoolean; public final IOMemento IoByte = IOMemento.IoByte;
+        public final IOMemento IoShort = IOMemento.IoShort; public final IOMemento IoInt = IOMemento.IoInt;
+        public final IOMemento IoLong = IOMemento.IoLong; public final IOMemento IoFloat = IOMemento.IoFloat;
+        public final IOMemento IoDouble = IOMemento.IoDouble; public final IOMemento IoChar = IOMemento.IoChar;
+        public final IOMemento IoLocalDate = IOMemento.IoLocalDate; public final IOMemento IoInstant = IOMemento.IoInstant;
+        public final IOMemento IoString = IOMemento.IoString; public final IOMemento IoByteArray = IOMemento.IoByteArray;
+        public final IOMemento IoNothing = IOMemento.IoNothing;
+        public Integer getStringLength(String name) { return IOMemento.STRING_LENGTH_CONFIG.get(name); }
+    }
+    public static final Typ typ = new Typ();
+
+    // --- ColumnMeta Operations (Glyph: cm) ---
+    public static ColumnMeta cm(String name, IOMemento type) { return ColumnMeta.of(name, type); }
+}
