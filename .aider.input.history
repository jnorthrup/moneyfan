+                Map<AssetKey, Double> newBaseBalances = new HashMap<>(baseBalances);
+                Map<AssetKey, Double> newQuoteBalances = new HashMap<>(quoteBalances);
+                newBaseBalances.put(assetKey, baseBalance + quantity);
