+**`bbcursive/src/main/java/com/yourdomain/bbcursive/BBCombinator.java`**
+(Higher-order ByteBuffer parsing functions)
+
+```java
+package com.yourdomain.bbcursive;
+
+import java.nio.ByteBuffer;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Optional;
+import java.util.function.Predicate;
+import java.util.function.Function;
+
+/**
+ * Provides higher-order parsing functions (combinators) for ByteBuffer,
+ * allowing composition of simpler {@link Cursive} instances into complex grammars.
+ */
+public enum BBCombinator implements Cursive<Void> {
+    ; // No enum instances, static methods only
+
+    /**
+     * A combinator that applies a parser zero or more times, collecting results into a list.
+     *
+     * @param parser The parser to apply repeatedly.
+     * @param <T> The type of the parsed result for each application.
+     * @return A Cursive that returns a List of parsed results.
+     */
+    public static <T> Cursive<List<T>> many(Cursive<T> parser) {
+        return buffer -> {
+            List<T> results = new ArrayList<>();
+            // Capture initial state to detect if parser consumes any input
+            int initialPosition = buffer.position();
+            try {
+                while (buffer.hasRemaining()) {
+                    T result = parser.apply(buffer);
+                    // Check if parser actually consumed input to prevent infinite loops
+                    if (buffer.position() == initialPosition) {
+                        break; // Parser didn't consume anything, stop
+                    }
+                    results.add(result);
+                    initialPosition = buffer.position(); // Update for next iteration
+                }
+            } catch (Exception e) {
+                // If the parser fails (e.g., ran out of bounds), stop and return what we have
+                // This is a simple error handling; more sophisticated parsing might rethrow or return Either
+            }
+            return results;
+        };
+    }
+
+    /**
+     * A combinator that applies a parser one or more times, collecting results into a list.
+     * Fails if the parser cannot be applied at least once.
+     *
+     * @param parser The parser to apply repeatedly.
+     * @param <T> The type of the parsed result for each application.
+     * @return A Cursive that returns a List of parsed results.
+     */
+    public static <T> Cursive<List<T>> many1(Cursive<T> parser) {
+        return buffer -> {
+            List<T> results = new ArrayList<>();
+            // First parse (must succeed)
+            T firstResult = parser.apply(buffer); // This will throw if it fails, which is desired for many1
+            results.add(firstResult);
+
+            // Then apply many
+            results.addAll(many(parser).apply(buffer));
+            return results;
+        };
+    }
+
+
+    /**
+     * A combinator that optionally applies a parser.
+     *
+     * @param parser The parser to apply.
+     * @param <T> The type of the parsed result.
+     * @return A Cursive that returns an Optional of the parsed result.
+     */
+    public static <T> Cursive<Optional<T>> optional(Cursive<T> parser) {
+        return buffer -> {
+            int originalPosition = buffer.position();
+            try {
+                T result = parser.apply(buffer);
+                return Optional.of(result);
+            } catch (Exception e) {
+                // If parser fails, rewind and return empty Optional
+                buffer.position(originalPosition);
+                return Optional.empty();
+            }
+        };
+    }
+
+    /**
+     * A combinator that applies a parser and then transforms its result using a function.
+     *
+     * @param parser The parser to apply.
+     * @param mapper The function to transform the result.
+     * @param <T> The original type of the parsed result.
+     * @param <R> The transformed type of the result.
+     * @return A Cursive that applies the parser and then maps its result.
+     */
+    public static <T, R> Cursive<R> map(Cursive<T> parser, Function<T, R> mapper) {
+        return buffer -> mapper.apply(parser.apply(buffer));
+    }
+
+    /**
+     * A combinator that applies a parser if a predicate holds true for the current buffer state.
+     *
+     * @param predicate The predicate to test.
+     * @param parser The parser to apply if the predicate is true.
+     * @param <T> The type of the parsed result.
+     * @return A Cursive that returns an Optional of the parsed result.
+     */
+    public static <T> Cursive<Optional<T>> cond(Predicate<ByteBuffer> predicate, Cursive<T> parser) {
+        return buffer -> {
+            int originalPosition = buffer.position();
+            if (predicate.test(buffer.duplicate())) { // Use duplicate to avoid side-effects on original buffer for predicate check
+                return Optional.of(parser.apply(buffer));
+            }
+            return Optional.empty();
+        };
+    }
+
+    /**
+     * A combinator that tries multiple parsers in order and returns the result of the first successful one.
+     *
+     * @param parsers An array of parsers to try.
+     * @param <T> The common result type of the parsers.
+     * @return A Cursive that returns the result of the first successful parser.
+     * @throws IllegalArgumentException if no parser succeeds.
+     */
+    @SafeVarargs
+    public static <T> Cursive<T> choice(Cursive<T>... parsers) {
+        return buffer -> {
+            int originalPosition = buffer.position();
+            for (Cursive<T> parser : parsers) {
+                try {
+                    T result = parser.apply(buffer);
+                    return result; // Successfully parsed
+                } catch (Exception e) {
+                    buffer.position(originalPosition); // Rewind for the next choice
+                }
+            }
+            throw new IllegalArgumentException("No parser succeeded among choices.");
+        };
+    }
+
+    @Override
+    public Void apply(ByteBuffer byteBuffer) {
+        throw new UnsupportedOperationException("BBCombinator enum entries are not meant to be applied directly. Use static methods.");
+    }
+}
+```
+
