+**`bikeshed/src/main/java/com/yourdomain/bikeshed/cursor/SimpleCursor.java`**
+
+```java
+package com.yourdomain.bikeshed.cursor;
+
+import com.yourdomain.bikeshed.core.Join;
+import com.yourdomain.bikeshed.core.Series;
+import com.yourdomain.bikeshed.isam.RecordMeta;
+import com.yourdomain.bikeshed.isam.meta.IOMemento;
+
+import java.util.function.IntFunction;
+import java.util.function.Supplier;
+
+/**
+ * A simple, in-memory implementation of {@link Cursor}, primarily for testing
+ * and demonstration purposes. It wraps a list of `Series<Object>` for data
+ * and a `Series<ColumnMeta>` for schema.
+ *
+ * This implementation is not optimized for large datasets or memory-mapped files,
+ * but showcases the API.
+ */
+public class SimpleCursor implements Cursor {
+
+    private final Series<RowVec> rows;
+    private final Series<ColumnMeta> schema;
+
+    /**
+     * Creates a SimpleCursor.
+     *
+     * @param data   A Series where each element is a Series of raw values for a row.
+     *               (Effectively Series<Series<Object>> representing rows of values).
+     * @param schema A Series of ColumnMeta objects defining the schema.
+     */
+    public SimpleCursor(Series<Series<Object>> data, Series<ColumnMeta> schema) {
+        this.schema = schema;
+
+        // Convert data into Series<RowVec>
+        int numRows = data.size();
+        IntFunction<RowVec> rowProvider = rowIndex -> {
+            Series<Object> valuesInRow = data.get(rowIndex);
+            return RowVec.of(valuesInRow.size(), colIndex -> {
+                Object value = valuesInRow.get(colIndex);
+                // The supplier captures column meta from the schema for lazy access
+                Supplier<ColumnMeta> metaSupplier = () -> schema.get(colIndex);
+                return Join.of(value, metaSupplier);
+            });
+        };
+        this.rows = Series.of(numRows, rowProvider);
+    }
+
+    @Override
+    public Integer getFst() {
+        return rows.getFst();
+    }
+
+    @Override
+    public IntFunction<RowVec> getSnd() {
+        return rows.getSnd();
+    }
+
+    @Override
+    public Series<ColumnMeta> getMeta() {
+        return schema;
+    }
+
+    /**
+     * Convenience factory method for creating a SimpleCursor from a list of list of objects
+     * and a list of column names (assuming all are String type for simplicity here).
+     */
+    public static SimpleCursor of(List<List<Object>> data, List<String> columnNames) {
+        Series<Series<Object>> dataSeries = Series.of(data.size(), data::get);
+        Series<ColumnMeta> schemaSeries = Series.of(columnNames.size(), i ->
+                // For simplicity, default to IoString for all columns if type is not provided
+                new RecordMeta(columnNames.get(i), IOMemento.IoString));
+        return new SimpleCursor(dataSeries, schemaSeries);
+    }
+
+    /**
+     * Convenience factory method to create a SimpleCursor from a List of Lists of Objects,
+     * and a List of ColumnMeta directly.
+     */
+    public static SimpleCursor ofWithMeta(List<List<Object>> data, List<ColumnMeta> columnMetas) {
+        Series<Series<Object>> dataSeries = Series.of(data.size(), data::get);
+        Series<ColumnMeta> schemaSeries = Series.of(columnMetas.size(), columnMetas::get);
+        return new SimpleCursor(dataSeries, schemaSeries);
+    }
+}
+```
