+```java
+package com.yourdomain.bikeshed.core;
+
+/**
+ * A specialized {@link Join} where both elements are of the same type.
+ * Useful for symmetric pairs or ranges.
+ *
+ * @param <T> The type of both elements.
+ */
+public interface Twin<T> extends Join<T, T> {
+
+    /**
+     * Factory method to create a `Twin` instance.
+     *
+     * @param t1  The first element.
+     * @param t2  The second element.
+     * @param <T> The type of both elements.
+     * @return A new `Twin` instance.
+     */
+    static <T> Twin<T> of(T t1, T t2) {
+        return new ImmutableTwin<>(t1, t2);
+    }
+
+    /**
+     * Internal immutable implementation of `Twin`.
+     */
+    class ImmutableTwin<T> extends Join.ImmutableJoin<T, T> implements Twin<T> {
+        private ImmutableTwin(T fst, T snd) {
+            super(fst, snd);
+        }
+    }
+}
