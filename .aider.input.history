+**`bikeshed/src/main/java/com/yourdomain/bikeshed/core/Series2.java`**
+(Type alias for `Series<Join<A, B>>` with convenience accessors)
+
+```java
+package com.yourdomain.bikeshed.core;
+
+import java.util.function.Function;
+
+/**
+ * Type alias for {@code Series<Join<A, B>>}. Represents a series where each element
+ * is itself a pair of two values. This is common for data structures that group
+ * values with metadata, or composite records.
+ *
+ * Convenience methods provide easy access to the 'left' (first) and 'right' (second)
+ * components of the inner {@code Join} instances, essentially projecting the series
+ * onto one of its components.
+ *
+ * @param <A> The type of the first component of the inner Join.
+ * @param <B> The type of the second component of the inner Join.
+ */
+public interface Series2<A, B> extends Series<Join<A, B>> {
+
+    /**
+     * Returns a new {@code Series} consisting of only the 'first' components
+     * ({@code A}) of the inner {@code Join} elements.
+     * Glyph: `←` (left arrow for left projection)
+     *
+     * @return A new {@code Series} of type A.
+     */
+    default Series<A> left() {
+        return map(Join::getFst);
+    }
+
+    /**
+     * Returns a new {@code Series} consisting of only the 'second' components
+     * ({@code B}) of the inner {@code Join} elements.
+     * Glyph: `→` (right arrow for right projection)
+     *
+     * @return A new {@code Series} of type B.
+     */
+    default Series<B> right() {
+        return map(Join::getSnd);
+    }
+
+    /**
+     * A factory method to create a {@code Series2} from a size and a provider.
+     *
+     * @param size The size of the series.
+     * @param provider A function providing a {@code Join<A, B>} for each index.
+     * @param <A> The type of the first component.
+     * @param <B> The type of the second component.
+     * @return A new {@code Series2} instance.
+     */
+    static <A, B> Series2<A, B> of(int size, IntFunction<Join<A, B>> provider) {
+        return new Series2Impl<>(size, provider);
+    }
+
+    /**
+     * Internal implementation of {@code Series2}.
+     */
+    class Series2Impl<A, B> extends Series.ImmutableSeries<Join<A, B>> implements Series2<A, B> {
+        private Series2Impl(int size, IntFunction<Join<A, B>> provider) {
+            super(size, provider);
+        }
+    }
+}
+```
