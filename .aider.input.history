+    /**
+     * Square-root function.
+     *
+     * @author Oliver Coleman
+     */
+    Sqrt /*implements , DifferentiableFunction*/ {
+        /**
+         * identifying string
+         */
+
+
+        /**
+         * This class should only be accessd via Factory.
+         */
+        //        Sqrt() {
+        //            // no-op
+        //        }
+        /**
+        apply
+         */
+        override fun invoke(input: Double ): Double {
+            if (input > 0) {
+                return sqrt(input)
+            }
+            return if (input < 0) {
+                -sqrt(-input)
+            } else 0.0
+        }
+
+        override fun applyDiff(x: Double ): Double {
+            return if (x > 0) {
+                1f / 2f * sqrt(x)
+            } else if (x < 0) {
+                1f / 2f * sqrt(-x)
+            } else 0.0
+        }
+
+        /**
+        getMaxValue
+         */
+        override fun getMaxValue(): Double = Double .MAX_VALUE
+
+        /**
+        getMinValue
+         */
+        override fun getMinValue(): Double = -Double .MAX_VALUE
+
+        /**
+        cost
+         */
+        override fun cost(): Long = 75
+    },
+
+    /**
+     * Square-root function for values with magnitude > 1, otherwise linear.
+     *
+     * @author Oliver Coleman
+     */
+    SqrtAndLinear /*implements , DifferentiableFunction*/ {
+        /**
+         * identifying string
+         */
+
+
+        /**
+         * This class should only be accessd via Factory.
+         */
+        //        SqrtAndLinear() {
+        //            // no-op
+        //        }
+        /**
+        apply
+         */
+        override fun invoke(input: Double ): Double {
+            if (input >= -1 && input <= 1) {
+                return input
+            }
+            return if (input > 0) {
+                sqrt(input)
+            } else {
+                -sqrt(-input)
+            }
+        }
+
+        override fun applyDiff(x: Double ): Double {
+            if (x >= -1 && x <= 1) {
+                return 1.0
+            }
+            return if (x > 0) {
+                1 / 2 * sqrt(x)
+            } else {
+                1 / 2 * sqrt(-x)
+            }
+        }
+
+        /**
+        getMaxValue
+         */
+        override fun getMaxValue(): Double = Double .MAX_VALUE
+
+        /**
+        getMinValue
+         */
+        override fun getMinValue(): Double = -Double .MAX_VALUE
+
+        /**
+        cost
+         */
+        override fun cost(): Long = 75
+    },
+
+    /**
+     * Steepened Sigmoid with slope of 4.9.
+     *
+     * @author Philip Tucker
+     */
+    SteepSigmoid /*implements , DifferentiableFunction*/ {
+        public val SLOPE = 4.9
+
+        /**
+         * identifying string
+         */
+
+
+        /**
+         * This class should only be accessed via Factory.
+         */
+        //        SteepSigmoid() {
+        //        }
+        override fun invoke(input: Double ): Double = (1.0 / (1.0 + exp(-(input * SLOPE)))).toDouble ()
+
+        override fun applyDiff(x: Double ): Double = (SLOPE * exp(-SLOPE * x) / (1 + exp(-SLOPE * x)).pow(2.0)).toDouble ()
+
+        /**
+        getMaxValue
+         */
+        override fun getMaxValue(): Double = 1.0
+
+        /**
+        getMinValue
+         */
+        override fun getMinValue(): Double = 0.0
+
+        /**
+        cost
+         */
+        override fun cost(): Long = 497
+    },
