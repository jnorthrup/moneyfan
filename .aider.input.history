+package com.yourdomain.bikeshed.types;
+
+/**
+ * Interface representing a type system definition.
+ * All concrete types (like primitives, strings, instants) will implement this.
+ */
+public interface TypeMemento {
+    /**
+     * The fixed size of the type in bytes for network/disk serialization.
+     * Returns null for variable-length types (e.g., String).
+     * @return The fixed size in bytes, or null if variable-length.
+     */
+    Integer getNetworkSize();
+}
+```
