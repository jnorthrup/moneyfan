+    fun tailMap(fromKey: K, inclusive: Boolean): NavigableMap<K, V>?
+
+    /**
+     * {@inheritDoc}
+     *
+     *
+     * Equivalent to `subMap(fromKey, true, toKey, false)`.
+     *
+     * @throws ClassCastException       {@inheritDoc}
