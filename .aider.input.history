+package pairwise.idiom.neat
+
+import org.junit.jupiter.api.Assertions.*
+import org.junit.jupiter.api.BeforeEach
+import org.junit.jupiter.api.Test
+
+class GnomeTest {
+
+    @BeforeEach
+    fun setUp() {
+        Environment.sim = Sim(
+            INPUTS = 2,
+            BIAS = 1,
+            HIDDEN = 3,
+            OUTPUTS = 1,
+            POPULATION = 1,
+            CONN_DENSITY = 0.1,
+            W = 0.0
+        )
+    }
+
+    @Test
+    fun `gnome initializes with correct number of jeans and impulse size`() {
+        val gnome = Gnome()
+        val expectedJeansCount = Environment.sim.HIDDEN + Environment.sim.OUTPUTS
+        assertEquals(expectedJeansCount, gnome.jeans.size, "Gnome should have HIDDEN + OUTPUTS jeans")
+        assertEquals(expectedJeansCount, gnome.impulse.size, "Gnome impulse array should match jeans count")
+    }
+
+    @Test
+    fun `gnome output jeans initialize with Linear activation function`() {
+        val gnome = Gnome()
+        val sim = Environment.sim
+        for (i in sim.HIDDEN until (sim.HIDDEN + sim.OUTPUTS)) {
+            assertEquals(ActivationFunction.Linear, gnome.jeans[i].af, "Output jean at index $i should use Linear AF")
+        }
+    }
+
+    @Test
+    fun `gnome hidden jeans initialize with an activation function from cached list`() {
+        val gnome = Gnome()
+        val sim = Environment.sim
+        if (0 < sim.HIDDEN) {
+            assertTrue(
+                ActivationFunction.cached.contains(gnome.jeans[0].af),
+                "Hidden jean AF should be from cached list"
+            )
+        }
+    }
+
+    @Test
+    fun `gnome copy constructor creates deep copies of jeans and impulse`() {
+        val originalGnome = Gnome()
+        if (originalGnome.impulse.isNotEmpty()) {
+            originalGnome.impulse[0] = 1.2345
+        }
+        if (originalGnome.jeans.isNotEmpty()) {
+            // Change AF of first jean to test deep copy of Jean object
+            originalGnome.jeans[0].af =
+                if (ActivationFunction.cached.size > 1 && originalGnome.jeans[0].af == ActivationFunction.cached[0]) ActivationFunction.cached[1] else ActivationFunction.cached[0]
+            // Add an input to test deep copy of inputs IntArray
+            if (Environment.sim.INPUTS > 0) originalGnome.jeans[0].addInput(0)
+        }
+
+        val copiedGnome = Gnome(originalGnome)
+
+        assertNotSame(originalGnome.jeans, copiedGnome.jeans, "Jeans array should be a new instance")
+        assertNotSame(originalGnome.impulse, copiedGnome.impulse, "Impulse array should be a new instance")
+        assertArrayEquals(originalGnome.impulse, copiedGnome.impulse, "Impulse content should be copied")
+
+        assertEquals(originalGnome.jeans.size, copiedGnome.jeans.size, "Copied gnome should have same number of jeans")
+        if (originalGnome.jeans.isNotEmpty()) {
+            assertNotSame(
+                originalGnome.jeans[0],
+                copiedGnome.jeans[0],
+                "Individual Jean objects should be new instances"
+            )
+            assertEquals(originalGnome.jeans[0].af, copiedGnome.jeans[0].af, "Jean AF should be copied")
+            assertArrayEquals(
+                originalGnome.jeans[0].inputs,
+                copiedGnome.jeans[0].inputs,
+                "Jean inputs should be copied"
+            )
+            if (originalGnome.jeans[0].inputs.isNotEmpty()) {
+                assertNotSame(
+                    originalGnome.jeans[0].inputs,
+                    copiedGnome.jeans[0].inputs,
+                    "Jean inputs IntArray should be a new instance"
+                )
+            }
+        }
+    }
+}
