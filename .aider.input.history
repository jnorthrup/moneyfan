+package com.yourdomain.bikeshed.core;
+
+import java.util.Objects;
+
+/**
+ * A specialized {@link Join} for symmetric pairs, where both elements are of the same type.
+ * This serves as a conceptual type alias for `Join<T, T>`.
+ *
+ * @param <T> The type of both elements in the pair.
+ */
+public class Twin<T> extends Join<T, T> {
+    public Twin(T first, T second) {
+        super(first, second);
+    }
+
+    /**
+     * Factory method for creating a Twin instance.
+     *
+     * @param value1 The first element.
+     * @param value2 The second element.
+     * @param <T> The type of elements.
+     * @return A new immutable Twin instance.
+     */
+    public static <T> Twin<T> of(T value1, T value2) {
+        Objects.requireNonNull(value1, "first value must not be null");
+        Objects.requireNonNull(value2, "second value must not be null");
+        return new Twin<>(value1, value2);
+    }
+}
