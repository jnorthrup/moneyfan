+### Core DSEL Java Files (`bikeshed` module)
+
+**`bikeshed/src/main/java/com/yourdomain/bikeshed/core/Join.java`**
+(Immutable 2-tuple, the DSEL's primitive)
+
+```java
+package com.yourdomain.bikeshed.core;
+
+import java.util.Objects;
+import java.util.function.Function;
+import java.util.stream.Collectors;
+import java.util.stream.Stream;
+
+/**
+ * The foundational primitive of the DSEL: an immutable 2-tuple.
+ * All operations on `Join` or its derived types must be compositional,
+ * producing new instances rather than modifying existing ones.
+ *
+ * @param <F> The type of the first element (Fst).
+ * @param <S> The type of the second element (Snd).
+ */
+public interface Join<F, S> {
+
+    /**
+     * Gets the first element.
+     * Alias: `a` (alpha for first)
+     *
+     * @return The first element.
+     */
+    F getFst();
+
+    /**
+     * Gets the second element.
+     * Alias: `b` (beta for second)
+     *
+     * @return The second element.
+     */
+    S getSnd();
+
+    /**
+     * Factory method to create a `Join` instance.
+     *
+     * @param f   The first element.
+     * @param s   The second element.
+     * @param <F> The type of the first element.
+     * @param <S> The type of the second element.
+     * @return A new `Join` instance.
+     */
+    static <F, S> Join<F, S> of(F f, S s) {
+        return new ImmutableJoin<>(f, s);
+    }
+
+    /**
+     * Applies a mapping function to the first element, producing a new `Join`.
+     * Compositional operation.
+     *
+     * @param mapper The function to apply to the first element.
+     * @param <R>    The new type of the first element.
+     * @return A new `Join` with the transformed first element.
+     */
+    default <R> Join<R, S> mapFst(Function<? super F, ? extends R> mapper) {
+        return Join.of(mapper.apply(getFst()), getSnd());
+    }
+
+    /**
+     * Applies a mapping function to the second element, producing a new `Join`.
+     * Compositional operation.
+     *
+     * @param mapper The function to apply to the second element.
+     * @param <R>    The new type of the second element.
+     * @return A new `Join` with the transformed second element.
+     */
+    default <R> Join<F, R> mapSnd(Function<? super S, ? extends R> mapper) {
+        return Join.of(getFst(), mapper.apply(getSnd()));
+    }
+
+    /**
+     * Applies two mapping functions to both elements, producing a new `Join`.
+     * Compositional operation.
+     *
+     * @param fstMapper The function to apply to the first element.
+     * @param sndMapper The function to apply to the second element.
+     * @param <R1>      The new type of the first element.
+     * @param <R2>      The new type of the second element.
+     * @return A new `Join` with both elements transformed.
+     */
+    default <R1, R2> Join<R1, R2> mapBoth(Function<? super F, ? extends R1> fstMapper, Function<? super S, ? extends R2> sndMapper) {
+        return Join.of(fstMapper.apply(getFst()), sndMapper.apply(getSnd()));
+    }
+
+    /**
+     * Swaps the first and second elements, producing a new `Join`.
+     * Compositional operation.
+     *
+     * @return A new `Join` with elements swapped.
+     */
+    default Join<S, F> swap() {
+        return Join.of(getSnd(), getFst());
+    }
+
+    /**
+     * Internal immutable implementation of `Join`.
+     */
+    class ImmutableJoin<F, S> implements Join<F, S> {
+        private final F fst;
+        private final S snd;
+
+        private ImmutableJoin(F fst, S snd) {
+            this.fst = fst;
+            this.snd = snd;
+        }
+
+        @Override
+        public F getFst() {
+            return fst;
+        }
+
+        @Override
+        public S getSnd() {
+            return snd;
+        }
+
+        @Override
+        public boolean equals(Object o) {
+            if (this == o) return true;
+            if (o == null || getClass() != o.getClass()) return false;
+            ImmutableJoin<?, ?> that = (ImmutableJoin<?, ?>) o;
+            return Objects.equals(fst, that.fst) && Objects.equals(snd, that.snd);
+        }
+
+        @Override
+        public int hashCode() {
+            return Objects.hash(fst, snd);
+        }
+
+        @Override
+        public String toString() {
+            return "(" + fst + ", " + snd + ")";
+        }
+    }
+}
