+package com.yourdomain.bikeshed.dsel;
+
+import com.yourdomain.bikeshed.core.Join;
+import com.yourdomain.bikeshed.core.Series;
+import com.yourdomain.bikeshed.core.RowVec;
+import com.yourdomain.bikeshed.core.Twin;
+import com.yourdomain.bikeshed.types.ColumnMeta;
+import com.yourdomain.bikeshed.types.IOMemento;
+
+import java.util.List;
+import java.util.Objects;
+import java.util.function.BiFunction;
+import java.util.function.Function;
+import java.util.function.IntFunction;
+import java.util.function.Predicate;
+import java.util.function.Supplier;
+
+/**
+ * The omnibus enum for common DSEL operations, providing "extension function" style utilities
+ * and glyph-based shorthands.
+ * This centralizes operations, provides a natural namespace, and promotes discoverability.
+ */
+public enum D {
+    // No specific instances needed, just static-like methods.
+    // A single placeholder instance is sufficient for enum definition.
+    INSTANCE;
+
+    // --- Join Operations (Glyph: jn) ---
+
+    /**
+     * Glyph for "Join" factory. Creates an immutable 2-tuple.
+     * Provides concise, infix-style operation akin to Kotlin's `A to B`.
+     * (Kotlin-inspired operator: `infix fun <A, B> A.j(b: B): Join<A, B>`)
+     */
+    public static <F, S> Join<F, S> jn(F f, S s) {
+        return Join.of(f, s);
+    }
+
+    /**
+     * Glyph for "map first" on a Join. Transforms the first element.
+     * (Kotlin-inspired operator: `join.mapFst(mapper)`)
+     */
+    public static <F, S, R> Join<R, S> αFst(Join<F, S> join, Function<? super F, ? extends R> mapper) {
+        Objects.requireNonNull(join, "join must not be null");
+        Objects.requireNonNull(mapper, "mapper must not be null");
+        return join.mapFst(mapper);
+    }
+
+    /**
+     * Glyph for "map second" on a Join. Transforms the second element.
+     * (Kotlin-inspired operator: `join.mapSnd(mapper)`)
+     */
+    public static <F, S, R> Join<F, R> αSnd(Join<F, S> join, Function<? super S, ? extends R> mapper) {
+        Objects.requireNonNull(join, "join must not be null");
+        Objects.requireNonNull(mapper, "mapper must not be null");
+        return join.mapSnd(mapper);
+    }
+
+    /**
+     * Glyph for "map both" on a Join. Transforms both elements.
+     * (Kotlin-inspired operator: `join.mapBoth(fstMapper, sndMapper)`)
+     */
+    public static <F, S, R1, R2> Join<R1, R2> αBoth(Join<F, S> join, Function<? super F, ? extends R1> fstMapper, Function<? super S, ? extends R2> sndMapper) {
+        Objects.requireNonNull(join, "join must not be null");
+        Objects.requireNonNull(fstMapper, "fstMapper must not be null");
+        Objects.requireNonNull(sndMapper, "sndMapper must not be null");
+        return join.mapBoth(fstMapper, sndMapper);
+    }
+
+    /**
+     * Glyph for "swap" on a Join. Swaps the elements.
+     * (Kotlin-inspired operator: `join.swap()`)
+     */
+    public static <F, S> Join<S, F> swap(Join<F, S> join) {
+        Objects.requireNonNull(join, "join must not be null");
+        return join.swap();
+    }
+
+    /**
+     * Glyph for generic map on Join using a BiFunction.
+     * (Kotlin-inspired operator: `join.map(mapper)`)
+     */
+    public static <F, S, R> R α(Join<F, S> join, BiFunction<? super F, ? super S, ? extends R> mapper) {
+        Objects.requireNonNull(join, "join must not be null");
+        Objects.requireNonNull(mapper, "mapper must not be null");
+        return join.map(mapper);
+    }
+
+    // --- Series Operations (Glyph: sr) ---
+
+    /**
+     * Glyph for "Series" factory. Creates a cursor-based collection.
+     * (Kotlin-inspired operator: `size j { provider }` or `List.toSeries()`)
+     */
+    public static <T> Series<T> sr(int size, IntFunction<T> provider) {
+        return Series.of(size, provider);
+    }
+
+    /**
+     * Creates a Series from a List, adopting the List's elements.
+     */
+    public static <T> Series<T> sr(List<T> list) {
+        Objects.requireNonNull(list, "list must not be null");
+        return Series.of(list.size(), list::get);
+    }
+
+    /**
+     * Glyph for "map" on a Series. Transforms elements compositionally.
+     * (Kotlin-inspired operator: `series α mapper`)
+     */
+    public static <T, R> Series<R> α(Series<T> series, Function<? super T, ? extends R> mapper) {
+        Objects.requireNonNull(series, "series must not be null");
+        Objects.requireNonNull(mapper, "mapper must not be null");
+        return series.map(mapper);
+    }
+
+    /**
+     * Glyph for "filter" on a Series. Filters elements compositionally.
+     * (Kotlin-inspired operator: `series where predicate`)
+     */
+    public static <T> Series<T> filter(Series<T> series, Predicate<? super T> predicate) {
+        Objects.requireNonNull(series, "series must not be null");
+        Objects.requireNonNull(predicate, "predicate must not be null");
+        return series.filter(predicate);
+    }
+
+    /**
+     * Glyph for "get" on a Series. Accesses element by index.
+     * (Kotlin-inspired operator: `series[index]`)
+     * This method is an example of convention-based overloading for indexing.
+     * In Java, you'd call it as `D.get(mySeries, index)`.
+     */
+    public static <T> T get(Series<T> series, int index) {
+        Objects.requireNonNull(series, "series must not be null");
+        return series.get(index);
+    }
+
+    /**
+     * Glyph for "slice" on a Series. Creates a sub-series.
+     * (Kotlin-inspired operator: `series[startIndex..endIndex]`)
+     */
+    public static <T> Series<T> slice(Series<T> series, int startIndex, int endIndex) {
+        Objects.requireNonNull(series, "series must not be null");
+        return series.slice(startIndex, endIndex);
+    }
+
+    /**
+     * Glyph for "plus" on Series. Concatenates two Series.
+     * (Kotlin-inspired operator: `series1 + series2`)
+     */
+    public static <T> Series<T> plus(Series<T> s1, Series<T> s2) {
+        Objects.requireNonNull(s1, "series1 must not be null");
+        Objects.requireNonNull(s2, "series2 must not be null");
+        return s1.plus(s2);
+    }
+
+    /**
+     * Glyph for "minus" on Series. Filters out elements that satisfy a predicate.
+     * (Kotlin-inspired operator: `series - predicate`)
+     */
+    public static <T> Series<T> minus(Series<T> s1, Predicate<T> predicate) {
+        Objects.requireNonNull(s1, "series must not be null");
+        Objects.requireNonNull(predicate, "predicate must not be null");
+        return s1.minus(predicate);
+    }
+
+    // --- RowVec Operations (Glyph: rv) ---
+
+    /**
+     * Glyph for "RowVec" factory. Creates a row of data with metadata.
+     */
+    @SafeVarargs
+    public static RowVec rv(Join<Object, Supplier<ColumnMeta>>... valuesAndMeta) {
+        return RowVec.of(valuesAndMeta);
+    }
+
+    // --- Twin Operations (Glyph: tw) ---
+
+    /**
+     * Glyph for "Twin" factory. Creates a symmetric pair.
+     */
+    public static <T> Twin<T> tw(T value1, T value2) {
+        return Twin.of(value1, value2);
+    }
+
+    // --- Type Memento Operations (Glyph: typ) ---
+
+    /**
+     * Inner class providing access to IOMemento types (e.g., D.typ.IoInt).
+     */
+    public static class Typ {
+        public final IOMemento IoBoolean = IOMemento.IoBoolean;
+        public final IOMemento IoByte = IOMemento.IoByte;
+        public final IOMemento IoShort = IOMemento.IoShort;
+        public final IOMemento IoInt = IOMemento.IoInt;
+        public final IOMemento IoLong = IOMemento.IoLong;
+        public final IOMemento IoFloat = IOMemento.IoFloat;
+        public final IOMemento IoDouble = IOMemento.IoDouble;
+        public final IOMemento IoChar = IOMemento.IoChar;
+        public final IOMemento IoLocalDate = IOMemento.IoLocalDate;
+        public final IOMemento IoInstant = IOMemento.IoInstant;
+        public final IOMemento IoString = IOMemento.IoString;
+        public final IOMemento IoByteArray = IOMemento.IoByteArray;
+        public final IOMemento IoNothing = IOMemento.IoNothing;
+
+        /**
+         * For variable-length types like String, retrieves their configured length.
+         * @param name The name of the string field.
+         * @return The configured length for the string field, or null if not found.
+         */
+        public Integer getStringLength(String name) {
+            return IOMemento.STRING_LENGTH_CONFIG.get(name);
+        }
+    }
+
+    /**
+     * Provides access to type mementos via `D.typ`.
+     */
+    public static final Typ typ = new Typ();
+
+    // --- ColumnMeta Operations (Glyph: cm) ---
+
+    /**
+     * Glyph for "ColumnMeta" factory.
+     */
+    public static ColumnMeta cm(String name, IOMemento type) {
+        return ColumnMeta.of(name, type);
+    }
+}
