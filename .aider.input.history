+
+        /**
+        cost
+         */
+        override fun cost(): Long = 42
+    },
+    LeakyRectifier /*implements , DifferentiableFunction*/ {
+        /**
+         * identifying string
+         */
+
+
+        /**
+         * This class should only be accessd via Factory.
+         */
+        //        Rectifier() {
