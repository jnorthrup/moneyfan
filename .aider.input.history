+package com.yourdomain.bbcursive;
+
+import java.nio.ByteBuffer;
+import java.util.function.Function;
+
+/**
+ * Represents a parser function that takes a ByteBuffer and produces a result of type T.
+ * It's a functional interface for composable parsing operations.
+ *
+ * @param <T> The type of the parsed result.
+ */
+@FunctionalInterface
+public interface Cursive<T> extends Function<ByteBuffer, T> {
+    // apply(ByteBuffer buffer) method is inherited from Function.
+    // This interface serves as a marker and semantic clarification.
+}
+```
+
+**2.3. `bbcursive/src/main/java/com/yourdomain/bbcursive/BBAtom.java`**
+```java
+package com.yourdomain.bbcursive;
+
+import java.nio.ByteBuffer;
+import java.util.Objects;
+
+/**
+ * Utility enum for atomic ByteBuffer operations.
+ * These are fundamental, non-composable operations on a ByteBuffer's state
+ * or for matching primitive byte/char/string literals.
+ */
+public enum BBAtom {
+    // No specific instances needed, just static utility methods.
+    ;
+
+    /**
+     * Creates a Cursive parser that reads a single byte and returns it.
+     */
+    public static Cursive<Byte> readByte() {
+        return buffer -> {
+            if (!buffer.hasRemaining()) {
+                throw new java.util.NoSuchElementException("Buffer exhausted.");
+            }
+            return buffer.get();
+        };
+    }
+
+    /**
+     * Creates a Cursive parser that checks if the next byte matches a given value.
+     * Returns the byte if it matches, otherwise throws an exception.
+     */
+    public static Cursive<Byte> matchByte(byte expectedByte) {
+        return buffer -> {
+            Objects.requireNonNull(buffer, "ByteBuffer must not be null");
+            byte actualByte = readByte().apply(buffer);
+            if (actualByte != expectedByte) {
+                throw new IllegalArgumentException("Expected byte " + expectedByte + ", but got " + actualByte);
+            }
+            return actualByte;
+        };
+    }
+
+    /**
+     * Creates a Cursive parser that reads a fixed number of bytes and returns a new ByteBuffer slice.
+     * Advances the position of the input buffer by 'length'.
+     */
+    public static Cursive<ByteBuffer> slice(int length) {
+        return buffer -> {
+            Objects.requireNonNull(buffer, "ByteBuffer must not be null");
+            if (buffer.remaining() < length) {
+                throw new java.util.NoSuchElementException("Not enough bytes to slice (" + length + " requested, " + buffer.remaining() + " available).");
+            }
+            int originalLimit = buffer.limit();
+            int originalPosition = buffer.position();
+            buffer.limit(originalPosition + length); // Set limit for the slice
+            ByteBuffer slice = buffer.slice();       // Create slice from current position to new limit
+            buffer.limit(originalLimit);             // Restore original limit
+            buffer.position(originalPosition + length); // Advance original buffer's position
+            return slice;
+        };
+    }
+
+    /**
+     * Resets the buffer's position to its mark, or to 0 if no mark is set.
+     * This is a utility method, not a parser that consumes input.
+     */
+    public static void resetBufferPosition(ByteBuffer buffer) {
+        Objects.requireNonNull(buffer, "ByteBuffer must not be null");
+        try {
+            buffer.reset();
+        } catch (java.nio.InvalidMarkException e) {
+            buffer.position(0); // If mark is not set, reset to start
+        }
+    }
+}
+```
+
+**2.4. `bbcursive/src/main/java/com/yourdomain/bbcursive/BBCombinator.java`**
+```java
+package com.yourdomain.bbcursive;
+
+import java.nio.ByteBuffer;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Optional;
+import java.util.Objects;
+
+/**
+ * Utility enum for higher-order ByteBuffer parsing functions (combinators).
+ * These compose `Cursive` instances to build more complex parsers.
+ */
+public enum BBCombinator {
+    // No specific instances needed, just static utility methods.
+    ;
+
+    /**
+     * Creates a Cursive parser that sequences multiple parsers.
+     * The parsers are applied in order, and their results are collected into a List.
+     * If any parser in the sequence fails, the entire sequence fails, and the buffer
+     * position is reset to its state before the sequence attempt.
+     *
+     * @param parsers An array of Cursive parsers.
+     * @param <T> The common supertype of the results of the parsers.
+     * @return A Cursive parser that returns a List of results.
+     */
+    @SafeVarargs
+    public static <T> Cursive<List<T>> sequence(Cursive<? extends T>... parsers) {
+        return buffer -> {
+            Objects.requireNonNull(buffer, "ByteBuffer must not be null");
+            int originalPosition = buffer.position();
+            List<T> results = new ArrayList<>();
+            try {
+                for (Cursive<? extends T> parser : parsers) {
+                    results.add(parser.apply(buffer));
+                }
+                return results;
+            } catch (Exception e) {
+                buffer.position(originalPosition); // Rewind on failure
+                throw new IllegalStateException("Sequence parsing failed", e);
+            }
+        };
+    }
+
+    /**
+     * Creates a Cursive parser that tries multiple parsers in order until one succeeds.
+     * The buffer position is reset before trying the next parser if the current one fails.
+     *
+     * @param parsers An array of Cursive parsers.
+     * @param <T> The common supertype of the results of the parsers.
+     * @return A Cursive parser that returns an Optional containing the first successful result.
+     *         If no parser succeeds, an empty Optional is returned.
+     */
+    @SafeVarargs
+    public static <T> Cursive<Optional<T>> choice(Cursive<? extends T>... parsers) {
+        return buffer -> {
+            Objects.requireNonNull(buffer, "ByteBuffer must not be null");
+            int originalPosition = buffer.position();
+            for (Cursive<? extends T> parser : parsers) {
+                try {
+                    return Optional.of(parser.apply(buffer));
+                } catch (Exception e) {
+                    buffer.position(originalPosition); // Rewind if parser fails
+                }
+            }
+            return Optional.empty();
+        };
+    }
+
+    /**
+     * Creates a Cursive parser that makes a given parser optional.
+     * Returns an Optional containing the result if the parser succeeds, otherwise an empty Optional.
+     * If the parser fails, the buffer position is reset.
+     */
+    public static <T> Cursive<Optional<T>> optional(Cursive<T> parser) {
+        return buffer -> {
+            Objects.requireNonNull(buffer, "ByteBuffer must not be null");
+            Objects.requireNonNull(parser, "Parser must not be null");
+            int originalPosition = buffer.position();
+            try {
+                return Optional.of(parser.apply(buffer));
+            } catch (Exception e) {
+                buffer.position(originalPosition); // Rewind on failure
+                return Optional.empty();
+            }
+        };
+    }
+
+    /**
+     * Creates a Cursive parser that applies a given parser zero or more times.
+     * It consumes as much input as possible until the parser fails.
+     * The buffer position is reset on the last (failing) attempt.
+     */
+    public static <T> Cursive<List<T>> many(Cursive<T> parser) {
+        return buffer -> {
+            Objects.requireNonNull(buffer, "ByteBuffer must not be null");
+            Objects.requireNonNull(parser, "Parser must not be null");
+            List<T> results = new ArrayList<>();
+            while (true) {
+                int originalPosition = buffer.position();
+                try {
+                    results.add(parser.apply(buffer));
+                } catch (Exception e) {
+                    buffer.position(originalPosition); // Rewind on failure
+                    break; // Stop parsing if parser fails
+                }
+            }
+            return results;
+        };
+    }
+}
+```
+
