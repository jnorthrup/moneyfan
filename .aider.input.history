+**`bikeshed/src/main/java/com/yourdomain/bikeshed/isam/RecordMeta.java`**
+
+```java
+package com.yourdomain.bikeshed.isam;
+
+import com.yourdomain.bikeshed.cursor.ColumnMeta;
+import com.yourdomain.bikeshed.cursor.TypeMemento;
+import com.yourdomain.bikeshed.core.Join;
+import com.yourdomain.bikeshed.isam.meta.IOMemento;
+
+import java.util.Objects;
+import java.util.function.Function;
+
+/**
+ * Defines the metadata for a column within an ISAM record. This includes its name,
+ * data type ({@link IOMemento}), byte offsets within the record, and the
+ * encoder/decoder functions.
+ *
+ * It extends {@link ColumnMeta} to leverage common metadata patterns and
+ * {@link Join} internally for its name and type.
+ */
+public class RecordMeta implements ColumnMeta {
+    private final String name;
+    private final IOMemento type;
+    private final int begin;
+    private final int end;
+    private final Function<byte[], Object> decoder;
+    private final Function<Object, byte[]> encoder;
+    private RecordMeta child; // For nested structures, e.g., complex types
+
+    /**
+     * Constructs a new {@code RecordMeta} instance.
+     *
+     * @param name    The name of the column.
+     * @param type    The {@link IOMemento} representing the data type and serialization strategy.
+     * @param begin   The starting byte offset of this column within the record.
+     * @param end     The ending byte offset (exclusive) of this column within the record.
+     * @param decoder A function to convert raw bytes from the record into the appropriate Java object.
+     * @param encoder A function to convert a Java object into raw bytes for storage in the record.
+     * @param child   An optional nested {@code RecordMeta} for complex types or composite fields.
+     */
+    public RecordMeta(String name, IOMemento type, int begin, int end,
+                      Function<byte[], Object> decoder, Function<Object, byte[]> encoder,
+                      RecordMeta child) {
+        this.name = Objects.requireNonNull(name, "Name cannot be null");
+        this.type = Objects.requireNonNull(type, "IOMemento type cannot be null");
+        this.begin = begin;
+        this.end = end;
+        this.decoder = Objects.requireNonNull(decoder, "Decoder cannot be null");
+        this.encoder = Objects.requireNonNull(encoder, "Encoder cannot be null");
+        this.child = child; // Child can be null
+    }
+
+    /**
+     * Convenience constructor without a child record meta.
+     */
+    public RecordMeta(String name, IOMemento type, int begin, int end,
+                      Function<byte[], Object> decoder, Function<Object, byte[]> encoder) {
+        this(name, type, begin, end, decoder, encoder, null);
+    }
+
+    /**
+     * Minimal constructor, typically used when `begin` and `end` will be
+     * calculated later (e.g., during `IsamMetaFileReader.write`).
+     * The `decoder` and `encoder` will be created using `type.createDecoder/Encoder`
+     * with an assumed length if `type.getNetworkSize()` is not null.
+     */
+    public RecordMeta(String name, IOMemento type) {
+        this.name = name;
+        this.type = type;
+        this.begin = -1; // Indicate not yet assigned
+        this.end = -1;   // Indicate not yet assigned
+        // Attempt to create default encoder/decoder if network size is known
+        int assumedLength = type.getNetworkSize() != null ? type.getNetworkSize() : 0;
+        this.decoder = type.createDecoder(assumedLength);
+        this.encoder = type.createEncoder(assumedLength);
+        this.child = null;
+    }
+
+
+    @Override
+    public String getName() {
+        return name;
+    }
+
+    @Override
+    public TypeMemento getType() {
+        return type;
+    }
+
+    public IOMemento getIOMementoType() {
+        return type;
+    }
+
+    public int getBegin() {
+        return begin;
+    }
+
+    public int getEnd() {
+        return end;
+    }
+
+    public Function<byte[], Object> getDecoder() {
+        return decoder;
+    }
+
+    public Function<Object, byte[]> getEncoder() {
+        return encoder;
+    }
+
+    public RecordMeta getChild() {
+        return child;
+    }
+
+    public void setChild(RecordMeta child) {
+        this.child = child;
+    }
+
+    @Override
+    public String toString() {
+        return "RecordMeta{" +
+                "name='" + name + '\'' +
+                ", type=" + type +
+                ", begin=" + begin +
+                ", end=" + end +
+                ", child=" + (child != null ? child.getName() : "null") +
+                '}';
+    }
+
+    @Override
+    public boolean equals(Object o) {
+        if (this == o) return true;
+        if (o == null || getClass() != o.getClass()) return false;
+        RecordMeta that = (RecordMeta) o;
+        return begin == that.begin &&
+                end == that.end &&
+                Objects.equals(name, that.name) &&
+                type == that.type &&
+                Objects.equals(child, that.child);
+    }
+
+    @Override
+    public int hashCode() {
+        return Objects.hash(name, type, begin, end, child);
+    }
+}
+```
