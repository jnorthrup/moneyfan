+```java
+package com.yourdomain.bikeshed.cursor;
+
+import com.yourdomain.bikeshed.core.Join;
+import com.yourdomain.bikeshed.core.Series;
+import com.yourdomain.bikeshed.core.Series2;
+
+import java.util.function.IntFunction;
+import java.util.function.Supplier;
+
+/**
+ * Represents a "row vector" within the DSEL, where each element of the row
+ * is a pair of its value and a supplier for its {@link ColumnMeta}.
+ * This allows for lazy retrieval of metadata, which can be useful for
+ * performance when metadata is not always needed.
+ *
+ * Conceptually, it's a {@code Series<Join<Any?, () -> ColumnMeta>>}.
+ */
+public interface RowVec extends Series2<Object, Supplier<ColumnMeta>> {
+
+    /**
+     * Factory method to create a `RowVec` instance.
+     *
+     * @param size     The number of elements in the row.
+     * @param provider A function that provides a {@code Join<Object, Supplier<ColumnMeta>>} for a given index.
+     * @return A new `RowVec` instance.
+     */
+    static RowVec of(int size, IntFunction<Join<Object, Supplier<ColumnMeta>>> provider) {
+        return new RowVecImpl(size, provider);
+    }
+
+    /**
+     * Internal implementation of `RowVec`.
+     */
+    class RowVecImpl extends Series2.Series2Impl<Object, Supplier<ColumnMeta>> implements RowVec {
+        private RowVecImpl(int size, IntFunction<Join<Object, Supplier<ColumnMeta>>> provider) {
+            super(size, provider);
+        }
+    }
+}
+```
