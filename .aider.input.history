+**`bbcursive/src/main/java/com/yourdomain/bbcursive/Cursive.java`**
+(Low-level ByteBuffer parsing combinator interface)
+
+```java
+package com.yourdomain.bbcursive;
+
+import java.nio.ByteBuffer;
+import java.util.function.Function;
+
+/**
+ * Represents a ByteBuffer parsing combinator.
+ * It's a function that takes a ByteBuffer and returns a transformed ByteBuffer,
+ * or a result derived from the ByteBuffer's content.
+ *
+ * @param <T> The type of the parsed result.
+ */
+public interface Cursive<T> extends Function<ByteBuffer, T> {
+
+    /**
+     * Applies this parser to the given ByteBuffer.
+     * The position and limit of the buffer might be altered by the parsing operation.
+     *
+     * @param buffer The ByteBuffer to parse.
+     * @return The parsed result.
+     */
+    @Override
+    T apply(ByteBuffer buffer);
+
+    /**
+     * A utility method to apply the parser and advance the buffer's position by a fixed amount.
+     * This is useful for fixed-width fields.
+     *
+     * @param parser A parser function.
+     * @param <R> The type of the parsed result.
+     * @return A Cursive instance that applies the parser and then advances the buffer.
+     */
+    static <R> Cursive<R> fixedWidth(int width, Cursive<R> parser) {
+        return buffer -> {
+            int originalLimit = buffer.limit();
+            int originalPosition = buffer.position();
+            buffer.limit(originalPosition + width);
+            R result = parser.apply(buffer);
+            buffer.limit(originalLimit); // Restore original limit
+            buffer.position(originalPosition + width); // Advance position by width
+            return result;
+        };
+    }
+
+    /**
+     * Factory method for Cursive that returns a new ByteBuffer containing a slice.
+     *
+     * @param length The length of the slice.
+     * @return A Cursive that returns a sliced ByteBuffer.
+     */
+    static Cursive<ByteBuffer> slice(int length) {
+        return buffer -> {
+            int currentPosition = buffer.position();
+            int currentLimit = buffer.limit();
+
+            if (currentPosition + length > currentLimit) {
+                throw new IndexOutOfBoundsException("Not enough bytes for slice of length " + length +
+                        " at position " + currentPosition + " (limit: " + currentLimit + ")");
+            }
+
+            // Create a duplicate buffer to preserve original buffer's state for subsequent operations
+            ByteBuffer duplicate = buffer.duplicate();
+            duplicate.position(currentPosition);
+            duplicate.limit(currentPosition + length);
+
+            // Advance the original buffer's position
+            buffer.position(currentPosition + length);
+
+            return duplicate.slice(); // Return a slice of the duplicate (independent content)
+        };
+    }
+
+    /**
+     * A combinator that sequences two parsers.
+     *
+     * @param first The first parser.
+     * @param second The second parser, which takes the result of the first.
+     * @param <A> The result type of the first parser.
+     * @param <B> The result type of the second parser.
+     * @return A Cursive that applies first then second.
+     */
+    static <A, B> Cursive<B> sequence(Cursive<A> first, Function<A, Cursive<B>> second) {
+        return buffer -> {
+            A resultA = first.apply(buffer);
+            return second.apply(resultA).apply(buffer);
+        };
+    }
+}
+```
+
+**`bbcursive/src/main/java/com/yourdomain/bbcursive/BBAtom.java`**
+(Primitive ByteBuffer operations)
+
+```java
+package com.yourdomain.bbcursive;
+
+import java.nio.ByteBuffer;
+import java.nio.charset.StandardCharsets;
+import java.util.function.Function;
+
+/**
+ * Provides atomic, primitive operations for ByteBuffer manipulation,
+ * analogous to basic parsing elements.
+ * Emphasizes direct buffer views and basic type reading/writing.
+ */
+public enum BBAtom implements Cursive<Void> {
+    ; // No enum instances, static methods only
+
+    /**
+     * Reads a single byte from the buffer at the current position and advances the position.
+     */
+    public static Cursive<Byte> readByte() {
+        return ByteBuffer::get;
+    }
+
+    /**
+     * Reads an int from the buffer at the current position and advances the position.
+     */
+    public static Cursive<Integer> readInt() {
+        return ByteBuffer::getInt;
+    }
+
+    /**
+     * Reads a long from the buffer at the current position and advances the position.
+     */
+    public static Cursive<Long> readLong() {
+        return ByteBuffer::getLong;
+    }
+
+    /**
+     * Reads a fixed-length string from the buffer.
+     *
+     * @param length The length of the string in bytes.
+     */
+    public static Cursive<String> readString(int length) {
+        return buffer -> {
+            byte[] bytes = new byte[length];
+            buffer.get(bytes);
+            return new String(bytes, StandardCharsets.UTF_8);
+        };
+    }
+
+    /**
+     * Advances the buffer's position by a given offset.
+     *
+     * @param offset The number of bytes to skip.
+     */
+    public static Cursive<Void> skip(int offset) {
+        return buffer -> {
+            buffer.position(buffer.position() + offset);
+            return null;
+        };
+    }
+
+    /**
+     * Sets the buffer's position to a new value.
+     *
+     * @param newPosition The new position.
+     */
+    public static Cursive<Void> position(int newPosition) {
+        return buffer -> {
+            buffer.position(newPosition);
+            return null;
+        };
+    }
+
+    /**
+     * Sets the buffer's limit to a new value.
+     *
+     * @param newLimit The new limit.
+     */
+    public static Cursive<Void> limit(int newLimit) {
+        return buffer -> {
+            buffer.limit(newLimit);
+            return null;
+        };
+    }
+
+    /**
+     * Creates a new ByteBuffer that shares the content of the current buffer,
+     * starting from the current position to the current limit.
+     */
+    public static Cursive<ByteBuffer> duplicate() {
+        return ByteBuffer::duplicate;
+    }
+
+    /**
+     * Creates a new ByteBuffer that shares the content of the current buffer's remaining section,
+     * with its own position and limit.
+     */
+    public static Cursive<ByteBuffer> slice() {
+        return ByteBuffer::slice;
+    }
+
+    @Override
+    public Void apply(ByteBuffer byteBuffer) {
+        throw new UnsupportedOperationException("BBAtom enum entries are not meant to be applied directly. Use static methods.");
+    }
+}
+```
