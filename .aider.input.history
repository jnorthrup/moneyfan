+**3.2. `bikeshed/src/main/java/com/yourdomain/bikeshed/core/Join.java`**
+```java
+package com.yourdomain.bikeshed.core;
+
+import java.util.Objects;
+import java.util.function.BiFunction;
+import java.util.function.Function;
+
+/**
+ * The foundational immutable 2-tuple for the DSEL.
+ * Represents a pair of elements (first and second).
+ * All operations are compositional, producing new instances.
+ *
+ * @param <F> Type of the first element.
+ * @param <S> Type of the second element.
+ */
+public record Join<F, S>(F first, S second) {
+
+    /**
+     * Factory method for creating a Join instance.
+     * Shorthand for `new Join<>(f, s)`.
+     *
+     * @param f The first element.
+     * @param s The second element.
+     * @param <F> Type of the first element.
+     * @param <S> Type of the second element.
+     * @return A new immutable Join instance.
+     */
+    public static <F, S> Join<F, S> of(F f, S s) {
+        return new Join<>(f, s);
+    }
+
+    /**
+     * Applies a mapping function to the first element, producing a new Join.
+     *
+     * @param mapper Function to apply to the first element.
+     * @param <R> New type of the first element.
+     * @return A new Join instance with the transformed first element.
+     */
+    public <R> Join<R, S> mapFst(Function<? super F, ? extends R> mapper) {
+        Objects.requireNonNull(mapper, "mapper must not be null");
+        return new Join<>(mapper.apply(first), second);
+    }
+
+    /**
+     * Applies a mapping function to the second element, producing a new Join.
+     *
+     * @param mapper Function to apply to the second element.
+     * @param <R> New type of the second element.
+     * @return A new Join instance with the transformed second element.
+     */
+    public <R> Join<F, R> mapSnd(Function<? super S, ? extends R> mapper) {
+        Objects.requireNonNull(mapper, "mapper must not be null");
+        return new Join<>(first, mapper.apply(second));
+    }
+
+    /**
+     * Applies mapping functions to both elements, producing a new Join.
+     *
+     * @param fstMapper Function to apply to the first element.
+     * @param sndMapper Function to apply to the second element.
+     * @param <R1> New type of the first element.
+     * @param <R2> New type of the second element.
+     * @return A new Join instance with both elements transformed.
+     */
+    public <R1, R2> Join<R1, R2> mapBoth(Function<? super F, ? extends R1> fstMapper, Function<? super S, ? extends R2> sndMapper) {
+        Objects.requireNonNull(fstMapper, "fstMapper must not be null");
+        Objects.requireNonNull(sndMapper, "sndMapper must not be null");
+        return new Join<>(fstMapper.apply(first), sndMapper.apply(second));
+    }
+
+    /**
+     * Swaps the first and second elements, producing a new Join.
+     *
+     * @return A new Join instance with elements swapped.
+     */
+    public Join<S, F> swap() {
+        return new Join<>(second, first);
+    }
+
+    /**
+     * Concatenates two Join instances into a new Join where elements are themselves Join instances.
+     * This follows the `plus` operator convention for composition.
+     *
+     * @param other The other Join instance to combine with.
+     * @param <F2> Type of the first element of the other Join.
+     * @param <S2> Type of the second element of the other Join.
+     * @return A new Join instance containing both original Join instances.
+     */
+    public <F2, S2> Join<Join<F, S>, Join<F2, S2>> plus(Join<F2, S2> other) {
+        Objects.requireNonNull(other, "other Join must not be null");
+        return Join.of(this, other);
+    }
+
+    /**
+     * Provides indexed access to the elements of the Join.
+     *
+     * @param index The index (0 for first, 1 for second).
+     * @return The element at the specified index.
+     * @throws IndexOutOfBoundsException if the index is not 0 or 1.
+     */
+    public Object get(int index) {
+        if (index == 0) return first;
+        if (index == 1) return second;
+        throw new IndexOutOfBoundsException("Index " + index + " out of bounds for Join (0-1)");
+    }
+
+    /**
+     * Applies a BiFunction to both elements of the Join, producing a single result.
+     * This is a generic "map" operation that folds the Join into a new type.
+     *
+     * @param mapper The BiFunction to apply to the first and second elements.
+     * @param <R> The type of the result.
+     * @return The result of applying the mapper function.
+     */
+    public <R> R map(BiFunction<? super F, ? super S, ? extends R> mapper) {
+        Objects.requireNonNull(mapper, "mapper must not be null");
+        return mapper.apply(first, second);
+    }
+}
+```
+
+**3.3. `bikeshed/src/main/java/com/yourdomain/bikeshed/core/Series.java`**
+```java
+package com.yourdomain.bikeshed.core;
+
+import org.jetbrains.annotations.NotNull;
+
+import java.util.ArrayList;
+import java.util.Iterator;
+import java.util.List;
+import java.util.Objects;
+import java.util.function.Function;
+import java.util.function.IntFunction;
+import java.util.function.Predicate;
+import java.util.stream.IntStream;
+import java.util.stream.StreamSupport;
+
+/**
+ * Represents a cursor-based, immutable series of data.
+ * Internally, it's modeled as a `Join<Integer, Function<Integer, T>>`,
+ * where the first element is the size and the second is a provider function
+ * that generates an element at a given index.
+ * This structure enables lazy evaluation and efficient slicing/access patterns.
+ *
+ * @param <T> The type of elements in the series.
+ */
+public record Series<T>(Integer size, IntFunction<T> provider) implements Iterable<T> {
+
+    /**
+     * Factory method for creating a Series instance.
+     *
+     * @param size The number of elements in the series.
+     * @param provider A function that, given an integer index, returns the element at that index.
+     * @param <T> The type of elements.
+     * @return A new immutable Series instance.
+     */
+    public static <T> Series<T> of(int size, IntFunction<T> provider) {
+        if (size < 0) throw new IllegalArgumentException("Size cannot be negative.");
+        Objects.requireNonNull(provider, "Provider function must not be null.");
+        return new Series<>(size, provider);
+    }
+
+    /**
+     * Retrieves the element at the specified index.
+     *
+     * @param index The index of the element to retrieve.
+     * @return The element at the given index.
+     * @throws IndexOutOfBoundsException if the index is out of bounds (index < 0 or index >= size).
+     */
+    public T get(int index) {
+        if (index < 0 || index >= size) {
+            throw new IndexOutOfBoundsException("Index " + index + " out of bounds for Series of size " + size);
+        }
+        return provider.apply(index);
+    }
+
+    /**
+     * Returns a new Series representing a slice of the original Series.
+     * The new Series is also lazily evaluated.
+     *
+     * @param startIndex The inclusive start index of the slice.
+     * @param endIndex The exclusive end index of the slice.
+     * @return A new Series representing the specified slice.
+     * @throws IndexOutOfBoundsException if startIndex or endIndex are out of bounds or startIndex > endIndex.
+     */
+    public Series<T> slice(int startIndex, int endIndex) {
+        if (startIndex < 0 || startIndex > size || endIndex < 0 || endIndex > size || startIndex > endIndex) {
+            throw new IndexOutOfBoundsException("Slice indices [" + startIndex + ", " + endIndex + ") are out of bounds for Series of size " + size);
+        }
+        int newSize = endIndex - startIndex;
+        return new Series<>(newSize, i -> provider.apply(startIndex + i));
+    }
+
+    /**
+     * Applies a mapping function to each element, producing a new Series of transformed elements.
+     * This operation is compositional and lazy.
+     *
+     * @param mapper The function to apply to each element.
+     * @param <R> The type of elements in the new Series.
+     * @return A new Series with transformed elements.
+     */
+    public <R> Series<R> map(Function<? super T, ? extends R> mapper) {
+        Objects.requireNonNull(mapper, "Mapper function must not be null.");
+        return new Series<>(size, i -> mapper.apply(provider.apply(i)));
+    }
+
+    /**
+     * Filters the elements of the Series based on a predicate, producing a new Series.
+     * This operation is compositional. For simplicity in this DSEL stub, the filtered
+     * elements are eagerly collected into a list, and a new Series is created from it.
+     * A fully lazy implementation would involve more complex index mapping.
+     *
+     * @param predicate The predicate to apply to each element.
+     * @return A new Series containing only the elements that satisfy the predicate.
+     */
+    public Series<T> filter(Predicate<? super T> predicate) {
+        Objects.requireNonNull(predicate, "Predicate must not be null.");
+        List<T> materializedFilteredList = new ArrayList<>();
+        for (int i = 0; i < size; i++) {
+            T element = provider.apply(i);
+            if (predicate.test(element)) {
+                materializedFilteredList.add(element);
+            }
+        }
+        return new Series<>(materializedFilteredList.size(), materializedFilteredList::get);
+    }
+
+    /**
+     * Provides an iterator over the elements of the series.
+     *
+     * @return An iterator for the series.
+     */
+    @Override
+    public @NotNull Iterator<T> iterator() {
+        return new Iterator<>() {
+            private int currentIndex = 0;
+
+            @Override
+            public boolean hasNext() {
+                return currentIndex < size;
+            }
+
+            @Override
+            public T next() {
+                if (!hasNext()) {
+                    throw new java.util.NoSuchElementException();
+                }
+                return get(currentIndex++);
+            }
+        };
+    }
+
+    /**
+     * Convention-based operator overloading for '+' (concatenation).
+     * Creates a new Series by appending the elements of 'other' to this Series.
+     *
+     * @param other The Series to append.
+     * @return A new Series representing the concatenation.
+     */
+    public Series<T> plus(Series<T> other) {
+        Objects.requireNonNull(other, "other Series must not be null");
+        int newSize = this.size + other.size;
+        return new Series<>(newSize, i -> {
+            return (i < this.size) ? this.get(i) : other.get(i - this.size);
+        });
+    }
+
+    /**
+     * Convention-based operator overloading for '-' (difference or subtraction).
+     * Returns a new Series containing elements from this Series that do NOT satisfy the given predicate.
+     *
+     * @param condition The predicate used to determine which elements to remove.
+     * @return A new Series with elements filtered out.
+     */
+    public Series<T> minus(Predicate<T> condition) {
+        return filter(condition.negate());
+    }
+
+    /**
+     * Provides a Java Stream API view for compatibility.
+     *
+     * @return A Stream of elements from this Series.
+     */
+    public java.util.stream.Stream<T> stream() {
+        return StreamSupport.stream(spliterator(), false);
+    }
+}
+```
+
+**3.4. `bikeshed/src/main/java/com/yourdomain/bikeshed/core/RowVec.java`**
+```java
+package com.yourdomain.bikeshed.core;
+
+import com.yourdomain.bikeshed.types.ColumnMeta;
+
+import java.util.Objects;
+import java.util.function.Function;
+import java.util.function.IntFunction;
+import java.util.function.Supplier;
+
+/**
+ * Represents a row of data with associated metadata.
+ * Internally, it's a `Series<Join<Object, () -> ColumnMeta>>`.
+ * Each element in the Series is a Join of a value and a supplier function for its ColumnMeta.
+ * This allows for lazy loading of metadata if needed, or simply provides a consistent structure.
+ */
+public class RowVec extends Series<Join<Object, Supplier<ColumnMeta>>> {
+
+    /**
+     * Constructs a RowVec.
+     * @param size The number of columns in the row.
+     * @param provider A function to provide a Join<Object, Supplier<ColumnMeta>> for each column index.
+     */
+    public RowVec(int size, IntFunction<Join<Object, Supplier<ColumnMeta>>> provider) {
+        super(size, provider);
+    }
+
+    /**
+     * Factory method to create a RowVec from an array of (value, metadataSupplier) pairs.
+     * @param valuesAndMeta An array of Join instances, each containing a value and a supplier for its ColumnMeta.
+     * @return A new RowVec instance.
+     */
+    @SafeVarargs
+    public static RowVec of(Join<Object, Supplier<ColumnMeta>>... valuesAndMeta) {
+        Objects.requireNonNull(valuesAndMeta, "valuesAndMeta array must not be null");
+        return new RowVec(valuesAndMeta.length, i -> valuesAndMeta[i]);
+    }
+
+    /**
+     * Convenience method to get the value at a specific column index.
+     * @param index The column index.
+     * @return The value at that column.
+     */
+    public Object getValue(int index) {
+        return get(index).first();
+    }
+
+    /**
+     * Convenience method to get the ColumnMeta for a specific column index.
+     * The supplier is invoked to get the actual ColumnMeta object.
+     * @param index The column index.
+     * @return The ColumnMeta for that column.
+     */
+    public ColumnMeta getMeta(int index) {
+        return get(index).second().get(); // Call the supplier to get the ColumnMeta
+    }
+
+    /**
+     * Maps the values of the RowVec, returning a new Series of the transformed values.
+     * The metadata suppliers are preserved (by returning the original Join with only the first element mapped),
+     * or can be mapped if explicitly needed by a more complex mapper.
+     *
+     * @param mapper Function to apply to each value.
+     * @param <R> New type of the values.
+     * @return A new Series where each element is the transformed value.
+     */
+    public <R> Series<R> mapValues(Function<Object, R> mapper) {
+        Objects.requireNonNull(mapper, "mapper must not be null");
+        return this.map(join -> mapper.apply(join.first()));
+    }
+}
+```
