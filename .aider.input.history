+```java
+package com.yourdomain.bikeshed.isam.meta;
+
+/**
+ * Interface defining platform-specific byte array to primitive conversions,
+ * ensuring correct endianness for ISAM data files.
+ */
+public interface PlatformCodec {
+
+    // Read operations
+    long readLong(byte[] bytes);
+    int readInt(byte[] bytes);
+    short readShort(byte[] bytes);
+    double readDouble(byte[] bytes);
+    float readFloat(byte[] bytes);
+
+    // Write operations
+    byte[] writeLong(long value);
+    byte[] writeInt(int value);
+    byte[] writeShort(short value);
+    byte[] writeDouble(double value);
+    byte[] writeFloat(float value);
+
+    // Unsigned integer operations (common in Kotlin, mapping to signed in Java)
+    default int readUShort(byte[] bytes) { return readShort(bytes) & 0xFFFF; }
+    default int readUInt(byte[] bytes) { return readInt(bytes); } // Java unsigned int is tricky, often treated as signed
+    default long readULong(byte[] bytes) { return readLong(bytes); } // Java unsigned long as long
+
+    default byte[] writeUShort(int value) { return writeShort((short) value); }
+    default byte[] writeUInt(int value) { return writeInt(value); }
+    default byte[] writeULong(long value) { return writeLong(value); }
+
+
+    /**
+     * Provides a singleton instance of the appropriate `PlatformCodec`
+     * based on the system's endianness (assumes network endian is big-endian).
+     */
+    enum currentPlatformCodec implements PlatformCodec {
+        INSTANCE; // Singleton instance
+
+        private final boolean isNetworkEndian;
+
+        currentPlatformCodec() {
+            // Determine system endianness (this is a simplified check)
+            // A more robust check might involve writing 0x01020304 to a ByteBuffer and reading as byte.
+            int i = 0x01020304;
+            byte[] bytes = new byte[4];
+            java.nio.ByteBuffer.wrap(bytes).putInt(i);
+            this.isNetworkEndian = (bytes[0] == 0x01); // If first byte is 0x01, it's big-endian (network order)
+        }
+
+        public static boolean isNetworkEndian() {
+            return INSTANCE.isNetworkEndian;
+        }
+
+        public static boolean isLittleEndian() {
+            return !INSTANCE.isNetworkEndian;
+        }
+
+        @Override
+        public long readLong(byte[] bytes) {
+            java.nio.ByteBuffer buffer = java.nio.ByteBuffer.wrap(bytes);
+            if (isNetworkEndian) {
+                buffer.order(java.nio.ByteOrder.BIG_ENDIAN);
+            } else {
+                buffer.order(java.nio.ByteOrder.LITTLE_ENDIAN);
+            }
+            return buffer.getLong();
+        }
+
+        @Override
+        public int readInt(byte[] bytes) {
+            java.nio.ByteBuffer buffer = java.nio.ByteBuffer.wrap(bytes);
+            if (isNetworkEndian) {
+                buffer.order(java.nio.ByteOrder.BIG_ENDIAN);
+            } else {
+                buffer.order(java.nio.ByteOrder.LITTLE_ENDIAN);
+            }
+            return buffer.getInt();
+        }
+
+        @Override
+        public short readShort(byte[] bytes) {
+            java.nio.ByteBuffer buffer = java.nio.ByteBuffer.wrap(bytes);
+            if (isNetworkEndian) {
+                buffer.order(java.nio.ByteOrder.BIG_ENDIAN);
+            } else {
+                buffer.order(java.nio.ByteOrder.LITTLE_ENDIAN);
+            }
+            return buffer.getShort();
+        }
+
+        @Override
+        public double readDouble(byte[] bytes) {
+            java.nio.ByteBuffer buffer = java.nio.ByteBuffer.wrap(bytes);
+            if (isNetworkEndian) {
+                buffer.order(java.nio.ByteOrder.BIG_ENDIAN);
+            } else {
+                buffer.order(java.nio.ByteOrder.LITTLE_ENDIAN);
+            }
+            return buffer.getDouble();
+        }
+
+        @Override
+        public float readFloat(byte[] bytes) {
+            java.nio.ByteBuffer buffer = java.nio.ByteBuffer.wrap(bytes);
+            if (isNetworkEndian) {
+                buffer.order(java.nio.ByteOrder.BIG_ENDIAN);
+            } else {
+                buffer.order(java.nio.ByteOrder.LITTLE_ENDIAN);
+            }
+            return buffer.getFloat();
+        }
+
+        @Override
+        public byte[] writeLong(long value) {
+            byte[] bytes = new byte[8];
+            java.nio.ByteBuffer buffer = java.nio.ByteBuffer.wrap(bytes);
+            if (isNetworkEndian) {
+                buffer.order(java.nio.ByteOrder.BIG_ENDIAN);
+            } else {
+                buffer.order(java.nio.ByteOrder.LITTLE_ENDIAN);
+            }
+            buffer.putLong(value);
+            return bytes;
+        }
+
+        @Override
+        public byte[] writeInt(int value) {
+            byte[] bytes = new byte[4];
+            java.nio.ByteBuffer buffer = java.nio.ByteBuffer.wrap(bytes);
+            if (isNetworkEndian) {
+                buffer.order(java.nio.ByteOrder.BIG_ENDIAN);
+            } else {
+                buffer.order(java.nio.ByteOrder.LITTLE_ENDIAN);
+            }
+            buffer.putInt(value);
+            return bytes;
+        }
+
+        @Override
+        public byte[] writeShort(short value) {
+            byte[] bytes = new byte[2];
+            java.nio.ByteBuffer buffer = java.nio.ByteBuffer.wrap(bytes);
+            if (isNetworkEndian) {
+                buffer.order(java.nio.ByteOrder.BIG_ENDIAN);
+            } else {
+                buffer.order(java.nio.ByteOrder.LITTLE_ENDIAN);
+            }
+            buffer.putShort(value);
+            return bytes;
+        }
+
+        @Override
+        public byte[] writeDouble(double value) {
+            byte[] bytes = new byte[8];
+            java.nio.ByteBuffer buffer = java.nio.ByteBuffer.wrap(bytes);
+            if (isNetworkEndian) {
+                buffer.order(java.nio.ByteOrder.BIG_ENDIAN);
+            } else {
+                buffer.order(java.nio.ByteOrder.LITTLE_ENDIAN);
+            }
+            buffer.putDouble(value);
+            return bytes;
+        }
+
+        @Override
+        public byte[] writeFloat(float value) {
+            byte[] bytes = new byte[4];
+            java.nio.ByteBuffer buffer = java.nio.ByteBuffer.wrap(bytes);
+            if (isNetworkEndian) {
+                buffer.order(java.nio.ByteOrder.BIG_ENDIAN);
+            } else {
+                buffer.order(java.nio.ByteOrder.LITTLE_ENDIAN);
+            }
+            buffer.putFloat(value);
+            return bytes;
+        }
+    }
+}
