+                    }
+                    println("Pop:  POP: ${Environment.sim.POPULATION} HIDDEN: ${Environment.sim.HIDDEN} ${runtime.freeMemory() to runtime.totalMemory()} <-  pop size: ${rk}k  jean@ ${rk / Environment.sim.POPULATION / Environment.sim.HIDDEN}Kb")
+                }
