+//    },
+
+    /**
+     * Modified classic sigmoid. Submitted to NEAT group by zenguyuno@yahoo.com from
+     * EvSail ANN package.
+     *
+     * @author Philip Tucker
+     */
+    EvSailSigmoid /*implements , DifferentiableFunction*/ {
+        public val SEP = 0.3f
+        public val DENOMINATOR = 2f * SEP * SEP
+
+        /**
+         * identifying string
+         */
+
+
+        /**
+         * This class should only be accessd via Factory.
+         */
+        //		EvSailSigmoid() {
+        //		// no-op
+        //		}
+        /**
+         * Approximation of classic sigmoid.
+         *
+        apply
+         */
+        override fun invoke(input: Double ): Double {
+            return if (input <= -SEP) {
+                0.0
+            } else if (input <= 0.0) {
+                val tmp = input + SEP
+                tmp * tmp / DENOMINATOR
+            } else if (input < SEP) {
+                val tmp = input - SEP
+                1f - tmp * tmp / DENOMINATOR
+            } else {
+                1.0
+            }
+        }
+
+        override fun applyDiff(x: Double ): Double {
+            return if (x <= -SEP) {
+                0.0
+            } else if (x <= 0) {
+                2f * (SEP + x) / DENOMINATOR
+            } else if (x < SEP) {
+                -(2f * (-SEP + x)) / DENOMINATOR
+            } else {
+                0.0
+            }
+        }
+
+        /**
+        getMaxValue
+         */
+        override fun getMaxValue(): Double = 1.0
+
+        /**
+        getMinValue
+         */
+        override fun getMinValue(): Double = 0.0
+
+        /**
+        cost
+         */
+        override fun cost(): Long = 166
+    },
+
+    /**
+     * @author cLins
+     */
+    ExponentialLinearFunction /*implements , DifferentiableFunction
+             */ {
+        /**
+         * identifying string
+         */
+
+        public val alpha = 1.0
+
+
+        override fun invoke(input: Double ): Double {
+            return if (input < 0.0) {
+                alpha * (exp(input) - 1f)
+            } else {
+                input
+            }
+        }
+
+        override fun applyDiff(x: Double ): Double {
+            return if (x < 0.0) {
+                alpha * exp(x)
+            } else {
+                1.0
+            }
+        }
+
+        override fun getMaxValue(): Double = Double .MAX_VALUE
+
+        override fun getMinValue(): Double = -alpha
+
+        override fun cost(): Long = 42
+    },
+
+    /**
+     * Gaussian activation function.
+     *
+     * @author Oliver Coleman
+     */
+    Gaussian /*implements , DifferentiableFunction*/ {
+        public val SLOPE = 1.0
+
+        /**
+         * identifying string
+         */
+
+
+        /**
+         * This class should only be accessd via Factory.
+         */
+        //        Gaussian() {
+        //            // no-op
+        //        }
+        /**
+         * Return `input` with Gaussian function transformation.
+         *
+        apply
+         */
+        override fun invoke(input: Double ): Double = exp(-(input * input * SLOPE))
+
+        override fun applyDiff(x: Double ): Double = -2f * exp(-SLOPE * x * x) * SLOPE * x
+
+        /**
+        getMaxValue
+         */
+        override fun getMaxValue(): Double = 1.0
+
+        /**
+        getMinValue
+         */
+        override fun getMinValue(): Double = 0.0
+
+        /**
+        cost
+         */
+        override fun cost(): Long = 42
+    },
+
+    /**
+     * Inverse absolute value.
+     *
+     * @author Philip Tucker
+     */
+    InverseAbs /*implements , DifferentiableFunction */ {
+        public val SLOPE = 0.3
+
+        /**
+         * identifying string
+         */
+
+
+        /**
+         * This class should only be accessd via Factory.
+         */
+        //        InverseAbs() {
+        //            // no-op
+        //        }
+        /**
+         * Inverse absolute value.
+         *
+        apply
+         */
+        override fun invoke(input: Double ): Double = (1f / (SLOPE * abs(input) + 1f)).toDouble ()
+
+        override fun applyDiff(x: Double ): Double = // As given by Wolfram Alpha
+            (-(SLOPE * x) / (abs(x) * (1 + SLOPE * abs(x)).pow(2.0))).toDouble ()
+
+        /**
+        getMaxValue
+         */
+        override fun getMaxValue(): Double = 1.0
+
+        /**
+        getMinValue
+         */
+        override fun getMinValue(): Double = 0.0
+
+        /**
+        cost
+         */
+        override fun cost(): Long = 75
+    },
+
+    /**
+     * Linear activation function.
+     *
+     * @author Philip Tucker
+     */
+    Linear /*implements , DifferentiableFunction */ {
+        /**
+         * identifying string
+         */
+
+
+        /**
+         * This class should only be accessd via Factory.
+         */
+
+        /**
+         * Return `input` with no transformation.
+         *
+        apply
+         */
+        override fun invoke(input: Double ): Double = input
+
+
+        override fun applyDiff(input: Double ): Double = 1.0
+
+        /**
+        getMaxValue
+         */
+        override fun getMaxValue(): Double = Double .MAX_VALUE
+
+        /**
+        getMinValue
+         */
+        override fun getMinValue(): Double = (-Double .MAX_VALUE)
+
+        /**
+        cost
+         */
+        override fun cost(): Long = 42
+    },
