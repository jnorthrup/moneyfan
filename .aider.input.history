+         *
+        apply
+         */
+        override fun invoke(input: Double ): Double = min(abs(input), 1.0)
+
+        override fun applyDiff(x: Double ): Double {
+            return if (x < 0.0) {
+                if (x >= -1f) {
+                    -1.0
+                } else {
+                    0.0
+                }
+            } else {
+                // we ignore x == 0 here
+                if (x >= 1) {
+                    1.0
+                } else {
+                    0.0
+                }
+            }
+        }
+
+        /**
+        getMaxValue
+         */
+        override fun getMaxValue(): Double = 1.0
+
+        /**
+        getMinValue
+         */
+        override fun getMinValue(): Double = 0.0
+
+        /**
+        cost
