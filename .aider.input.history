+package pairwise.idiom.neat
+
+import org.junit.jupiter.api.Assertions.*
+import org.junit.jupiter.api.BeforeEach
+import org.junit.jupiter.api.Test
+
+class GnomeMutationIntegrationTest {
+
+    @BeforeEach
+    fun setUp() {
+        Environment.sim = Sim(
+            INPUTS = 2,
+            BIAS = 1,
+            HIDDEN = 3,
+            OUTPUTS = 1,
+            POPULATION = 1,
+            CONN_DENSITY = 0.1,
+            W = 0.0
+        )
+    }
+
+    @Test
+    fun `applying enrichConnections mutation invalidates pruned cache`() {
+        val gnome = Gnome()
+        // Initialize pruned cache by accessing it
+        assertNotNull(gnome.pruned)
+        gnome.pruned = intArrayOf(0) // Simulate it being cached
+
+        val targetJeanIndex = 0
+        assertTrue(
+            targetJeanIndex < Environment.sim.HIDDEN,
+            "Target jean index must be within hidden range for this test logic"
+        )
+        val jean = gnome.jeans[targetJeanIndex]
+
+        JeanMutations.enrichConnections.op(jean, targetJeanIndex, gnome)
+
+        assertNull(gnome.pruned, "Gnome's pruned cache should be invalidated after enrichConnections mutation")
+    }
+
+    @Test
+    fun `applying changeAf mutation changes activation function of a hidden jean`() {
+        val gnome = Gnome()
+        val targetJeanIndex = 0
+        assertTrue(targetJeanIndex < Environment.sim.HIDDEN, "Target jean index must be within hidden range")
+
+        val jean = gnome.jeans[targetJeanIndex]
+        val initialAf = jean.af
+
+        JeanMutations.changeAf.op(jean, targetJeanIndex, gnome)
+        val finalAf = jean.af
+
+        assertTrue(ActivationFunction.cached.contains(finalAf), "New AF should be from the cached list")
+        // It's possible it randomly picks the same AF. This test verifies the mechanism.
+        // To be more deterministic about change, one might need to control ActivationFunction.cached or run multiple trials.
+        if (1 < ActivationFunction.cached.size && initialAf == finalAf) {
+            // This is a soft warning, not a test failure, as it's statistically possible.
+            System.err.println("Warning: changeAf mutation resulted in the same AF. This is possible if initial AF was already random or list of AFs is small.")
+        }
+        assertNotNull(finalAf, "Activation function should not be null after changeAf")
+    }
+
+    @Test
+    fun `applying reduceConnections mutation invalidates pruned cache if an input is removed`() {
+        val gnome = Gnome()
+        val targetJeanIndex = 0
+        assertTrue(targetJeanIndex < Environment.sim.HIDDEN)
+        val jean = gnome.jeans[targetJeanIndex]
+
+        // Ensure the jean has at least one input to remove
+        if (jean.inputs.isEmpty() && 0 < Environment.sim.INPUTS) {
+            jean.addInput(0, gnome) // Add a known input
+        }
+        gnome.pruned = intArrayOf(0) // Simulate pruned cache being populated
+
+        if (jean.inputs.isNotEmpty()) {
+            val initialInputCount = jean.inputs.size
+            JeanMutations.reduceConnections.op(jean, targetJeanIndex, gnome)
+            val finalInputCount = jean.inputs.size
+
+            assertTrue(
+                finalInputCount <= initialInputCount,
+                "Input count should be less than or equal to initial after reduceConnections"
+            )
+            if (finalInputCount < initialInputCount) { // If an input was actually removed
+                assertNull(gnome.pruned, "Gnome's pruned cache should be invalidated if an input was removed")
+            } else {
+                // If input count didn't change, it might be because it had <=1 input and another mutation was called.
+                // The test for prune invalidation is conditional on an input actually being removed by this specific op.
+            }
+        } else {
+            // If no inputs to remove, reduceConnections might call another mutation.
+            // The primary test here is about `reduceConnections` when it *can* remove.
+            JeanMutations.reduceConnections.op(jean, targetJeanIndex, gnome)
+            // Pruned cache might be null due to a fallback mutation.
+        }
+    }
+}
