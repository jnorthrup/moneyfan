+**`bikeshed/src/main/java/com/yourdomain/bikeshed/types/IOMemento.java`**
+(Enum for specific I/O types and their serialization strategies.)
+
+```java
+package com.yourdomain.bikeshed.types;
+
+import com.yourdomain.bbcursive.atom.BBAtom;
+import com.yourdomain.bbcursive.core.Parser;
+import com.yourdomain.bikeshed.core.Series;
+
+import java.nio.ByteBuffer;
+import java.nio.charset.StandardCharsets;
+import java.time.Instant;
+import java.time.LocalDate;
+import java.time.ZoneOffset;
+import java.util.function.Function;
+
+/**
+ * {@code IOMemento} defines the data types supported by the DSEL for I/O operations,
+ * specifying their fixed {@code networkSize} (in bytes) and providing
+ * {@link Parser} for decoding and {@link Function} for encoding.
+ * This enum centralizes type information and I/O strategies, crucial for ISAM integration.
+ * Variable-length types (like {@code IoString}) require explicit length configuration.
+ */
+public enum IOMemento implements TypeMemento {
+    // Fixed-size types with their corresponding network sizes and default parsers/encoders
+    IoBoolean(1, BBAtom.B.map(b -> b != 0), val -> new byte[]{(byte) (((Boolean) val) ? 1 : 0)}),
+    IoByte(1, BBAtom.B, b -> new byte[]{((Byte) b)}),
+    IoShort(2, buffer -> {
+        if (buffer.remaining() >= 2) return Optional.of(buffer.getShort()); return Optional.empty();
+    }, val -> {
+        ByteBuffer temp = ByteBuffer.allocate(2); temp.putShort(((Short) val)); return temp.array();
+    }),
+    IoInt(4, BBAtom.I, val -> {
+        ByteBuffer temp = ByteBuffer.allocate(4); temp.putInt(((Integer) val)); return temp.array();
+    }),
+    IoLong(8, BBAtom.L, val -> {
+        ByteBuffer temp = ByteBuffer.allocate(8); temp.putLong(((Long) val)); return temp.array();
+    }),
+    IoFloat(4, buffer -> {
+        if (buffer.remaining() >= 4) return Optional.of(buffer.getFloat()); return Optional.empty();
+    }, val -> {
+        ByteBuffer temp = ByteBuffer.allocate(4); temp.putFloat(((Float) val)); return temp.array();
+    }),
+    IoDouble(8, buffer -> {
+        if (buffer.remaining() >= 8) return Optional.of(buffer.getDouble()); return Optional.empty();
+    }, val -> {
+        ByteBuffer temp = ByteBuffer.allocate(8); temp.putDouble(((Double) val)); return temp.array();
+    }),
+    IoLocalDate(8, BBAtom.L.map(LocalDate::ofEpochDay), val -> {
+        ByteBuffer temp = ByteBuffer.allocate(8); temp.putLong(((LocalDate) val).toEpochDay()); return temp.array();
+    }),
+    // IoInstant as 12 bytes: 8 bytes for epoch seconds, 4 bytes for nanoseconds of second
+    IoInstant(12, buffer -> {
+        Parser<Join<Long, Integer>> instantParser = BBAtom.L.then(BBAtom.I);
+        return instantParser.parse(buffer).map(result -> Instant.ofEpochSecond(result.first(), result.second()));
+    }, val -> {
+        Instant instant = (Instant) val;
+        ByteBuffer temp = ByteBuffer.allocate(12);
+        temp.putLong(instant.getEpochSecond());
+        temp.putInt(instant.getNano());
+        return temp.array();
+    }),
+
+    // Variable-length types (networkSize is null)
+    IoString(null, null, null) { // Parser/Encoder need length context
+        @Override
+        public <T> Parser<T> createDecoder(int length) {
+            return (Parser<T>) BBAtom.STRING_FIXED_LENGTH.ofLength(length);
+        }
+        @Override
+        public <T> Function<T, byte[]> createEncoder(int length) {
+            return val -> {
+                byte[] bytes = ((String) val).getBytes(StandardCharsets.UTF_8);
+                // Pad or truncate to fixed length
+                ByteBuffer buffer = ByteBuffer.allocate(length);
+                buffer.put(bytes, 0, Math.min(bytes.length, length));
+                return buffer.array();
+            };
+        }
+    },
+    IoByteArray(null, null, null) { // Parser/Encoder need length context
+        @Override
+        public <T> Parser<T> createDecoder(int length) {
+            return (Parser<T>) BBAtom.SLICE.ofLength(length).map(bb -> {
+                byte[] bytes = new byte[bb.remaining()];
+                bb.get(bytes);
+                return bytes;
+            });
+        }
+        @Override
+        public <T> Function<T, byte[]> createEncoder(int length) {
+            return val -> {
+                byte[] bytes = (byte[]) val;
+                ByteBuffer buffer = ByteBuffer.allocate(length);
+                buffer.put(bytes, 0, Math.min(bytes.length, length));
+                return buffer.array();
+            };
+        }
+    };
+
+    private final Integer networkSize;
+    private final Parser<?> defaultDecoder;
+    private final Function<?, byte[]> defaultEncoder;
+
+    <T> IOMemento(Integer networkSize, Parser<T> defaultDecoder, Function<T, byte[]> defaultEncoder) {
+        this.networkSize = networkSize;
+        this.defaultDecoder = defaultDecoder;
+        this.defaultEncoder = defaultEncoder;
+    }
+
+    @Override
+    public Integer networkSize() {
+        return networkSize;
+    }
+
+    /**
+     * Creates a decoder (parser) for this type, given a specific length.
+     * For fixed-size types, length might be ignored or used for validation.
+     * For variable-length types, length is crucial.
+     * @param length The expected length in bytes for the data to be decoded.
+     * @param <T> The target type of the decoded value.
+     * @return A {@link Parser} that decodes a value of type {@code T}.
+     * @throws UnsupportedOperationException if called on a fixed-size type where length is not applicable
+     *                                      or if the defaultDecoder is null for a type that requires it.
+     */
+    @SuppressWarnings("unchecked")
+    public <T> Parser<T> createDecoder(int length) {
+        if (defaultDecoder != null) {
+            if (networkSize != null && networkSize != length) {
+                // For fixed-size types, length should match. Could be strict or a warning.
+                // For this DSEL, we enforce it for alignment.
+                throw new IllegalArgumentException(name() + " is fixed size " + networkSize + " but requested " + length);
+            }
+            return (Parser<T>) defaultDecoder;
+        }
+        throw new UnsupportedOperationException(name() + " requires a length-specific decoder. Use a factory method.");
+    }
+
+    /**
+     * Creates an encoder for this type, given a specific length.
+     * For fixed-size types, length might be ignored or used for validation.
+     * For variable-length types, length is crucial.
+     * @param length The expected length in bytes for the data to be encoded.
+     * @param <T> The source type of the value to be encoded.
+     * @return A {@link Function} that encodes a value of type {@code T} into a byte array.
+     * @throws UnsupportedOperationException if called on a fixed-size type where length is not applicable
+     *                                      or if the defaultEncoder is null for a type that requires it.
+     */
+    @SuppressWarnings("unchecked")
+    public <T> Function<T, byte[]> createEncoder(int length) {
+        if (defaultEncoder != null) {
+            if (networkSize != null && networkSize != length) {
+                throw new IllegalArgumentException(name() + " is fixed size " + networkSize + " but requested " + length);
+            }
+            return (Function<T, byte[]>) defaultEncoder;
+        }
+        throw new UnsupportedOperationException(name() + " requires a length-specific encoder. Use a factory method.");
+    }
+
+    /**
+     * Utility method to parse a {@link Series<Character>} into a long.
+     * This is a simple implementation and doesn't handle all edge cases of number parsing.
+     * @param chars The character series to parse.
+     * @return The parsed long value.
+     * @throws NumberFormatException if parsing fails.
+     */
+    private static Long parseLong(Series<Character> chars) {
+        if (chars.size() == 0) return 0L;
+        long result = 0;
+        int start = 0;
+        boolean negative = false;
+        if (chars.get(0) == '-') {
+            negative = true;
+            start = 1;
+        } else if (chars.get(0) == '+') {
+            start = 1;
+        }
+        for (int i = start; i < chars.size(); i++) {
+            char c = chars.get(i);
+            if (c >= '0' && c <= '9') {
+                result = result * 10 + (c - '0');
+            } else {
+                throw new NumberFormatException("Invalid character in number: " + c);
+            }
+        }
+        return negative ? -result : result;
+    }
+
+    /**
+     * Utility method to parse a {@link Series<Character>} into a double.
+     * This is a simple implementation and doesn't handle all edge cases of number parsing.
+     * @param chars The character series to parse.
+     * @return The parsed double value.
+     * @throws NumberFormatException if parsing fails.
+     */
+    private static Double parseDouble(Series<Character> chars) {
+        return Double.parseDouble(chars.toList().stream().collect(StringBuilder::new, StringBuilder::append, StringBuilder::append).toString());
+    }
+
+    /**
+     * Simple utility to convert a raw byte array to a Char Series.
+     * @param bytes The byte array.
+     * @return A Series of Characters.
+     */
+    private static Series<Character> bytesToCharSeries(byte[] bytes) {
+        String s = new String(bytes, StandardCharsets.UTF_8);
+        return Series.of(s.length(), s::charAt);
+    }
+}
+```
