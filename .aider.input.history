+**`bikeshed/src/main/java/com/yourdomain/bikeshed/cursor/Cursor.java`**
+(Primary interface for tabular data, built on `Series<RowVec>`.)
+
+```java
+package com.yourdomain.bikeshed.cursor;
+
+import com.yourdomain.bikeshed.core.Join;
+import com.yourdomain.bikeshed.core.Series;
+import com.yourdomain.bikeshed.dsel.D;
+import com.yourdomain.bikeshed.types.IOMemento;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Objects;
+import java.util.function.Function;
+import java.util.function.IntFunction;
+import java.util.stream.Collectors;
+import java.util.stream.IntStream;
+
+/**
+ * {@code Cursor} provides a columnar abstraction for tabular data, representing a
+ * {@link Series} of {@link RowVec}s. It is the primary interface for
+ * navigating and manipulating structured data within the DSEL, optimized for
+ * memory-mapped file access patterns (ISAM).
+ *
+ * Type alias equivalent: {@code typealias Cursor = Series<RowVec>}
+ */
+public interface Cursor extends Series<RowVec> {
+
+    /**
+     * Factory method for creating a Cursor.
+     * @param size The number of rows in the cursor.
+     * @param provider A function providing a RowVec for each row index.
+     * @return A new Cursor instance.
+     */
+    static Cursor of(int size, IntFunction<RowVec> provider) {
+        return new ImmutableCursor(size, provider);
+    }
+
+    /**
+     * Returns the {@link RowVec} at the specified row index.
+     * Glyph: `row(index)` or `at(index)`
+     * @param rowIndex The index of the row.
+     * @return The RowVec at the specified index.
+     */
+    default RowVec row(int rowIndex) {
+        return get(rowIndex);
+    }
+
+    /**
+     * Returns the {@link RowVec} at the specified row index.
+     * Negative indices count from the end (`-1` is the last row).
+     * Glyph: `at(index)`
+     * @param rowIndex The index of the row.
+     * @return The RowVec at the specified index.
+     */
+    default RowVec at(int rowIndex) {
+        return get(rowIndex < 0 ? size() + rowIndex : rowIndex);
+    }
+
+    /**
+     * Returns a new Cursor containing only the specified columns (by index).
+     * This is a compositional operation, creating a new view.
+     * Glyph: `get(int...)`
+     * @param columnIndices The indices of the columns to include.
+     * @return A new Cursor with selected columns.
+     */
+    default Cursor get(int... columnIndices) {
+        Objects.requireNonNull(columnIndices);
+        if (columnIndices.length == 0) return of(size(), i -> RowVec.of(0, idx -> null)); // Empty rows
+
+        return of(size(), rowIndex -> {
+            RowVec originalRow = get(rowIndex);
+            return RowVec.of(columnIndices.length, colIndex -> {
+                int originalColIdx = columnIndices[colIndex];
+                if (originalColIdx < 0 || originalColIdx >= originalRow.size()) {
+                    throw new IndexOutOfBoundsException("Column index " + originalColIdx + " out of bounds.");
+                }
+                return originalRow.get(originalColIdx);
+            });
+        });
+    }
+
+    /**
+     * Returns a new Cursor containing only the specified columns (by name).
+     * This operation first resolves column names to indices using {@link #meta()}.
+     * Glyph: `get(String...)`
+     * @param columnNames The names of the columns to include.
+     * @return A new Cursor with selected columns.
+     * @throws IllegalArgumentException if a column name is not found.
+     */
+    default Cursor get(String... columnNames) {
+        Objects.requireNonNull(columnNames);
+        Series<ColumnMeta> cursorMeta = meta();
+        int[] columnIndices = new int[columnNames.length];
+        for (int i = 0; i < columnNames.length; i++) {
+            String name = columnNames[i];
+            boolean found = false;
+            for (int j = 0; j < cursorMeta.size(); j++) {
+                if (Objects.equals(cursorMeta.get(j).name(), name)) {
+                    columnIndices[i] = j;
+                    found = true;
+                    break;
+                }
+            }
+            if (!found) {
+                throw new IllegalArgumentException("Column '" + name + "' not found in cursor metadata.");
+            }
+        }
+        return get(columnIndices);
+    }
+
+    /**
+     * Returns a {@link Series} of {@link ColumnMeta} for this cursor.
+     * This is derived from the first row's metadata providers.
+     * Glyph: `meta()`
+     * @return A Series of ColumnMeta.
+     */
+    default Series<ColumnMeta> meta() {
+        if (size() == 0) return D.sr(0, i -> null); // Empty Series of ColumnMeta
+
+        RowVec firstRow = get(0);
+        return D.sr(firstRow.size(), i -> firstRow.getColumnMeta(i));
+    }
+
+    /**
+     * Prints the first {@code numRows} of the cursor to the console, including headers.
+     * Glyph: `head`
+     * @param numRows The number of rows to print. Defaults to 5.
+     */
+    default void head(int numRows) {
+        System.out.println("--- Cursor Head (" + Math.min(numRows, size()) + "/" + size() + " rows) ---");
+        Series<ColumnMeta> cursorMeta = meta();
+        if (cursorMeta.size() > 0) {
+            String header = D.▶(cursorMeta).map(ColumnMeta::name).collect(Collectors.joining("\t| "));
+            System.out.println("Columns: " + header);
+            System.out.println("----------------------------------------");
+        }
+
+        IntStream.range(0, Math.min(numRows, size()))
+                 .mapToObj(this::get)
+                 .forEach(row -> {
+                     String rowValues = D.▶(row).map(Join::first).map(Object::toString).collect(Collectors.joining("\t| "));
+                     System.out.println(rowValues);
+                 });
+        System.out.println("----------------------------------------");
+    }
+
+    // Immutable concrete implementation
+    record ImmutableCursor(Integer first, IntFunction<RowVec> second) implements Cursor {
+        @Override
+        public String toString() {
+            return "Cursor(rows=" + first + ", columns=" + (first > 0 ? second.apply(0).size() : 0) + ")";
+        }
+
+        @Override
+        public boolean equals(Object o) {
+            if (this == o) return true;
+            if (o == null || getClass() != o.getClass()) return false;
+            ImmutableCursor that = (ImmutableCursor) o;
+            if (!Objects.equals(first, that.first)) return false;
+            if (first == 0) return true;
+            for (int i = 0; i < first; i++) {
+                if (!Objects.equals(second.apply(i), that.second.apply(i))) {
+                    return false;
+                }
+            }
+            return true;
+        }
+
+        @Override
+        public int hashCode() {
+            int result = Objects.hash(first);
+            for (int i = 0; i < Math.min(first, 5); i++) { // Limit for practical hash
+                result = 31 * result + Objects.hashCode(second.apply(i));
+            }
+            return result;
+        }
+    }
+}
+```
+
+**`bikeshed/src/main/java/com/yourdomain/bikeshed/isam/RecordMeta.java`**
+(Detailed metadata for ISAM columns.)
+
+```java
+package com.yourdomain.bikeshed.isam;
+
+import com.yourdomain.bbcursive.core.Parser;
+import com.yourdomain.bikeshed.cursor.ColumnMeta;
+import com.yourdomain.bikeshed.types.IOMemento;
+import com.yourdomain.bikeshed.types.TypeMemento;
+
+import java.util.function.Function;
+
+/**
+ * {@code RecordMeta} describes a column within an ISAM record,
+ * extending {@link ColumnMeta} with byte offsets and specific
+ * encoder/decoder functions. This is crucial for fixed-format file I/O
+ * and memory-mapped file alignment.
+ */
+public record RecordMeta(
+        String name,
+        IOMemento type,
+        int begin, // Byte offset start (inclusive)
+        int end,   // Byte offset end (exclusive)
+        Parser<?> decoder, // Parser for this column's data
+        Function<?, byte[]> encoder // Encoder for this column's data
+) implements ColumnMeta {
+
+    /**
+     * Convenience constructor that automatically creates decoders and encoders
+     * based on the {@link IOMemento} and the provided byte length.
+     * This is particularly useful for fixed-size fields.
+     *
+     * @param name The name of the column.
+     * @param type The IOMemento defining the data type.
+     * @param begin The starting byte offset of the column within the record.
+     * @param end The ending byte offset (exclusive) of the column within the record.
+     */
+    public RecordMeta(String name, IOMemento type, int begin, int end) {
+        this(name, type, begin, end,
+             type.createDecoder(end - begin),
+             type.createEncoder(end - begin));
+    }
+
+    @Override
+    public String first() {
+        return name;
+    }
+
+    @Override
+    public TypeMemento second() {
+        return type;
+    }
+
+    @Override
+    public String toString() {
+        return "RecordMeta(name='" + name + "', type=" + type + ", begin=" + begin + ", end=" + end + ")";
+    }
+}
+```
+
+**`bikeshed/src/main/java/com/yourdomain/bikeshed/isam/IsamMetaFileReader.java`**
+(Reads metadata from ISAM metafile.)
+
+```java
+package com.yourdomain.bikeshed.isam;
+
+import com.yourdomain.bikeshed.core.Series;
+import com.yourdomain.bikeshed.types.IOMemento;
+
+import java.io.IOException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Objects;
+import java.util.stream.Collectors;
+import java.util.stream.IntStream;
+
+/**
+ * {@code IsamMetaFileReader} is responsible for parsing and interpreting
+ * the metadata file associated with an ISAM data file. It extracts column
+ * definitions ({@link RecordMeta}) including names, types, and byte offsets.
+ */
+public class IsamMetaFileReader {
+    private final String metafileFilename;
+    private Series<RecordMeta> recordMetas;
+    private int recordLength;
+
+    public IsamMetaFileReader(String metafileFilename) {
+        this.metafileFilename = Objects.requireNonNull(metafileFilename);
+    }
+
+    /**
+     * Loads the metadata from the specified file.
+     * The file format is expected to be:
+     * <pre>
+     * # format:  coords WS .. EOL names WS .. EOL TypeMememento WS ..
+     * # last coord is the recordlen
+     * 0 12 12 24 24 32 32 40 40 48 48 56 56 64 64 72 72 76 76 84 84 92
+     * Open_time Close_time Open High Low Close Volume Quote_asset_volume Number_of_trades Taker_buy_base_asset_volume Taker_buy_quote_asset_volume
+     * IoInstant IoInstant IoDouble IoDouble IoDouble IoDouble IoDouble IoDouble IoInt IoDouble IoDouble
+     * </pre>
+     * @throws IOException if the file cannot be read or is malformed.
+     */
+    public void load() throws IOException {
+        List<String> lines = Files.readAllLines(Path.of(metafileFilename))
+                .stream()
+                .filter(line -> !line.trim().startsWith("#") && !line.isBlank())
+                .collect(Collectors.toList());
+
+        if (lines.size() < 3) {
+            throw new IOException("Malformed metafile: expected at least 3 non-comment, non-empty lines.");
+        }
+
+        String[] coords = lines.get(0).trim().split("\\s+");
+        String[] names = lines.get(1).trim().split("\\s+");
+        String[] types = lines.get(2).trim().split("\\s+");
+
+        if (names.length != types.length || coords.length != names.length * 2) {
+            throw new IOException("Malformed metafile: mismatch in column definitions.");
+        }
+
+        List<RecordMeta> parsedMetas = new ArrayList<>(names.length);
+        for (int i = 0; i < names.length; i++) {
+            String name = names[i];
+            IOMemento ioType = IOMemento.valueOf(types[i]);
+            int begin = Integer.parseInt(coords[2 * i]);
+            int end = Integer.parseInt(coords[2 * i + 1]);
+
+            parsedMetas.add(new RecordMeta(name, ioType, begin, end));
+        }
+        this.recordMetas = Series.of(parsedMetas.size(), parsedMetas::get);
+        this.recordLength = parsedMetas.isEmpty() ? 0 : parsedMetas.get(parsedMetas.size() - 1).end();
+    }
+
+    public Series<RecordMeta> getRecordMetas() {
+        if (recordMetas == null) {
+            try {
+                load();
+            } catch (IOException e) {
+                throw new IllegalStateException("Failed to load ISAM metafile: " + metafileFilename, e);
+            }
+        }
+        return recordMetas;
+    }
+
+    public int getRecordLength() {
+        if (recordMetas == null) {
+            try {
+                load();
+            } catch (IOException e) {
+                throw new IllegalStateException("Failed to load ISAM metafile: " + metafileFilename, e);
+            }
+        }
+        return recordLength;
+    }
+
+    @Override
+    public String toString() {
+        return "IsamMetaFileReader{" +
+               "metafileFilename='" + metafileFilename + '\'' +
+               ", recordLength=" + recordLength +
+               ", recordMetas=" + recordMetas +
+               '}';
+    }
+
+    /**
+     * Writes metadata to an ISAM metafile.
+     * This method will sanitize the provided {@link Series<ColumnMeta>}
+     * to derive concrete {@link RecordMeta} instances with proper byte offsets,
+     * especially handling variable-length types if their lengths are provided.
+     *
+     * @param metafileFilename The path to the metafile to write.
+     * @param columnMetas The column metadata to write.
+     * @param varChars A map from column name to its fixed length for variable-length types (e.g., IoString).
+     * @return The series of sanitized RecordMeta instances.
+     * @throws IOException if writing fails.
+     * @throws IllegalArgumentException if a variable-length type lacks a specified length.
+     */
+    public static Series<RecordMeta> write(String metafileFilename, Series<ColumnMeta> columnMetas, Map<String, Integer> varChars) throws IOException {
+        List<RecordMeta> sanitizedMetas = new ArrayList<>();
+        int currentOffset = 0;
+
+        for (int i = 0; i < columnMetas.size(); i++) {
+            ColumnMeta colMeta = columnMetas.get(i);
+            if (!(colMeta.type() instanceof IOMemento ioMemento)) {
+                throw new IllegalArgumentException("Unsupported TypeMemento for ISAM: " + colMeta.type().getClass().getSimpleName());
+            }
+
+            Integer fixedSize = ioMemento.networkSize();
+            int declaredLength;
+
+            if (fixedSize != null) {
+                declaredLength = fixedSize;
+            } else { // Variable-length type
+                declaredLength = varChars.getOrDefault(colMeta.name(), -1);
+                if (declaredLength == -1) {
+                    throw new IllegalArgumentException("Variable-length type '" + colMeta.name() + "' (Type: " + ioMemento + ") requires explicit length in varChars map.");
+                }
+            }
+            sanitizedMetas.add(new RecordMeta(colMeta.name(), ioMemento, currentOffset, currentOffset + declaredLength));
+            currentOffset += declaredLength;
+        }
+
+        List<String> lines = new ArrayList<>();
+        lines.add("# format: coords WS .. EOL names WS .. EOL TypeMememento WS .. [EOL]");
+        lines.add("# last coord is the recordlen");
+
+        String coordsLine = IntStream.range(0, sanitizedMetas.size())
+                .mapToObj(i -> sanitizedMetas.get(i).begin() + " " + sanitizedMetas.get(i).end())
+                .collect(Collectors.joining(" "));
+        lines.add(coordsLine);
+
+        String namesLine = IntStream.range(0, sanitizedMetas.size())
+                .mapToObj(i -> sanitizedMetas.get(i).name())
+                .collect(Collectors.joining(" "));
+        lines.add(namesLine);
+
+        String typesLine = IntStream.range(0, sanitizedMetas.size())
+                .mapToObj(i -> sanitizedMetas.get(i).type().name())
+                .collect(Collectors.joining(" "));
+        lines.add(typesLine);
+
+        Files.write(Path.of(metafileFilename), lines);
+        return Series.of(sanitizedMetas.size(), sanitizedMetas::get);
+    }
+}
+```
+
+**`bikeshed/src/main/java/com/yourdomain/bikeshed/isam/IsamDataFile.java`**
+(Simulated ISAM data file interaction. **Requires `java.nio.file.Files` and `java.nio.MappedByteBuffer` on JVM. This is a conceptual implementation as the actual mmap/file I/O is platform-specific.**)
+
+```java
+package com.yourdomain.bikeshed.isam;
+
+import com.yourdomain.bbcursive.core.Parser;
+import com.yourdomain.bbcursive.core.ParserResult;
+import com.yourdomain.bikeshed.core.Join;
+import com.yourdomain.bikeshed.core.Series;
+import com.yourdomain.bikeshed.cursor.ColumnMeta;
+import com.yourdomain.bikeshed.cursor.Cursor;
+import com.yourdomain.bikeshed.cursor.RowVec;
+import com.yourdomain.bikeshed.dsel.D;
+import com.yourdomain.bikeshed.types.IOMemento;
+
+import java.io.IOException;
+import java.nio.ByteBuffer;
+import java.nio.channels.FileChannel;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.nio.file.StandardOpenOption;
+import java.util.Iterator;
+import java.util.List;
+import java.util.Map;
+import java.util.Objects;
+import java.util.Optional;
+import java.util.function.Function;
+import java.util.function.IntFunction;
+import java.util.stream.Collectors;
+
+/**
+ * {@code IsamDataFile} provides high-performance, memory-mapped access
+ * to fixed-format tabular data, leveraging {@code bbcursive} for efficient
+ * byte-level parsing and ISAM metadata for schema definition.
+ * It implements the {@link Cursor} interface for DSEL-native data access.
+ *
+ * This implementation is conceptual; actual memory-mapped file I/O ({@code MappedByteBuffer})
+ * would be platform-specific and requires careful resource management.
+ */
+public class IsamDataFile implements Cursor {
+    private final String dataFileFilename;
+    private final IsamMetaFileReader metaFile;
+    private ByteBuffer mmapBuffer; // Represents the memory-mapped file content
+    private int recordCount;
+    private int recordLength;
+    private Series<RecordMeta> recordMetas;
+
+    private FileChannel fileChannel; // Used for actual file mapping
+
+    public IsamDataFile(String dataFileFilename, String metafileFilename) {
+        this.dataFileFilename = Objects.requireNonNull(dataFileFilename);
+        this.metaFile = new IsamMetaFileReader(Objects.requireNonNull(metafileFilename));
+    }
+
+    /**
+     * Opens the ISAM data file and maps it into memory.
+     * This method initializes the cursor by reading the metadata and calculating record counts.
+     *
+     * @throws IOException if an I/O error occurs.
+     * @throws IllegalStateException if the file is already open.
+     */
+    public void open() throws IOException {
+        if (mmapBuffer != null) {
+            throw new IllegalStateException("ISAM file is already open.");
+        }
+
+        metaFile.load();
+        recordMetas = metaFile.getRecordMetas();
+        recordLength = metaFile.getRecordLength();
+
+        Path filePath = Path.of(dataFileFilename);
+        if (!Files.exists(filePath)) {
+            throw new IOException("Data file does not exist: " + dataFileFilename);
+        }
+
+        long fileSize = Files.size(filePath);
+        if (recordLength == 0) { // Handle empty meta or malformed for 0 record length
+            this.recordCount = 0;
+            this.mmapBuffer = ByteBuffer.allocate(0); // Empty buffer
+            return;
+        }
+        this.recordCount = (int) (fileSize / recordLength);
+
+        // Actual memory mapping (JVM specific)
+        this.fileChannel = FileChannel.open(filePath, StandardOpenOption.READ);
+        this.mmapBuffer = fileChannel.map(FileChannel.MapMode.READ_ONLY, 0, fileSize);
+    }
+
+    /**
+     * Closes the ISAM data file and releases the memory map.
+     *
+     * @throws IOException if an I/O error occurs.
+     */
+    public void close() throws IOException {
+        if (fileChannel != null) {
+            fileChannel.close();
+            fileChannel = null;
+        }
+        mmapBuffer = null;
+        recordMetas = null;
+        recordCount = 0;
+        recordLength = 0;
+    }
+
+    @Override
+    public int size() {
+        if (mmapBuffer == null) {
+            throw new IllegalStateException("ISAM file is not open. Call open() first.");
+        }
+        return recordCount;
+    }
+
+    @Override
+    public RowVec get(int rowIndex) {
+        if (rowIndex < 0 || rowIndex >= recordCount) {
+            throw new IndexOutOfBoundsException("Row index " + rowIndex + " out of bounds for " + recordCount + " records.");
+        }
+        if (mmapBuffer == null) {
+            throw new IllegalStateException("ISAM file is not open.");
+        }
+
+        // Create a slice for the specific record to avoid modifying the main buffer's position
+        ByteBuffer recordBuffer = mmapBuffer.duplicate();
+        recordBuffer.position(rowIndex * recordLength);
+        recordBuffer.limit(recordBuffer.position() + recordLength);
+        ByteBuffer recordSlice = recordBuffer.slice(); // This slice is a new view, its position starts at 0
+
+        return RowVec.of(recordMetas.size(), columnIndex -> {
+            RecordMeta meta = recordMetas.get(columnIndex);
+            ByteBuffer columnBuffer = recordSlice.duplicate(); // Duplicate for each column to preserve recordSlice's position
+            columnBuffer.position(meta.begin());
+            columnBuffer.limit(meta.end());
+
+            // Use the parser from RecordMeta
+            Parser<?> columnParser = meta.decoder();
+            Optional<ParserResult<?>> result = columnParser.parse(columnBuffer);
+
+            // Lazy ColumnMeta provider
+            Function<Void, ColumnMeta> columnMetaProvider = v -> meta;
+
+            return D.jn(result.orElseThrow(() ->
+                    new IllegalStateException("Failed to parse column " + meta.name() + " at row " + rowIndex)
+            ).value(), columnMetaProvider);
+        });
+    }
+
+    /**
+     * Writes the content of a {@link Cursor} to a new ISAM data file and its corresponding metafile.
+     * This is a batch operation.
+     *
+     * @param cursor The Cursor containing the data to write.
+     * @param dataFilename The path for the data file.
+     * @param varChars A map for variable-length column sizes if applicable.
+     * @throws IOException if an I/O error occurs.
+     * @throws IllegalArgumentException if column metadata is missing or inconsistent.
+     */
+    public static void write(Cursor cursor, String dataFilename, Map<String, Integer> varChars) throws IOException {
+        if (cursor.size() == 0) {
+            System.out.println("Warning: Attempting to write an empty cursor to ISAM file.");
+            Files.write(Path.of(dataFilename), new byte[0]); // Create empty file
+            IsamMetaFileReader.write(dataFilename + ".meta", D.sr(0, i -> null), varChars); // Create empty metafile
+            return;
+        }
+
+        Series<ColumnMeta> sourceMetas = cursor.meta();
+        Series<RecordMeta> sanitizedMetas = IsamMetaFileReader.write(dataFilename + ".meta", sourceMetas, varChars);
+        int recordLength = sanitizedMetas.get(sanitizedMetas.size() - 1).end();
+
+        // Prepare a single ByteBuffer for writing all data to minimize file I/O operations.
+        // For very large cursors, this might exceed available RAM. In such cases,
+        // chunked writing or direct MappedByteBuffer operations would be needed.
+        ByteBuffer outputBuffer = ByteBuffer.allocate(cursor.size() * recordLength);
+
+        for (int i = 0; i < cursor.size(); i++) {
+            RowVec row = cursor.get(i);
+            // Ensure row has the same number of columns as defined in metadata
+            if (row.size() != sanitizedMetas.size()) {
+                throw new IllegalArgumentException("Row " + i + " has " + row.size() + " columns, but metadata expects " + sanitizedMetas.size());
+            }
+
+            ByteBuffer recordByteBuffer = ByteBuffer.allocate(recordLength); // Temp buffer for current record
+            for (int j = 0; j < sanitizedMetas.size(); j++) {
+                RecordMeta meta = sanitizedMetas.get(j);
+                Object value = row.getValue(j);
+                Function<Object, byte[]> encoder = (Function<Object, byte[]>) meta.encoder();
+                byte[] encodedBytes = encoder.apply(value);
+
+                // Ensure encoded bytes fit within the declared column length
+                if (encodedBytes.length > (meta.end() - meta.begin())) {
+                    System.err.println("Warning: Value for column '" + meta.name() + "' exceeded declared length. Truncating.");
+                }
+
+                // Put bytes into the record's ByteBuffer at the correct offset
+                recordByteBuffer.position(meta.begin());
+                recordByteBuffer.put(encodedBytes, 0, Math.min(encodedBytes.length, (meta.end() - meta.begin())));
+            }
+            recordByteBuffer.flip(); // Prepare for reading from this buffer
+            outputBuffer.put(recordByteBuffer); // Write the whole record into the large output buffer
+        }
+
+        outputBuffer.flip(); // Prepare the main output buffer for writing to file
+        try (FileChannel channel = FileChannel.open(Path.of(dataFilename), StandardOpenOption.CREATE, StandardOpenOption.WRITE, StandardOpenOption.TRUNCATE_EXISTING)) {
+            while (outputBuffer.hasRemaining()) {
+                channel.write(outputBuffer);
+            }
+        }
+    }
+
+    /**
+     * Appends records from an iterable of {@link RowVec} to an existing ISAM data file.
+     * This operation assumes the file and its metadata already exist and are valid.
+     *
+     * @param records The iterable of RowVecs to append.
+     * @param dataFilename The path to the data file.
+     * @param metafileFilename The path to the metafile.
+     * @param varChars A map for variable-length column sizes if applicable (used for validation).
+     * @param transform An optional function to transform each RowVec before appending.
+     * @throws IOException if an I/O error occurs.
+     * @throws IllegalArgumentException if column metadata is missing or inconsistent.
+     */
+    public static void append(
+            Iterable<RowVec> records,
+            String dataFilename,
+            String metafileFilename,
+            Map<String, Integer> varChars,
+            Function<RowVec, RowVec> transform) throws IOException {
+
+        IsamMetaFileReader reader = new IsamMetaFileReader(metafileFilename);
+        reader.load();
+        Series<RecordMeta> recordMetas = reader.getRecordMetas();
+        int recordLength = reader.getRecordLength();
+
+        Path dataPath = Path.of(dataFilename);
+        try (FileChannel channel = FileChannel.open(dataPath, StandardOpenOption.APPEND, StandardOpenOption.CREATE)) {
+            ByteBuffer recordByteBuffer = ByteBuffer.allocate(recordLength);
+
+            for (RowVec row : records) {
+                RowVec processedRow = (transform != null) ? transform.apply(row) : row;
+
+                if (processedRow.size() != recordMetas.size()) {
+                    throw new IllegalArgumentException("Row has " + processedRow.size() + " columns, but metadata expects " + recordMetas.size());
+                }
+
+                recordByteBuffer.clear(); // Reset buffer for new record
+                for (int j = 0; j < recordMetas.size(); j++) {
+                    RecordMeta meta = recordMetas.get(j);
+                    Object value = processedRow.getValue(j);
+                    Function<Object, byte[]> encoder = (Function<Object, byte[]>) meta.encoder();
+                    byte[] encodedBytes = encoder.apply(value);
+
+                    // Put bytes into the record's ByteBuffer at the correct offset
+                    recordByteBuffer.position(meta.begin());
+                    recordByteBuffer.put(encodedBytes, 0, Math.min(encodedBytes.length, (meta.end() - meta.begin())));
+                }
+                recordByteBuffer.flip(); // Prepare for reading from this buffer
+                channel.write(recordByteBuffer); // Write the whole record to file
+            }
+        }
+    }
+}
+```
+
+**`bikeshed/src/main/java/com/yourdomain/bikeshed/csv/CsvProcessor.java`**
+(Basic CSV ingestion leveraging `Series` and `RowVec`.)
+
+```java
+package com.yourdomain.bikeshed.csv;
+
+import com.yourdomain.bikeshed.core.Join;
+import com.yourdomain.bikeshed.core.Series;
+import com.yourdomain.bikeshed.cursor.ColumnMeta;
+import com.yourdomain.bikeshed.cursor.Cursor;
+import com.yourdomain.bikeshed.cursor.RowVec;
+import com.yourdomain.bikeshed.dsel.D;
+import com.yourdomain.bikeshed.types.IOMemento;
+
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.List;
+import java.util.Map;
+import java.util.Objects;
+import java.util.function.Function;
+import java.util.stream.Collectors;
+import java.util.stream.IntStream;
+
+/**
+ * {@code CsvProcessor} provides utilities for ingesting CSV data
+ * and converting it into a {@link Cursor} representation.
+ * It supports basic header parsing and type deduction.
+ */
+public class CsvProcessor {
+
+    /**
+     * Parses a list of CSV lines into a {@link Cursor}.
+     * The first line is treated as headers. All data is initially treated as String.
+     * For type deduction, a more sophisticated {@code TypeEvidence} mechanism would be integrated.
+     *
+     * @param csvLines A list of strings, where each string is a CSV line.
+     *                 The first line must be the header.
+     * @return A {@link Cursor} representing the parsed CSV data.
+     */
+    public static Cursor parseCsv(List<String> csvLines) {
+        if (csvLines == null || csvLines.isEmpty()) {
+            return D.sr(0, i -> null); // Empty cursor
+        }
+
+        String headerLine = csvLines.get(0);
+        List<String> rawHeaders = Arrays.asList(headerLine.split(","));
+        // Trim whitespace from headers
+        List<String> headers = rawHeaders.stream().map(String::trim).collect(Collectors.toList());
+
+        // For simplicity, all columns are initially IoString.
+        // A more advanced version would use TypeEvidence to deduce types.
+        List<ColumnMeta> columnMetas = headers.stream()
+                .map(h -> ColumnMeta.of(h, IOMemento.IoString))
+                .collect(Collectors.toList());
+
+        Series<ColumnMeta> metaSeries = D.sr(columnMetas.size(), columnMetas::get);
+
+        List<String> dataLines = csvLines.subList(1, csvLines.size());
+
+        return D.sr(dataLines.size(), rowIndex -> {
+            String dataLine = dataLines.get(rowIndex);
+            List<String> rowValues = Arrays.asList(dataLine.split(","));
+
+            // Ensure row values match header count, pad with empty string or truncate
+            List<String> paddedValues = new ArrayList<>(rowValues);
+            while (paddedValues.size() < headers.size()) {
+                paddedValues.add("");
+            }
+            if (paddedValues.size() > headers.size()) {
+                paddedValues = paddedValues.subList(0, headers.size());
+            }
+
+            return RowVec.of(headers.size(), columnIndex -> {
+                String value = paddedValues.get(columnIndex).trim();
+                // Lazy ColumnMeta provider for the row
+                Function<Void, ColumnMeta> metaProvider = v -> metaSeries.get(columnIndex);
+                return D.jn(value, metaProvider);
+            });
+        });
+    }
+}
+```
+
+---
+
+### Trading Simulator Gap Analysis & DSEL Integration
+
+The `bbcursive` DSEL is designed to address the challenges of a concurrent trading simulator by emphasizing immutability, zero-copy operations, and compositional data structures.
+
+1.  **Binance Archive Ingestion (MarketDataSource):**
+    *   **Challenge:** Ingesting large historical data archives (e.g., Binance K-line data) efficiently.
+    *   **DSEL Solution:**
+        *   **`bbcursive`:** The low-level `bbcursive` module (using `BBAtom` and `BBCombinator`) will be the cornerstone for parsing raw binary or compressed (`ByteBuffer`-backed) archive data. Custom parsers can be built to handle specific Binance data formats (e.g., fixed-width binary records, or highly optimized CSV parsing). This enables zero-copy parsing directly from memory-mapped files.
+        *   **`ISAM`:** The `ISAM` structures (`IsamDataFile`, `IsamMetaFileReader`) are explicitly designed for structured, fixed-format file I/O, aligning perfectly with memory-mapped files (mmap). Once parsed by `bbcursive`, the data is written into `ISAM` files.
+        *   **`Series` and `Cursor`:** These high-level DSEL APIs are the primary interfaces to query the `ISAM` data. A `MarketDataSource` (in `acapulco`) would read from these `ISAM` files, making historical tick data available as `Cursor`s of `MarketTick` (represented as `RowVec`).
+        *   **Example Flow:** Raw Binance data `(ByteBuffer)` -> `bbcursive` parsers -> `RowVec`s -> `IsamDataFile.append()` -> `ISAM` file. Then, `IsamDataFile.open()` provides a `Cursor` interface to this data.
+
+2.  **Concurrent Trade Agents on Shared Timeline:**
+    *   **Challenge:** Multiple independent agents needing efficient, concurrent access to a shared, immutable market timeline without complex locking.
+    *   **DSEL Solution:**
+        *   **Immutability:** The core `Join` primitive and its derived types (`Series`, `Cursor`, `RowVec`) are *immutable*. This means agents can safely read and operate on the shared market timeline (`Series<MarketTick>` or `Cursor` of ticks) concurrently without explicit locking mechanisms on the data itself. There are no race conditions on data reads because data cannot be changed after creation.
+        *   **Zero-Copy Access (mmap/ISAM):** `Series` and `Cursor` backed by mmap/ISAM ensure that data access by agents is zero-copy. The `ByteBuffer` views provided by `bbcursive` mean data isn't constantly copied from disk to heap, minimizing memory pressure and maximizing throughput for data-intensive lookbacks.
+        *   **Concurrency Model:** While the DSEL simplifies *data access*, concurrent mutations (e.g., agent wallet state, order book updates) would still require `java.util.concurrent` primitives (like `AtomicReference`, `StampedLock`, or actor models) for agent-local mutable state or transaction submission. However, the *input* data (the timeline) remains immutable, greatly simplifying reasoning.
+        *   **Time-series Navigation (`Cursor`):** `Cursor` operations like `row(index)`, `at(index)`, `get(columnNames)`, `slice(range)` are fundamental for agents to efficiently navigate and extract relevant historical data based on their lookback periods. For example, an agent might request `cursor.slice(D.sr.IntRange(currentIndex - lookbackPeriod, currentIndex))` to get its historical view.
+
+3.  **Reward-Based Agent Visibility:**
+    *   **Challenge:** Dynamically adjusting data visibility or accessibility for agents based on performance or reward metrics.
+    *   **DSEL Solution:**
+        *   **Predicate Composition:** DSEL primitives can be used to construct and evaluate predicates. For example, agent performance records can be stored as a `Cursor<AgentPerformanceMetric>`. A `Predicate<AgentPerformanceMetric>` (or a `Series<Boolean>` derived from it) can then be used to filter views of the `MarketTick` cursor or other data sources.
+        *   **Filtered Views:** A `Cursor` can be easily transformed into a filtered `Cursor` (e.g., `D.filter(marketTicks, tick -> agent.canSee(tick))`). This creates a new, immutable `Cursor` view that only contains data accessible to a specific agent based on its current reward state. This approach ensures data privacy and controlled visibility without complex data copying or granting/revoking permissions on raw data.
+        *   **Example:** If an agent's "reward" (e.g., profitability) drops below a threshold, a dynamically generated filter can be applied to the `MarketTick` cursor, limiting its view to only high-volume trades or specific asset pairs, effectively reducing its data access.
+
+---
+
+### Basic Test Example
+
+To verify the DSEL works, here's a simple test case for `bikeshed`'s `Cursor` and `CsvProcessor`.
+
+**`bikeshed/src/test/java/com/yourdomain/bikeshed/CsvProcessorTest.java`**
+
+```java
+package com.yourdomain.bikeshed;
+
+import com.yourdomain.bikeshed.cursor.Cursor;
+import com.yourdomain.bikeshed.cursor.RowVec;
+import com.yourdomain.bikeshed.csv.CsvProcessor;
+import com.yourdomain.bikeshed.dsel.D;
+import com.yourdomain.bikeshed.types.IOMemento;
+import org.junit.jupiter.api.Test;
+
+import java.util.Arrays;
+import java.util.List;
+import java.util.stream.Collectors;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+public class CsvProcessorTest {
+
+    @Test
+    void testParseCsvBasic() {
+        List<String> csvData = Arrays.asList(
+                "Name,Age,City",
+                "Alice,30,New York",
+                "Bob,24,London",
+                "Charlie,35,Paris"
+        );
+
+        Cursor cursor = CsvProcessor.parseCsv(csvData);
+
+        assertNotNull(cursor);
+        assertEquals(3, cursor.size(), "Should have 3 data rows");
+
+        // Test metadata
+        assertEquals(3, cursor.meta().size(), "Should have 3 columns");
+        assertEquals("Name", cursor.meta().get(0).name());
+        assertEquals(IOMemento.IoString, cursor.meta().get(0).type());
+        assertEquals("Age", cursor.meta().get(1).name());
+        assertEquals("City", cursor.meta().get(2).name());
+
+        // Test row access and values
+        RowVec row0 = cursor.row(0);
+        assertEquals("Alice", row0.getValue(0));
+        assertEquals("30", row0.getValue(1));
+        assertEquals("New York", row0.getValue(2));
+
+        RowVec row1 = cursor.at(1); // Test at()
+        assertEquals("Bob", row1.getValue(0));
+        assertEquals("24", row1.getValue(1));
+        assertEquals("London", row1.getValue(2));
+
+        RowVec row2 = cursor.at(-1); // Test negative index for last row
+        assertEquals("Charlie", row2.getValue(0));
+        assertEquals("35", row2.getValue(1));
+        assertEquals("Paris", row2.getValue(2));
+
+        // Test column selection by index
+        Cursor selectedByIndex = cursor.get(0, 2); // Select "Name", "City"
+        assertEquals(3, selectedByIndex.size());
+        assertEquals(2, selectedByIndex.meta().size());
+        assertEquals("Alice", selectedByIndex.row(0).getValue(0));
+        assertEquals("New York", selectedByIndex.row(0).getValue(1));
+        assertEquals("Bob", selectedByIndex.row(1).getValue(0));
+        assertEquals("London", selectedByIndex.row(1).getValue(1));
+
+        // Test column selection by name
+        Cursor selectedByName = cursor.get("Age", "Name"); // Select "Age", "Name"
+        assertEquals(3, selectedByName.size());
+        assertEquals(2, selectedByName.meta().size());
+        assertEquals("Age", selectedByName.meta().get(0).name());
+        assertEquals("Name", selectedByName.meta().get(1).name());
+        assertEquals("30", selectedByName.row(0).getValue(0));
+        assertEquals("Alice", selectedByName.row(0).getValue(1));
+
+        // Test head() (output to console)
+        System.out.println("\n--- Testing Cursor.head() ---");
+        cursor.head(2); // Print first 2 rows
+    }
+
+    @Test
+    void testEmptyCsv() {
+        List<String> csvData = Arrays.asList("Header1,Header2");
+        Cursor cursor = CsvProcessor.parseCsv(csvData);
+        assertNotNull(cursor);
+        assertEquals(0, cursor.size()); // Only header, no data rows
+        assertEquals(2, cursor.meta().size()); // But headers are present
+    }
+
+    @Test
+    void testEmptyInputList() {
+        List<String> csvData = Arrays.asList();
+        Cursor cursor = CsvProcessor.parseCsv(csvData);
+        assertNotNull(cursor);
+        assertEquals(0, cursor.size());
+        assertEquals(0, cursor.meta().size());
+    }
+
+    @Test
+    void testCursorMapOperation() {
+        List<String> csvData = Arrays.asList(
+                "Value",
+                "1", "2", "3", "4"
+        );
+        Cursor cursor = CsvProcessor.parseCsv(csvData);
+
+        // Map values in the first column to Integer
+        Cursor mappedCursor = D.α(cursor, row -> {
+            Integer intValue = Integer.parseInt((String) row.getValue(0));
+            // Re-create row with transformed value. ColumnMeta should be updated too for proper type system
+            // For simplicity here, we assume a new meta with IoInt for the transformed column
+            ColumnMeta newMeta = ColumnMeta.of(row.getColumnMeta(0).name(), IOMemento.IoInt);
+            return RowVec.of(1, idx -> D.jn(intValue, (Function<Void, ColumnMeta>) v -> newMeta));
+        });
+
+        assertEquals(4, mappedCursor.size());
+        assertEquals(1, mappedCursor.meta().size());
+        assertEquals(IOMemento.IoInt, mappedCursor.meta().get(0).type());
+        assertEquals(1, (Integer) mappedCursor.row(0).getValue(0));
+        assertEquals(4, (Integer) mappedCursor.row(3).getValue(0));
+
+        // Demonstrate a simple filter
+        Cursor filteredCursor = D.filter(mappedCursor, row -> (Integer) row.getValue(0) > 2);
+        assertEquals(2, filteredCursor.size());
+        assertEquals(3, (Integer) filteredCursor.row(0).getValue(0));
+        assertEquals(4, (Integer) filteredCursor.row(1).getValue(0));
+    }
+
+    @Test
+    void testBbcursiveAtomParsers() {
+        // Test BBAtom parsers directly with ByteBuffer
+        java.nio.ByteBuffer buffer = java.nio.ByteBuffer.allocate(16);
+        buffer.putInt(12345);
+        buffer.putLong(9876543210L);
+        buffer.put((byte) 0xFF);
+        buffer.flip(); // Prepare for reading
+
+        // Parse Integer
+        java.util.Optional<com.yourdomain.bbcursive.core.ParserResult<Integer>> intResult = com.yourdomain.bbcursive.atom.BBAtom.I.parse(buffer);
+        assertTrue(intResult.isPresent());
+        assertEquals(12345, intResult.get().value());
+        assertEquals(4, buffer.position()); // Buffer position should advance
+
+        // Parse Long
+        java.util.Optional<com.yourdomain.bbcursive.core.ParserResult<Long>> longResult = com.yourdomain.bbcursive.atom.BBAtom.L.parse(buffer);
+        assertTrue(longResult.isPresent());
+        assertEquals(9876543210L, longResult.get().value());
+        assertEquals(12, buffer.position()); // Buffer position should advance again
+
+        // Parse Byte
+        java.util.Optional<com.yourdomain.bbcursive.core.ParserResult<Byte>> byteResult = com.yourdomain.bbcursive.atom.BBAtom.B.parse(buffer);
+        assertTrue(byteResult.isPresent());
+        assertEquals((byte) 0xFF, byteResult.get().value());
+        assertEquals(13, buffer.position());
+    }
+
+    @Test
+    void testBbcursiveCombinatorParsers() {
+        // Parse "HELLO" (5 bytes) followed by an Int (4 bytes)
+        java.nio.ByteBuffer buffer = java.nio.ByteBuffer.allocate(10);
+        buffer.put("HELLO".getBytes(java.nio.charset.StandardCharsets.UTF_8));
+        buffer.putInt(99);
+        buffer.flip();
+
+        com.yourdomain.bbcursive.core.Parser<String> helloParser = com.yourdomain.bbcursive.atom.BBAtom.S(5);
+        com.yourdomain.bbcursive.core.Parser<Integer> intParser = com.yourdomain.bbcursive.atom.BBAtom.I;
+
+        // Sequence parser using combinator.seq
+        java.util.Optional<com.yourdomain.bbcursive.core.ParserResult<List>> sequenceResult = com.yourdomain.bbcursive.combinator.BBCombinator.seq(helloParser, intParser).parse(buffer);
+
+        assertTrue(sequenceResult.isPresent());
+        List<Object> results = sequenceResult.get().value();
+        assertEquals(2, results.size());
+        assertEquals("HELLO", results.get(0));
+        assertEquals(99, results.get(1));
+        assertEquals(9, buffer.position()); // 5 (HELLO) + 4 (INT) = 9
+
+        // Test optional parser
+        buffer.clear(); buffer.put("A".getBytes()); buffer.flip(); // Only "A"
+        com.yourdomain.bbcursive.core.Parser<String> singleCharParser = com.yourdomain.bbcursive.atom.BBAtom.S(1);
+        com.yourdomain.bbcursive.core.Parser<String> twoCharParser = com.yourdomain.bbcursive.atom.BBAtom.S(2);
+
+        java.util.Optional<com.yourdomain.bbcursive.core.ParserResult<Optional<String>>> optionalSuccess = com.yourdomain.bbcursive.combinator.BBCombinator.opt(singleCharParser).parse(buffer);
+        assertTrue(optionalSuccess.isPresent());
+        assertTrue(optionalSuccess.get().value().isPresent());
+        assertEquals("A", optionalSuccess.get().value().get());
+
+        buffer.clear(); buffer.flip(); // Empty buffer
+        java.util.Optional<com.yourdomain.bbcursive.core.ParserResult<Optional<String>>> optionalFailure = com.yourdomain.bbcursive.combinator.BBCombinator.opt(singleCharParser).parse(buffer);
+        assertTrue(optionalFailure.isPresent()); // The combinator itself succeeded
+        assertTrue(optionalFailure.get().value().isEmpty()); // But the wrapped parser failed
+    }
+}
+```
+
+This comprehensive design and implementation outline covers the core requirements, project structure, DSEL philosophy, and integration points with the trading simulator scenario. Remember that the `ISAM` part relies on `java.nio.MappedByteBuffer` which is JVM-specific, so running this on other platforms (like Kotlin/JS or Kotlin/Native if you were to target them) would require different underlying `FileBuffer` implementations.

