+**3. `bbcursive` Java Source Code**
+
+**`bbcursive/src/main/java/com/yourdomain/bbcursive/core/Cursive.java`**
+(A functional interface representing a parser operation.)
+
+```java
+package com.yourdomain.bbcursive.core;
+
+import java.nio.ByteBuffer;
+import java.util.Optional;
+import java.util.function.Function;
+
+/**
+ * Represents a parser that consumes a ByteBuffer and produces a result of type T.
+ * It's a functional interface designed for composition.
+ *
+ * @param <T> The type of the result produced by the parser.
+ */
+@FunctionalInterface
+public interface Cursive<T> extends Function<ByteBuffer, Optional<T>> {
+
+    // Glyph-based shorthand for common parsing operations could be here,
+    // though for simple parsers, they might be in BBAtom or BBCombinator.
+    // Example: static <T> Cursive<T> at(Function<ByteBuffer, Optional<T>> parser) { return parser::apply; }
+}
+```
+
+**`bbcursive/src/main/java/com/yourdomain/bbcursive/core/Parser.java`**
+(A helper class/record to make parsers more explicit about how much they consume, though `Cursive`'s `Optional` already implies success/failure.)
+
+```java
+package com.yourdomain.bbcursive.core;
+
+import java.nio.ByteBuffer;
+import java.util.Objects;
+import java.util.Optional;
+
+/**
+ * Represents the result of a parsing operation: the parsed value and the ByteBuffer's state after parsing.
+ * @param <T> The type of the parsed value.
+ */
+public record ParserResult<T>(T value, ByteBuffer remainingBuffer) {
+    public static <T> ParserResult<T> of(T value, ByteBuffer remainingBuffer) {
+        return new ParserResult<>(value, remainingBuffer);
+    }
+}
+
+/**
+ * A more explicit parser interface that returns a ParserResult.
+ * This can be seen as an extension of Cursive, providing more context.
+ *
+ * @param <T> The type of the parsed value.
+ */
+@FunctionalInterface
+public interface Parser<T> extends Function<ByteBuffer, Optional<ParserResult<T>>> {
+
+    /**
+     * Parses the given ByteBuffer.
+     * On success, returns an Optional containing a ParserResult with the parsed value
+     * and the buffer positioned after the consumed bytes.
+     * On failure, returns an empty Optional and leaves the buffer position unchanged.
+     *
+     * @param buffer The ByteBuffer to parse. Its position will be advanced on success.
+     * @return An Optional with the ParserResult on success, or empty on failure.
+     */
+    Optional<ParserResult<T>> parse(ByteBuffer buffer);
+
+    @Override
+    default Optional<ParserResult<T>> apply(ByteBuffer buffer) {
+        // Capture initial position to reset on failure
+        int initialPosition = buffer.position();
+        Optional<ParserResult<T>> result = parse(buffer);
+        if (result.isEmpty()) {
+            buffer.position(initialPosition); // Reset on failure
+        }
+        return result;
+    }
+
+    /**
+     * Composes this parser with another parser, sequencing them.
+     * If this parser succeeds, the second parser is applied to the remaining buffer.
+     *
+     * @param nextParser The next parser to apply.
+     * @param <U> The type of the result of the next parser.
+     * @return A new parser that produces a Join of the results of both parsers.
+     */
+    default <U> Parser<Join<T, U>> then(Parser<U> nextParser) {
+        Objects.requireNonNull(nextParser);
+        return buffer -> this.parse(buffer).flatMap(r1 -> {
+            ByteBuffer currentBufferState = r1.remainingBuffer().duplicate(); // Work on a duplicate to allow backtracking for nextParser
+            return nextParser.parse(currentBufferState).map(r2 -> {
+                buffer.position(currentBufferState.position()); // Advance original buffer only on full success
+                return ParserResult.of(new Join.ImmutableJoin<>(r1.value(), r2.value()), buffer);
+            });
+        });
+    }
+
+    /**
+     * Maps the successful result of this parser to a new type.
+     * @param mapper The function to apply to the parsed value.
+     * @param <R> The new result type.
+     * @return A new parser that produces the mapped result.
+     */
+    default <R> Parser<R> map(Function<? super T, ? extends R> mapper) {
+        Objects.requireNonNull(mapper);
+        return buffer -> this.parse(buffer).map(r -> ParserResult.of(mapper.apply(r.value()), r.remainingBuffer()));
+    }
+
+    /**
+     * Returns a parser that, if this parser fails, tries the other parser.
+     * @param otherParser The alternative parser.
+     * @return A new parser that tries this or the other parser.
+     */
+    default Parser<T> or(Parser<T> otherParser) {
+        Objects.requireNonNull(otherParser);
+        return buffer -> {
+            int initialPosition = buffer.position();
+            Optional<ParserResult<T>> result = this.parse(buffer);
+            if (result.isPresent()) {
+                return result;
+            } else {
+                buffer.position(initialPosition); // Ensure position is reset before trying other
+                return otherParser.parse(buffer);
+            }
+        };
+    }
+}
+```
+
+**`bbcursive/src/main/java/com/yourdomain/bbcursive/atom/BBAtom.java`**
+(Primitive parsers for common data types and buffer operations.)
+
+```java
+package com.yourdomain.bbcursive.atom;
+
+import com.yourdomain.bbcursive.core.Parser;
+import com.yourdomain.bbcursive.core.ParserResult;
+
+import java.nio.ByteBuffer;
+import java.nio.charset.StandardCharsets;
+import java.util.Optional;
+
+/**
+ * {@code BBAtom} provides atomic {@link Parser} operations for {@link ByteBuffer}s.
+ * Each entry encapsulates a specific parsing logic for primitive data types or buffer manipulations.
+ * This enum acts as a namespace and factory for basic parsing units,
+ * adhering to the "Encapsulation via Enums" and "Glyph-based Shorthands" principles.
+ */
+public enum BBAtom {
+    /**
+     * Parses a single byte.
+     * Glyph: `B` (for Byte)
+     */
+    BYTE(buffer -> {
+        if (buffer.hasRemaining()) {
+            return Optional.of(ParserResult.of(buffer.get(), buffer));
+        }
+        return Optional.empty();
+    }),
+
+    /**
+     * Parses an integer (4 bytes) in network byte order.
+     * Glyph: `I` (for Int)
+     */
+    INT(buffer -> {
+        if (buffer.remaining() >= 4) {
+            return Optional.of(ParserResult.of(buffer.getInt(), buffer));
+        }
+        return Optional.empty();
+    }),
+
+    /**
+     * Parses a long (8 bytes) in network byte order.
+     * Glyph: `L` (for Long)
+     */
+    LONG(buffer -> {
+        if (buffer.remaining() >= 8) {
+            return Optional.of(ParserResult.of(buffer.getLong(), buffer));
+        }
+        return Optional.empty();
+    }),
+
+    /**
+     * Parses a fixed-length string from the buffer, decoding it as UTF-8.
+     * Needs a length parameter. This parser is a factory method.
+     * Glyph: `S` (for String)
+     */
+    STRING_FIXED_LENGTH(null) { // Null because it's a factory, not a direct parser
+        public Parser<String> ofLength(int length) {
+            return buffer -> {
+                if (buffer.remaining() >= length) {
+                    byte[] bytes = new byte[length];
+                    buffer.get(bytes);
+                    return Optional.of(ParserResult.of(new String(bytes, StandardCharsets.UTF_8), buffer));
+                }
+                return Optional.empty();
+            };
+        }
+    },
+
+    /**
+     * Creates a slice of the buffer. Does not consume bytes but creates a new buffer view.
+     * Needs a length parameter. This parser is a factory method.
+     * Glyph: `P` (for Part or Slice)
+     */
+    SLICE(null) { // Null because it's a factory, not a direct parser
+        public Parser<ByteBuffer> ofLength(int length) {
+            return buffer -> {
+                if (buffer.remaining() >= length) {
+                    int originalLimit = buffer.limit();
+                    int originalPosition = buffer.position();
+
+                    buffer.limit(originalPosition + length);
+                    ByteBuffer slice = buffer.slice(); // Creates a new buffer from current position to new limit
+                    buffer.position(originalPosition + length); // Advance the original buffer past the slice
+                    buffer.limit(originalLimit); // Restore original limit
+
+                    return Optional.of(ParserResult.of(slice, buffer));
+                }
+                return Optional.empty();
+            };
+        }
+    };
+
+    private final Parser<?> parser;
+
+    BBAtom(Parser<?> parser) {
+        this.parser = parser;
+    }
+
+    /**
+     * Returns the atomic parser associated with this enum entry.
+     * For factory entries (like STRING_FIXED_LENGTH or SLICE), this will throw an exception
+     * and should be used with their specific {@code ofLength} methods.
+     *
+     * @param <T> The expected type of the parsed result.
+     * @return The parser instance.
+     * @throws UnsupportedOperationException if called on a factory-style enum entry.
+     */
+    @SuppressWarnings("unchecked")
+    public <T> Parser<T> parser() {
+        if (parser == null) {
+            throw new UnsupportedOperationException("This BBAtom is a factory. Use its specific 'ofLength' method.");
+        }
+        return (Parser<T>) parser;
+    }
+
+    // Glyphs for direct access
+    public static final Parser<Byte> B = BBAtom.BYTE.parser();
+    public static final Parser<Integer> I = BBAtom.INT.parser();
+    public static final Parser<Long> L = BBAtom.LONG.parser();
+
+    /**
+     * Provides a parser for a fixed-length string.
+     * Glyph: `S(length)`
+     * @param length The number of bytes to read for the string.
+     * @return A parser for a fixed-length string.
+     */
+    public static Parser<String> S(int length) {
+        return BBAtom.STRING_FIXED_LENGTH.ofLength(length);
+    }
+
+    /**
+     * Provides a parser for a slice of the ByteBuffer.
+     * Glyph: `P(length)`
+     * @param length The number of bytes to slice.
+     * @return A parser for a ByteBuffer slice.
+     */
+    public static Parser<ByteBuffer> P(int length) {
+        return BBAtom.SLICE.ofLength(length);
+    }
+}
+```
+
+**`bbcursive/src/main/java/com/yourdomain/bbcursive/combinator/BBCombinator.java`**
+(Higher-order parsers for composing atomic parsers.)
+
+```java
+package com.yourdomain.bbcursive.combinator;
+
+import com.yourdomain.bbcursive.core.Join;
+import com.yourdomain.bbcursive.core.Parser;
+import com.yourdomain.bbcursive.core.ParserResult;
+
+import java.nio.ByteBuffer;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Objects;
+import java.util.Optional;
+import java.util.function.Function;
+
+/**
+ * {@code BBCombinator} provides higher-order {@link Parser} functions,
+ * allowing combination of simpler parsers into more complex ones.
+ * This enum acts as a namespace and factory for common parsing patterns,
+ * adhering to the "Encapsulation via Enums" and "Glyph-based Shorthands" principles.
+ */
+public enum BBCombinator {
+    /**
+     * Parses a sequence of parsers. If any parser in the sequence fails, the entire sequence fails.
+     * Glyph: `seq(p1, p2, ...)`
+     * @param <T> The type of the first parser's result.
+     * @param <U> The type of the second parser's result.
+     * @return A parser that produces a {@link Join} of the results.
+     */
+    SEQUENCE(null) {
+        @SafeVarargs
+        public final <T> Parser<List<T>> of(Parser<T>... parsers) {
+            Objects.requireNonNull(parsers);
+            return buffer -> {
+                List<T> results = new ArrayList<>(parsers.length);
+                ByteBuffer currentBuffer = buffer.duplicate(); // Operate on a copy to allow full backtracking for the sequence
+                int initialPosition = buffer.position();
+
+                for (Parser<T> parser : parsers) {
+                    Optional<ParserResult<T>> result = parser.parse(currentBuffer);
+                    if (result.isPresent()) {
+                        results.add(result.get().value());
+                        currentBuffer = result.get().remainingBuffer();
+                    } else {
+                        buffer.position(initialPosition); // Reset original buffer on failure
+                        return Optional.empty();
+                    }
+                }
+                buffer.position(currentBuffer.position()); // Advance original buffer only on full success
+                return Optional.of(ParserResult.of(results, buffer));
+            };
+        }
+    },
+
+    /**
+     * Tries a list of parsers in order and returns the first one that succeeds.
+     * Glyph: `cho(p1, p2, ...)`
+     * @param <T> The common type of the results of the parsers.
+     * @return A parser that produces the result of the first successful parser.
+     */
+    CHOICE(null) {
+        @SafeVarargs
+        public final <T> Parser<T> of(Parser<T>... parsers) {
+            Objects.requireNonNull(parsers);
+            return buffer -> {
+                int initialPosition = buffer.position();
+                for (Parser<T> parser : parsers) {
+                    Optional<ParserResult<T>> result = parser.parse(buffer);
+                    if (result.isPresent()) {
+                        return result;
+                    }
+                    buffer.position(initialPosition); // Reset buffer for the next choice
+                }
+                return Optional.empty(); // All choices failed
+            };
+        }
+    },
+
+    /**
+     * Attempts to parse zero or more occurrences of a parser.
+     * Always succeeds, returning an empty list if no occurrences are found.
+     * Glyph: `many(p)`
+     * @param <T> The type of the result of the repeated parser.
+     * @return A parser that produces a list of results.
+     */
+    MANY(null) {
+        public <T> Parser<List<T>> of(Parser<T> parser) {
+            Objects.requireNonNull(parser);
+            return buffer -> {
+                List<T> results = new ArrayList<>();
+                ByteBuffer currentBuffer = buffer.duplicate(); // Use a duplicate for internal consumption
+                int initialPosition = buffer.position(); // Keep track of the real buffer position
+
+                while (true) {
+                    Optional<ParserResult<T>> result = parser.parse(currentBuffer);
+                    if (result.isPresent()) {
+                        results.add(result.get().value());
+                        currentBuffer = result.get().remainingBuffer();
+                    } else {
+                        break; // Parser failed, stop consuming
+                    }
+                }
+                buffer.position(currentBuffer.position()); // Advance the original buffer
+                return Optional.of(ParserResult.of(results, buffer)); // Always succeeds
+            };
+        }
+    },
+
+    /**
+     * Attempts to parse one or more occurrences of a parser.
+     * Fails if no occurrences are found.
+     * Glyph: `some(p)`
+     * @param <T> The type of the result of the repeated parser.
+     * @return A parser that produces a list of results.
+     */
+    SOME(null) {
+        public <T> Parser<List<T>> of(Parser<T> parser) {
+            Objects.requireNonNull(parser);
+            return buffer -> {
+                int initialPosition = buffer.position();
+                Optional<ParserResult<List<T>>> manyResult = MANY.of(parser).parse(buffer);
+                if (manyResult.isPresent() && !manyResult.get().value().isEmpty()) {
+                    return manyResult;
+                }
+                buffer.position(initialPosition); // Reset on failure
+                return Optional.empty();
+            };
+        }
+    },
+
+    /**
+     * Attempts to parse a parser, returning an Optional result (empty if the parser fails).
+     * Always succeeds in terms of the combinator, just wraps the result in an Optional.
+     * Glyph: `opt(p)`
+     * @param <T> The type of the result of the parser.
+     * @return A parser that produces an Optional of the result.
+     */
+    OPTIONAL(null) {
+        public <T> Parser<Optional<T>> of(Parser<T> parser) {
+            Objects.requireNonNull(parser);
+            return buffer -> {
+                int initialPosition = buffer.position();
+                Optional<ParserResult<T>> result = parser.parse(buffer);
+                if (result.isPresent()) {
+                    return Optional.of(ParserResult.of(Optional.of(result.get().value()), result.get().remainingBuffer()));
+                } else {
+                    buffer.position(initialPosition); // Reset buffer as it's optional
+                    return Optional.of(ParserResult.of(Optional.empty(), buffer)); // Always succeeds (returns empty Optional as value)
+                }
+            };
+        }
+    },
+
+    /**
+     * Parses a parser and then discards its result, returning a fixed value.
+     * Useful for parsing delimiters or literals that don't need to be part of the final result.
+     * Glyph: `skip(p, value)`
+     * @param <T> The type of the parser's result (discarded).
+     * @param <U> The type of the fixed value to return.
+     * @return A new parser that produces the fixed value.
+     */
+    SKIP(null) {
+        public <T, U> Parser<U> of(Parser<T> parserToSkip, U fixedValue) {
+            Objects.requireNonNull(parserToSkip);
+            return buffer -> parserToSkip.parse(buffer).map(r -> ParserResult.of(fixedValue, r.remainingBuffer()));
+        }
+    };
+
+    private final Parser<?> combinator;
+
+    BBCombinator(Parser<?> combinator) {
+        this.combinator = combinator;
+    }
+
+    /**
+     * Note: This method is not intended for direct use with `BBCombinator` entries as they are factories.
+     * Use their specific `of` methods.
+     * @throws UnsupportedOperationException always.
+     */
+    public <T> Parser<T> parser() {
+        throw new UnsupportedOperationException("BBCombinator entries are factories. Use their specific 'of' methods (e.g., BBCombinator.seq(...)).");
+    }
+
+    // Glyph-based shorthands for common combinators
+    @SafeVarargs
+    public static <T> Parser<List<T>> seq(Parser<T>... parsers) {
+        return BBCombinator.SEQUENCE.of(parsers);
+    }
+
+    @SafeVarargs
+    public static <T> Parser<T> cho(Parser<T>... parsers) {
+        return BBCombinator.CHOICE.of(parsers);
+    }
+
+    public static <T> Parser<List<T>> many(Parser<T> parser) {
+        return BBCombinator.MANY.of(parser);
+    }
+
+    public static <T> Parser<List<T>> some(Parser<T> parser) {
+        return BBCombinator.SOME.of(parser);
+    }
+
+    public static <T> Parser<Optional<T>> opt(Parser<T> parser) {
+        return BBCombinator.OPTIONAL.of(parser);
+    }
+
+    public static <T, U> Parser<U> skip(Parser<T> parserToSkip, U fixedValue) {
+        return BBCombinator.SKIP.of(parserToSkip, fixedValue);
+    }
+}
+```
+
+---
+
+### `bikeshed` Module Design & Implementation
+
+This module contains the high-level DSEL data structures and operations, leveraging `bbcursive` for low-level I/O.
+
+**4. `bikeshed/pom.xml`**
+
+```xml
+<?xml version="1.0" encoding="UTF-8"?>
+<project xmlns="http://maven.apache.org/POM/4.0.0"
+         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
+         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
+    <modelVersion>4.0.0</modelVersion>
+
+    <parent>
+        <groupId>com.yourdomain.bbcursive</groupId>
+        <artifactId>dsel-bbcursive-parent</artifactId>
+        <version>1.0.0-SNAPSHOT</version>
+    </parent>
+
+    <artifactId>bikeshed</artifactId>
+    <name>BBDSEL Core - High-Level Data Structures</name>
+    <description>High-level DSEL implementation for data structures (Series, Cursor, RowVec, Join) and manipulation.</description>
+
+    <dependencies>
+        <!-- Dependency on the low-level bbcursive module -->
+        <dependency>
+            <groupId>com.yourdomain.bbcursive</groupId>
+            <artifactId>bbcursive</artifactId>
