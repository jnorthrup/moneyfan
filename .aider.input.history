+```java
+    // ... (existing get and iterator methods)
+
+    public Series<T> slice(int startIndex, int endIndex) {
+        if (startIndex < 0 || startIndex > size || endIndex < 0 || endIndex > size || startIndex > endIndex) {
+            throw new IndexOutOfBoundsException("Slice indices [" + startIndex + ", " + endIndex + ") are out of bounds for Series of size " + size);
+        }
+        int newSize = endIndex - startIndex;
+        return new Series<>(newSize, i -> provider.apply(startIndex + i));
+    }
+
+    public <R> Series<R> map(Function<? super T, ? extends R> mapper) {
+        Objects.requireNonNull(mapper, "Mapper function must not be null.");
+        return new Series<>(size, i -> mapper.apply(provider.apply(i)));
+    }
+
+    public Series<T> filter(Predicate<? super T> predicate) {
+        Objects.requireNonNull(predicate, "Predicate must not be null.");
+        List<T> materializedFilteredList = new ArrayList<>();
+        for (int i = 0; i < size; i++) {
+            T element = provider.apply(i);
+            if (predicate.test(element)) {
+                materializedFilteredList.add(element);
+            }
+        }
+        return new Series<>(materializedFilteredList.size(), materializedFilteredList::get);
+    }
+    // Will add plus, minus, and stream later.
+```
+*(Run tests -> All green)*
