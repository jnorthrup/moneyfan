+        /**
+         * identifying string
+         */
+
+
+        /**
+         * This class should only be accessd via Factory.
+         */
+        //		Power() {
+        //		// no-op
+        //		}
+        /**
+         * Not used, returns 0.
+         */
+        override fun invoke(input: Double ): Double = input * input
+
+        /**
+         * Return first input raised to the power of the absolute value of the
+         * second input (or just first input if no second input).
+         */
+        override fun apply(input: DoubleArray, bias: Double ): Double {
+            if (input.size < 2) {
+                return input[0]
+            }
+            val v = input[0].pow(abs(input[1]))
+            if (java.lang.Double .isNaN(v)) {
+                return 0.0
+            }
+            return if (java.lang.Double .isInfinite(v)) {
+                if (v < 0) -Double .MAX_VALUE / 2 else Double .MAX_VALUE / 2
+            } else v
+        }
+
+        /**
+        getMaxValue
+         */
+        override fun getMaxValue(): Double = Double .MAX_VALUE
+
+        /**
+        getMinValue
+         */
+        override fun getMinValue(): Double = -Double .MAX_VALUE
+
+        /**
+        cost
+         */
+        override fun cost(): Long = 75
+    },
+
+    /**
+     * Reciprocal function (inverse).
+     *
+     * @author Oliver Coleman
+     */
+    Recipriocal /*implements , DifferentiableFunction */ {
+        /**
+         * identifying string
+         */
+
+
+        /**
+         * This class should only be accessd via Factory.
+         */
+        //		Recipriocal() {
+        //		// no-op
+        //		}
+        /**
+        apply
+         */
+        override fun invoke(input: Double ): Double {
+            var `val` = 1f / input
+            if (java.lang.Double .isNaN(`val`)) {
+                return if (input < 0.0) getMinValue() else getMaxValue()
+            }
+            if (`val` < getMinValue()) {
+                `val` = getMinValue()
+            } else if (`val` > getMaxValue()) {
+                `val` = getMaxValue()
+            }
+            return `val`
+        }
+
+        override fun applyDiff(x: Double ): Double {
+            val `val` = -1 / (x * x)
+            return if (java.lang.Double .isNaN(`val`)) {
+                getMinValue()
+            } else `val`
+        }
+
+        /**
+        getMaxValue
+         */
+        override fun getMaxValue(): Double = Double .MAX_VALUE * 0.1f
+
+        /**
+        getMinValue
+         */
+        override fun getMinValue(): Double = -getMaxValue()
+
+        /**
+        cost
+         */
+        override fun cost(): Long = 75
+    },  /*
