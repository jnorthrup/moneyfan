+**`bikeshed/src/main/java/com/yourdomain/bikeshed/cursor/RowVec.java`**
+(Represents a row of data with associated metadata.)
+
+```java
+package com.yourdomain.bikeshed.cursor;
+
+import com.yourdomain.bikeshed.core.Join;
+import com.yourdomain.bikeshed.core.Series;
+
+import java.util.Objects;
+import java.util.function.Function;
+
+/**
+ * Represents a row of data as a {@link Series} of value-metadata pairs.
+ * Each element in the Series is a {@code Join<Object, Function<Void, ColumnMeta>>},
+ * where the function provides the column's metadata lazily.
+ *
+ * Type alias equivalent: {@code typealias RowVec = Series<Join<Object, Function<Void, ColumnMeta>>>}
+ */
+public interface RowVec extends Series<Join<Object, Function<Void, ColumnMeta>>> {
+
+    /**
+     * Factory method for creating a RowVec.
+     * @param size The number of columns in the row.
+     * @param provider A function providing the value-metadata Join for each column.
+     * @return A new RowVec instance.
+     */
+    static RowVec of(int size, IntFunction<Join<Object, Function<Void, ColumnMeta>>> provider) {
+        return new ImmutableRowVec(size, provider);
+    }
+
+    /**
+     * Returns the value at a given column index.
+     * @param columnIndex The index of the column.
+     * @return The value at that column.
+     */
+    default Object getValue(int columnIndex) {
+        return get(columnIndex).first();
+    }
+
+    /**
+     * Returns the ColumnMeta for a given column index.
+     * @param columnIndex The index of the column.
+     * @return The ColumnMeta for that column.
+     */
+    default ColumnMeta getColumnMeta(int columnIndex) {
+        return get(columnIndex).second().apply(null); // Apply void function to get ColumnMeta
+    }
+
+    // Immutable concrete implementation
+    record ImmutableRowVec(Integer first, IntFunction<Join<Object, Function<Void, ColumnMeta>>> second) implements RowVec {
+        @Override
+        public String toString() {
+            // Limited toString for brevity
+            StringBuilder sb = new StringBuilder("RowVec[");
+            for (int i = 0; i < Math.min(first, 5); i++) { // Show first 5 columns
+                if (i > 0) sb.append(", ");
+                sb.append(get(i).first()).append(" (").append(get(i).second().apply(null).name()).append(")");
+            }
+            if (first > 5) sb.append(", ...");
+            sb.append("]");
+            return sb.toString();
+        }
+
+        @Override
+        public boolean equals(Object o) {
+            if (this == o) return true;
+            if (o == null || getClass() != o.getClass()) return false;
+            ImmutableRowVec that = (ImmutableRowVec) o;
+            if (!Objects.equals(first, that.first)) return false;
+            if (first == 0) return true;
+            for (int i = 0; i < first; i++) {
+                if (!Objects.equals(second.apply(i), that.second.apply(i))) {
+                    return false;
+                }
+            }
+            return true;
+        }
+
+        @Override
+        public int hashCode() {
+            int result = Objects.hash(first);
+            for (int i = 0; i < Math.min(first, 5); i++) {
+                result = 31 * result + Objects.hashCode(second.apply(i));
+            }
+            return result;
+        }
+    }
+}
+```
