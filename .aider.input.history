+**`bikeshed/src/main/java/com/yourdomain/bikeshed/isam/meta/IOMemento.java`**
+
+```java
+package com.yourdomain.bikeshed.isam.meta;
+
+import com.yourdomain.bikeshed.cursor.TypeMemento;
+import com.yourdomain.bikeshed.core.Series;
+
+import java.nio.ByteBuffer;
+import java.nio.charset.StandardCharsets;
+import java.time.Instant;
+import java.time.LocalDate;
+import java.time.ZoneOffset;
+import java.time.temporal.ChronoUnit;
+import java.util.function.Function;
+
+/**
+ * Defines various I/O and serialization strategies for different data types.
+ * Each enum entry specifies its fixed {@code networkSize} in bytes, where applicable.
+ * For variable-length types (like `IoString`), {@code networkSize} is {@code null},
+ * and their length must be externally managed (e.g., via a map in `IsamMetaFileReader.write`).
+ */
+public enum IOMemento implements TypeMemento {
+    IoBoolean(1),
+    IoByte(1),
+    IoUByte(1), // Represented as byte in Java, but conceptually unsigned
+    IoShort(2),
+    IoUShort(2), // Represented as short in Java, but conceptually unsigned
+    IoInt(4),
+    IoUInt(4), // Represented as int in Java, but conceptually unsigned
+    IoLong(8),
+    IoULong(8), // Represented as long in Java, but conceptually unsigned
+    IoFloat(4),
+    IoDouble(8),
+    IoLocalDate(8), // Storing epoch days as long (long days since 1970-01-01)
+    IoInstant(12), // Storing epoch seconds (long) and nanoseconds (int)
+    IoString(null), // Variable length, networkSize is null
+    IoCharSeries(null), // Variable length, networkSize is null
+    IoByteArray(null), // Variable length, networkSize is null
+    IoNothing(0); // For null/empty fields, takes 0 bytes
+
+    private final Integer networkSize;
+
+    IOMemento(Integer networkSize) {
+        this.networkSize = networkSize;
+    }
+
+    @Override
+    public Integer getNetworkSize() {
+        return networkSize;
+    }
+
+    // --- Encoder/Decoder Factories ---
+
+    /**
+     * Creates a function to encode an object of this type into a byte array.
+     *
+     * @param expectedSize The expected size of the byte array (relevant for fixed-size types,
+     *                     or as a hint for variable-size types).
+     * @return A {@code Function} that converts an object to a {@code byte[]}.
+     */
+    public Function<Object, byte[]> createEncoder(int expectedSize) {
+        // PlatformCodec ensures correct endianness
+        PlatformCodec codec = PlatformCodec.currentPlatformCodec.INSTANCE;
+        switch (this) {
+            case IoBoolean: return value -> new byte[]{(byte) ((Boolean) value ? 1 : 0)};
+            case IoByte:    return value -> new byte[]{(Byte) value};
+            case IoUByte:   return value -> new byte[]{(Byte) value}; // Assuming UByte is a Byte
+            case IoShort:   return value -> codec.writeShort((Short) value);
+            case IoUShort:  return value -> codec.writeUShort((Integer) value); // Assuming UShort is an int
+            case IoInt:     return value -> codec.writeInt((Integer) value);
+            case IoUInt:    return value -> codec.writeUInt((Integer) value); // Assuming UInt is an int
+            case IoLong:    return value -> codec.writeLong((Long) value);
+            case IoULong:   return value -> codec.writeULong((Long) value); // Assuming ULong is a long
+            case IoFloat:   return value -> codec.writeFloat((Float) value);
+            case IoDouble:  return value -> codec.writeDouble((Double) value);
+            case IoLocalDate:
+                return value -> {
+                    LocalDate date = (LocalDate) value;
+                    return codec.writeLong(date.toEpochDay());
+                };
+            case IoInstant:
+                return value -> {
+                    Instant instant = (Instant) value;
+                    byte[] secondsBytes = codec.writeLong(instant.getEpochSecond());
+                    byte[] nanosBytes = codec.writeInt(instant.getNano());
+                    ByteBuffer buffer = ByteBuffer.allocate(12);
+                    buffer.put(secondsBytes).put(nanosBytes);
+                    return buffer.array();
+                };
+            case IoString:
+                return value -> {
+                    byte[] bytes = ((String) value).getBytes(StandardCharsets.UTF_8);
+                    // Pad or truncate to expectedSize if fixed-length string is desired,
+                    // otherwise return raw bytes (length must be handled by caller)
+                    if (networkSize != null) {
+                        byte[] fixedBytes = new byte[expectedSize];
+                        System.arraycopy(bytes, 0, fixedBytes, 0, Math.min(bytes.length, expectedSize));
+                        return fixedBytes;
+                    }
+                    return bytes;
+                };
+            case IoCharSeries: // Assuming Series<Char> can be converted to String then bytes
+                return value -> ((Series<Character>) value).toList().stream()
+                        .map(String::valueOf).collect(Collectors.joining(""))
+                        .getBytes(StandardCharsets.UTF_8);
+            case IoByteArray: return value -> (byte[]) value;
+            case IoNothing: return value -> new byte[0];
+            default:        throw new IllegalArgumentException("Unsupported type: " + this);
+        }
+    }
+
+    /**
+     * Creates a function to decode a byte array into an object of this type.
+     *
+     * @param expectedSize The expected size of the byte array to decode.
+     * @return A {@code Function} that converts a {@code byte[]} to an object.
+     */
+    public Function<byte[], Object> createDecoder(int expectedSize) {
+        PlatformCodec codec = PlatformCodec.currentPlatformCodec.INSTANCE;
+        switch (this) {
+            case IoBoolean: return bytes -> bytes[0] == 1;
+            case IoByte:    return bytes -> bytes[0];
+            case IoUByte:   return bytes -> (byte) (bytes[0] & 0xFF); // Returning as byte for Java, caller to cast/interpret
+            case IoShort:   return bytes -> codec.readShort(bytes);
+            case IoUShort:  return bytes -> codec.readUShort(bytes); // Returning as int for Java
+            case IoInt:     return bytes -> codec.readInt(bytes);
+            case IoUInt:    return bytes -> codec.readUInt(bytes); // Returning as int for Java
+            case IoLong:    return bytes -> codec.readLong(bytes);
+            case IoULong:   return bytes -> codec.readULong(bytes); // Returning as long for Java
+            case IoFloat:   return bytes -> codec.readFloat(bytes);
+            case IoDouble:  return bytes -> codec.readDouble(bytes);
+            case IoLocalDate:
+                return bytes -> LocalDate.ofEpochDay(codec.readLong(bytes));
+            case IoInstant:
+                return bytes -> {
+                    ByteBuffer buffer = ByteBuffer.wrap(bytes);
+                    long epochSeconds = codec.readLong(new byte[]{
+                            buffer.get(), buffer.get(), buffer.get(), buffer.get(),
+                            buffer.get(), buffer.get(), buffer.get(), buffer.get()
+                    });
+                    int nanoAdjustment = codec.readInt(new byte[]{
+                            buffer.get(), buffer.get(), buffer.get(), buffer.get()
+                    });
+                    return Instant.ofEpochSecond(epochSeconds, nanoAdjustment);
+                };
+            case IoString:  return bytes -> new String(bytes, StandardCharsets.UTF_8);
+            case IoCharSeries:
+                return bytes -> {
+                    String str = new String(bytes, StandardCharsets.UTF_8);
+                    // Create a Series<Character> from the string
+                    return Series.of(str.length(), str::charAt);
+                };
+            case IoByteArray: return bytes -> bytes;
+            case IoNothing: return bytes -> null;
+            default:        throw new IllegalArgumentException("Unsupported type: " + this);
+        }
+    }
+}
+```
