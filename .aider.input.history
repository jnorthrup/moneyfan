+`bikeshed/src/main/java/com/yourdomain/bikeshed/isam/IsamMetaFileReader.java`
+```java
+package com.yourdomain.bikeshed.isam;
+
+import com.yourdomain.bikeshed.core.Series;
+import com.yourdomain.bikeshed.types.ColumnMeta;
+import com.yourdomain.bikeshed.types.IOMemento;
+import java.util.List;
+import java.util.Map;
+import java.util.Objects;
+
+public interface IsamMetaFileReader {
+    String getMetafileFilename();
+    int getRecordLength();
+    Series<ColumnMeta> getConstraints();
+
+    void open();
+    void close();
+
+    static Series<ColumnMeta> write(String metafilename, Series<ColumnMeta> columnMetas, Map<String, Integer> varChars) {
+        Objects.requireNonNull(metafilename, "metafileFilename must not be null"); Objects.requireNonNull(columnMetas, "columnMetas must not be null"); Objects.requireNonNull(varChars, "varChars map must not be null");
+        System.out.println("ISAM Meta Write: Writing metadata to " + metafilename); System.out.println("  (This process ensures ISAM data file alignment for zero-copy mmap)");
+        int currentOffset = 0; List<ColumnMeta> calculatedMetas = new java.util.ArrayList<>();
+        for (ColumnMeta cm : columnMetas) {
+            Integer fixedSize = ((IOMemento) cm.type()).getNetworkSize(); int length;
+            if (fixedSize != null) { length = fixedSize; } else { length = varChars.getOrDefault(cm.name(), 255); if (length <= 0) throw new IllegalArgumentException("Length for variable-length field '" + cm.name() + "' must be positive."); }
+            System.out.println(String.format("  Column: %s, Type: %s, Bytes: %d, Offset: %d-%d", cm.name(), cm.type().name(), length, currentOffset, currentOffset + length));
+            calculatedMetas.add(ColumnMeta.of(cm.name(), cm.type())); currentOffset += length;
+        }
+        int totalRecordLength = currentOffset; System.out.println("  Total record length calculated: " + totalRecordLength + " bytes.");
+        return Series.of(calculatedMetas.size(), calculatedMetas::get);
+    }
+}
