+=== ../mp-superproject/bfneat/src/main/java/pairwise/idiom/neat/Gnome.kt ===
+============================================================================
+@file:Suppress("NOTHING_TO_INLINE")
+
+package pairwise.idiom.neat
+
+
+import pairwise.idiom.neat.Environment.Companion.sim
+import vec.macros.*
+import vec.util.assertionsEnableDebug
+import vec.util.debug
+import java.util.*
+import kotlin.math.min
+import kotlin.math.roundToInt
+import java.util.concurrent.ThreadLocalRandom.current as RNG
+
+open class Gnome @JvmOverloads constructor(
+    @JvmField var jeans: Array<Jean> = Array(sim.HIDDEN + sim.OUTPUTS) { x: Int ->
+        val hFirst = sim.indirectHiddenRange.first
+        Jean(when {
+            x + hFirst in sim.indirectOutputRange -> ActivationFunction.Linear
+            else -> ActivationFunction.cached.random()
+        }, empty)
+    }.apply {
+        val clusterSize = min(1.0, sim.CONN_DENSITY * sim.HIDDEN.toDouble()).roundToInt()
+        outputCluster(clusterSize, this)
+
+
+        },
+        @JvmField var impulse: DoubleArray = DoubleArray(jeanRange.count()),
+) {
+    constructor(parent: Gnome) : this(parent.jeans.clone(), impulse = parent.impulse.clone())
+
+    var points: Double = Double.NEGATIVE_INFINITY
+
+    fun backtrace(jx: Int, singleStep: Boolean = false): Set<Int> {
+        val bag = mutableSetOf<Int>(jx)
+        var addl: MutableSet<Int>? = null
+        val blast: Int = sim.biasRange.last
+        do {
+            if (addl == null) addl = bag
+            val tmp = mutableSetOf<Int>()
+            for (jx in addl)
+                tmp += jeans[jx].inputs.filter { it > blast }
+            tmp -= bag
+            addl = tmp
+            bag += addl
+        } while (addl!!.isNotEmpty() && !singleStep)
+        return bag
+    }
+
+    val outputs get() = jeans[sim.HIDDEN until sim.HIDDEN+ sim.OUTPUTS].toList()
+    fun relevancy(qty: Int): SortedMap<Int, MutableSet<Int>> {
+        val master = sortedMapOf<Int, MutableSet<Int>>()
+        (0 until qty).forEach { jx ->
+            jeans[jx].inputs.forEach { ix ->
+                master.getOrPut(ix) { mutableSetOf() } += jx + sim.indirectHiddenRange.first
+            }
+        }
+
+        //set up prune loop
+        var dead = mutableSetOf<Int>()
+        do {
+            master.keys.removeAll(dead)
+            dead.clear()
+
+            //eliminate irrelevant keys to nowhere
+            master.forEach { (k, v) ->
+                if (v.none { it in sim.indirectOutputRange || it in master.keys }) dead += k
+            }
+
+            //eliminate orphan hidden nodes
+            val v: Set<Int> = master.values.flatMap { it }.toSet()
+            dead += master.subMap(sim.indirectHiddenRange).keys.filterNot { it in v }
+
+        } while (dead.isNotEmpty())
+        return master
+    }
+
+    var pruned: IntArray? = null
+        get() = field ?: run {
+            val relevancy = relevancy(sim.HIDDEN + sim.OUTPUTS)
+            (relevancy.subMap(sim.indirectHiddenRange).keys α { it: Int -> it - sim.indirectHiddenRange.first }).toIntArray()
+        }.also { pr ->
+            field = pr
+            (0 until jeans.size).filter { it: Int -> it !in pr }.forEach { it: Int ->
+                jeans[it].inputs = IntArray(0)
+            }
+        }
+
+    @Transient
+    var complexity: Int? = null
+        get() {
+            val pruned1 = pruned!!
+            val pai2 = jeans[pruned1]
+            val jeans1 = pai2.`➤`
+            debug { }
+            return field ?: jeans1.sumOf { it: Jean ->
+                val size = it.inputs.size
+                size
+            }.also { field = it }
+        }
+
+
+    fun procreate(mate: Gnome): Gnome {
+        val jeans1 = Array(jeanRange.count()) { i: Int -> Jean(spinBottle(this, mate).jeans[i].clone()) }
+        return Gnome(jeans1)
+    }
+
+    override fun toString(): String = "Gnome(points=$points, jeans=${jeans.toList()}"
+
+    companion object {
+        inline fun spinBottle(g1: Gnome, g2: Gnome): Gnome = if (RNG().nextBoolean()) g1 else g2
+
+        @JvmField
+        val jeanRange = 0 until (sim.HIDDEN + sim.OUTPUTS)
+
+        @JvmField
+        val jeanOutputRange = sim.HIDDEN until sim.HIDDEN + sim.OUTPUTS
+
+        public val empty: IntArray = IntArray(0)
+        val hFirst = sim.indirectHiddenRange.first
+
+    }
+}
+
+fun outputCluster(clusterSize: Int, j0: Array<Jean>) {
+    val range = sim.indirectOutputRange
+    for (o0 in range) {
+        val h1 = RNG().nextInt(sim.indirectHiddenRange) - Gnome.hFirst
+        hiddenCluster(clusterSize, j0, h1).debug {
+            j0[h1]
+            assertionsEnableDebug
+        }
+        val i = o0 - Gnome.hFirst
+        j0[i].addInput(h1 + Gnome.hFirst).debug {
+
+              j0[i]
+            assertionsEnableDebug
+        }
+    }
+}
+
+fun hiddenCluster(clusterSize: Int, j0: Array<Jean>, h1: Int) {
+    repeat(clusterSize) {
+        val ji1 = inputCluster(clusterSize, j0)
+        j0[h1].addInput(ji1 + Gnome.hFirst)
+    }
+}
+
+fun inputCluster(clusterSize: Int, j0: Array<Jean>): Int {
+    val ji1 = RNG().nextInt(sim.indirectHiddenRange) - Gnome.hFirst
+    repeat(clusterSize) { j0[ji1].addInput(RNG().nextInt(sim.biasRange.last)) }
+    return ji1
+}
+
