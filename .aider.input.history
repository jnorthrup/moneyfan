+**`bikeshed/src/main/java/com/yourdomain/bikeshed/cursor/Cursor.java`**
+
+```java
+package com.yourdomain.bikeshed.cursor;
+
+import com.yourdomain.bikeshed.core.Series;
+import com.yourdomain.bikeshed.core.Join;
+import com.yourdomain.bikeshed.isam.meta.IOMemento;
+
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.List;
+import java.util.NoSuchElementException;
+import java.util.function.Function;
+import java.util.stream.Collectors;
+import java.util.stream.IntStream;
+
+/**
+ * Represents a tabular data structure (a collection of rows), where each row is a {@link RowVec}.
+ * Conceptually, it's a {@code Series<RowVec>}, providing a columnar abstraction over underlying data.
+ * This is the primary interface for tabular data manipulation within the DSEL.
+ *
+ * Immutability is maintained through compositional operations.
+ */
+public interface Cursor extends Series<RowVec> {
+
+    /**
+     * Factory method to create a Cursor instance.
+     *
+     * @param size     The number of rows in the cursor.
+     * @param provider A function that provides a {@code RowVec} for a given row index.
+     * @return A new `Cursor` instance.
+     */
+    static Cursor of(int size, IntFunction<RowVec> provider) {
+        return new CursorImpl(size, provider);
+    }
+
+    /**
+     * Internal implementation of `Cursor`.
+     */
+    class CursorImpl extends Series.ImmutableSeries<RowVec> implements Cursor {
+        private CursorImpl(int size, IntFunction<RowVec> provider) {
+            super(size, provider);
+        }
+    }
+
+    /**
+     * Gets a specific row from the cursor.
+     * Glyph: `at` (for accessing at an index) or `row`
+     *
+     * @param rowIndex The index of the row.
+     * @return The {@link RowVec} at the specified index.
+     */
+    default RowVec row(int rowIndex) {
+        // Use ternary operator for concise conditional logic
+        return rowIndex < 0 ? get(size() + rowIndex) : get(rowIndex);
+    }
+
+    /**
+     * Retrieves the {@link ColumnMeta} for all columns in the cursor.
+     * This is typically derived from the first row's metadata suppliers.
+     *
+     * @return A {@code Series<ColumnMeta>} representing the schema.
+     * @throws IllegalStateException if the cursor is empty and metadata cannot be determined.
+     */
+    default Series<ColumnMeta> getMeta() {
+        if (size() == 0) {
+            throw new IllegalStateException("Cannot get metadata from an empty cursor.");
+        }
+        RowVec firstRow = row(0);
+        return firstRow.right().map(Supplier::get);
+    }
+
+    /**
+     * Selects a subset of columns by their indices.
+     *
+     * @param columnIndices An array of integer indices specifying which columns to include.
+     * @return A new {@code Cursor} containing only the selected columns.
+     */
+    default Cursor get(int... columnIndices) {
+        if (size() == 0) return Cursor.of(0, i -> RowVec.of(0, j -> null)); // Return empty cursor if input is empty
+
+        // Get the metadata for the first row to determine column count
+        int originalColumnCount = row(0).size();
+
+        // Validate indices
+        for (int idx : columnIndices) {
+            if (idx < 0 || idx >= originalColumnCount) {
+                throw new IndexOutOfBoundsException("Column index " + idx + " out of bounds for " + originalColumnCount + " columns.");
+            }
+        }
+
+        return Cursor.of(size(), rowIndex -> {
+            RowVec originalRow = row(rowIndex);
+            return RowVec.of(columnIndices.length, colIndex -> originalRow.get(columnIndices[colIndex]));
+        });
+    }
+
+    /**
+     * Selects a subset of columns by their names.
+     *
+     * @param columnNames An array of strings specifying which columns to include.
+     * @return A new {@code Cursor} containing only the selected columns.
+     * @throws IllegalArgumentException if any specified column name is not found.
+     */
+    default Cursor get(String... columnNames) {
+        if (size() == 0) return Cursor.of(0, i -> RowVec.of(0, j -> null));
+
+        Series<ColumnMeta> meta = getMeta();
+        List<Integer> indices = new ArrayList<>();
+        for (String name : columnNames) {
+            boolean found = false;
+            for (int i = 0; i < meta.size(); i++) {
+                if (meta.get(i).getName().equals(name)) {
+                    indices.add(i);
+                    found = true;
+                    break;
+                }
+            }
+            if (!found) {
+                throw new IllegalArgumentException("Column '" + name + "' not found in cursor.");
+            }
+        }
+        return get(indices.stream().mapToInt(Integer::intValue).toArray());
+    }
+
+    /**
+     * Excludes columns by their names from the cursor.
+     *
+     * @param columnsToExclude An array of strings specifying which columns to exclude.
+     * @return A new {@code Cursor} without the excluded columns.
+     */
+    default Cursor minus(String... columnsToExclude) {
+        if (size() == 0) return Cursor.of(0, i -> RowVec.of(0, j -> null));
+
+        Series<ColumnMeta> meta = getMeta();
+        List<String> namesToKeep = new ArrayList<>();
+        List<String> excludeList = Arrays.asList(columnsToExclude);
+
+        for (int i = 0; i < meta.size(); i++) {
+            if (!excludeList.contains(meta.get(i).getName())) {
+                namesToKeep.add(meta.get(i).getName());
+            }
+        }
+        return get(namesToKeep.toArray(new String[0]));
+    }
+
+
+    /**
+     * Provides a columnar view where each column is returned as a {@code Series<Object>}.
+     * Glyph: `↓` (down arrow for columnar view)
+     *
+     * @return A {@code Series} of {@code Series<Object>}, representing columns.
+     */
+    default Series<Series<Object>> toColumns() {
+        if (size() == 0) return Series.of(0, i -> Series.of(0, j -> null));
+
+        int numColumns = row(0).size();
+        return Series.of(numColumns, colIndex -> this.map(row -> row.left().get(colIndex)));
+    }
+
+
+    /**
+     * Checks if all columns in the cursor are of numerical types (Byte, Short, Int, Long, Float, Double).
+     *
+     * @return `true` if all columns are numerical, `false` otherwise.
+     */
+    default boolean isNumerical() {
+        if (size() == 0) return true; // Empty cursor is vacuously numerical
+        Series<ColumnMeta> meta = getMeta();
+        for (int i = 0; i < meta.size(); i++) {
+            IOMemento type = (IOMemento) meta.get(i).getType(); // Cast is safe if IOMemento is the only TypeMemento impl
+            switch (type) {
+                case IoByte:
+                case IoUByte:
+                case IoShort:
+                case IoUShort:
+                case IoInt:
+                case IoUInt:
+                case IoLong:
+                case IoULong:
+                case IoFloat:
+                case IoDouble:
+                    // These are numerical types
+                    break;
+                default:
+                    return false; // Found a non-numerical type
+            }
+        }
+        return true;
+    }
+
+    /**
+     * Checks if all columns in the cursor have the same {@link IOMemento} type.
+     *
+     * @return `true` if all columns are of the same type, `false` otherwise.
+     */
+    default boolean isHomoMorphic() {
+        if (size() == 0) return true;
+        Series<ColumnMeta> meta = getMeta();
+        if (meta.size() == 0) return true;
+
+        IOMemento firstType = (IOMemento) meta.get(0).getType();
+        for (int i = 1; i < meta.size(); i++) {
+            if (meta.get(i).getType() != firstType) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    /**
+     * Prints the first few rows of the cursor to standard output, including headers.
+     *
+     * @param numRows The number of rows to print (default is 5).
+     */
+    default void head(int numRows) {
+        System.out.println("--- Cursor Head (First " + numRows + " Rows) ---");
+        if (size() == 0) {
+            System.out.println("[Empty Cursor]");
+            return;
+        }
+
+        Series<ColumnMeta> meta = getMeta();
+        String headerLine = meta.map(ColumnMeta::getName).toList().stream()
+                .map(s -> String.format("%-15s", s)) // Adjust padding as needed
+                .collect(Collectors.joining(" | "));
+        System.out.println(headerLine);
+        System.out.println(String.join("", Collections.nCopies(headerLine.length(), "-")));
+
+        int rowsToPrint = Math.min(numRows, size());
+        for (int r = 0; r < rowsToPrint; r++) {
+            RowVec row = row(r);
+            String dataLine = row.left().toList().stream()
+                    .map(o -> String.format("%-15s", (o != null ? o.toString() : "null")))
+                    .collect(Collectors.joining(" | "));
+            System.out.println(dataLine);
+        }
+        if (size() > numRows) {
+            System.out.println("... (" + (size() - numRows) + " more rows)");
+        }
+        System.out.println("----------------------------------");
+    }
+
+    /**
+     * Prints a random subset of rows from the cursor to standard output.
+     *
+     * @param numRows The number of random rows to print.
+     */
+    default void showRandom(int numRows) {
+        if (size() == 0) {
+            System.out.println("[Empty Cursor]");
+            return;
+        }
+
+        System.out.println("--- Cursor Random Rows (Showing " + numRows + " of " + size() + ") ---");
+        Series<ColumnMeta> meta = getMeta();
+        String headerLine = meta.map(ColumnMeta::getName).toList().stream()
+                .map(s -> String.format("%-15s", s)) // Adjust padding as needed
+                .collect(Collectors.joining(" | "));
+        System.out.println(headerLine);
+        System.out.println(String.join("", Collections.nCopies(headerLine.length(), "-")));
+
+        List<Integer> randomIndices = new ArrayList<>();
+        java.util.Random random = new java.util.Random();
+        IntStream.range(0, Math.min(numRows, size()))
+                .forEach(i -> randomIndices.add(random.nextInt(size())));
+        Collections.sort(randomIndices); // Sort to avoid random access issues with some underlying implementations
+
+        for (int rIndex : randomIndices) {
+            RowVec row = row(rIndex);
+            String dataLine = row.left().toList().stream()
+                    .map(o -> String.format("%-15s", (o != null ? o.toString() : "null")))
+                    .collect(Collectors.joining(" | "));
+            System.out.println(dataLine + " (Row " + rIndex + ")");
+        }
+        System.out.println("----------------------------------");
+    }
+}
+```
