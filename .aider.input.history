+**5. `bikeshed` Java Source Code**
+
+**`bikeshed/src/main/java/com/yourdomain/bikeshed/core/Join.java`**
+(The immutable 2-tuple primitive. `Pair` equivalent.)
+
+```java
+package com.yourdomain.bikeshed.core;
+
+import java.util.Objects;
+import java.util.function.BiFunction;
+import java.util.function.Function;
+
+/**
+ * The foundational immutable 2-tuple primitive of the DSEL.
+ * All operations on Join or its derived types must be compositional.
+ *
+ * @param <F> Type of the first element.
+ * @param <S> Type of the second element.
+ */
+public interface Join<F, S> {
+    F first();
+    S second();
+
+    /**
+     * Factory method for creating a Join instance.
+     * Glyphs: `of`, `jn` (from D.java)
+     * @param f The first element.
+     * @param s The second element.
+     * @param <F> Type of the first element.
+     * @param <S> Type of the second element.
+     * @return An immutable Join instance.
+     */
+    static <F, S> Join<F, S> of(F f, S s) {
+        return new ImmutableJoin<>(f, s);
+    }
+
+    /**
+     * Applies a function to the first element, producing a new Join.
+     * Glyph: `mapFst`
+     * @param mapper The function to apply to the first element.
+     * @param <R> The new type of the first element.
+     * @return A new Join with the transformed first element.
+     */
+    default <R> Join<R, S> mapFst(Function<? super F, ? extends R> mapper) {
+        Objects.requireNonNull(mapper);
+        return of(mapper.apply(first()), second());
+    }
+
+    /**
+     * Applies a function to the second element, producing a new Join.
+     * Glyph: `mapSnd`
+     * @param mapper The function to apply to the second element.
+     * @param <R> The new type of the second element.
+     * @return A new Join with the transformed second element.
+     */
+    default <R> Join<F, R> mapSnd(Function<? super S, ? extends R> mapper) {
+        Objects.requireNonNull(mapper);
+        return of(first(), mapper.apply(second()));
+    }
+
+    /**
+     * Applies a function to both elements, producing a new Join.
+     * Glyph: `mapBoth`
+     * @param mapper The function to apply to both elements.
+     * @param <R1> The new type of the first element.
+     * @param <R2> The new type of the second element.
+     * @return A new Join with both elements transformed.
+     */
+    default <R1, R2> Join<R1, R2> mapBoth(BiFunction<? super F, ? super S, ? extends Join<R1, R2>> mapper) {
+        Objects.requireNonNull(mapper);
+        return mapper.apply(first(), second());
+    }
+
+    /**
+     * Swaps the first and second elements, producing a new Join.
+     * Glyph: `swap`
+     * @return A new Join with elements swapped.
+     */
+    default Join<S, F> swap() {
+        return of(second(), first());
+    }
+
+    // Concrete immutable implementation as a record
+    record ImmutableJoin<F, S>(F first, S second) implements Join<F, S> {
+        @Override
+        public boolean equals(Object o) {
+            if (this == o) return true;
+            if (o == null || getClass() != o.getClass()) return false;
+            ImmutableJoin<?, ?> that = (ImmutableJoin<?, ?>) o;
+            return Objects.equals(first, that.first) &&
+                   Objects.equals(second, that.second);
+        }
+
+        @Override
+        public int hashCode() {
+            return Objects.hash(first, second);
+        }
+
+        @Override
+        public String toString() {
+            return "(" + first + ", " + second + ")";
+        }
+    }
+}
+```
+
+**`bikeshed/src/main/java/com/yourdomain/bikeshed/core/Series.java`**
+(A cursor-based collection, replacing List-based workflows.)
+
+```java
+package com.yourdomain.bikeshed.core;
+
+import java.util.AbstractList;
+import java.util.Iterator;
+import java.util.Objects;
+import java.util.function.Function;
+import java.util.function.IntFunction;
+import java.util.function.Predicate;
+import java.util.stream.IntStream;
+
+/**
+ * A cursor-based collection, representing a sequence of elements accessed by index.
+ * Implemented as a {@code Join<Integer, IntFunction<T>>}, where the first element
+ * is the size and the second is a function providing elements by index.
+ * This promotes lazy evaluation and efficient memory-mapped file access.
+ *
+ * @param <T> The type of elements in the series.
+ */
+public interface Series<T> extends Join<Integer, IntFunction<T>>, Iterable<T> {
+
+    /**
+     * Factory method for creating a Series.
+     * Glyph: `of`, `sr` (from D.java)
+     *
+     * @param size The number of elements in the series.
+     * @param provider A function that provides an element given its index.
+     * @param <T> The type of elements.
+     * @return A new Series instance.
+     */
+    static <T> Series<T> of(int size, IntFunction<T> provider) {
+        return new ImmutableSeries<>(size, provider);
+    }
+
+    /**
+     * Returns the element at the specified index.
+     * Glyph: `get(index)`
+     *
+     * @param index The index of the element to return.
+     * @return The element at the specified index.
+     * @throws IndexOutOfBoundsException if the index is out of range.
+     */
+    default T get(int index) {
+        if (index < 0 || index >= size()) {
+            throw new IndexOutOfBoundsException("Index " + index + " out of bounds for size " + size());
+        }
+        return provider().apply(index);
+    }
+
+    /**
+     * Returns the size (number of elements) in this series.
+     * Glyph: `size()`
+     * @return The size of the series.
+     */
+    default int size() {
+        return first();
+    }
+
+    /**
+     * Returns the provider function for this series.
+     * @return The IntFunction providing elements.
+     */
+    default IntFunction<T> provider() {
+        return second();
+    }
+
+    /**
+     * Returns a new Series containing elements from this series within the specified range.
+     * This is a compositional operation, creating a new view without copying data.
+     * Glyph: `slice(range)`
+     * @param range The range of indices to include (inclusive start, exclusive end).
+     * @return A new Series representing the slice.
+     * @throws IndexOutOfBoundsException if the range is invalid.
+     */
+    default Series<T> slice(IntRange range) {
+        Objects.requireNonNull(range);
+        int start = range.start();
+        int end = range.end();
+        if (start < 0 || end > size() || start > end) {
+            throw new IndexOutOfBoundsException("Range " + range + " invalid for series of size " + size());
+        }
+        return of(end - start, i -> get(start + i));
+    }
+
+    /**
+     * Returns a new Series by applying a mapping function to each element of this series.
+     * Glyph: `map`, `α` (from D.java)
+     * @param mapper The function to apply to each element.
+     * @param <R> The type of elements in the new series.
+     * @return A new Series with the mapped elements.
+     */
+    default <R> Series<R> map(Function<? super T, ? extends R> mapper) {
+        Objects.requireNonNull(mapper);
+        return of(size(), i -> mapper.apply(get(i)));
+    }
+
+    /**
+     * Returns a new Series containing only the elements that satisfy the given predicate.
+     * This operation may involve iterating and collecting elements.
+     * Glyph: `filter`
+     * @param predicate The predicate to apply to each element.
+     * @return A new Series containing the filtered elements.
+     */
+    default Series<T> filter(Predicate<? super T> predicate) {
+        Objects.requireNonNull(predicate);
+        // For a true lazy filter, we'd need a more complex structure (e.g., a filtered iterator).
+        // For simplicity and immediate utility, we collect to a list and then create a new Series.
+        // This is a trade-off: immutability is preserved, but potential for non-lazy evaluation exists.
+        java.util.List<T> filteredList = new java.util.ArrayList<>();
+        for (int i = 0; i < size(); i++) {
+            T element = get(i);
+            if (predicate.test(element)) {
+                filteredList.add(element);
+            }
+        }
+        return of(filteredList.size(), filteredList::get);
+    }
+
+    /**
+     * Returns an iterator over the elements in this series.
+     * Glyph: `▶` (from D.java)
+     * @return An iterator.
+     */
+    @Override
+    default Iterator<T> iterator() {
+        return new Iterator<T>() {
+            private int currentIndex = 0;
+
+            @Override
+            public boolean hasNext() {
+                return currentIndex < size();
+            }
+
+            @Override
+            public T next() {
+                if (!hasNext()) {
+                    throw new java.util.NoSuchElementException();
+                }
+                return get(currentIndex++);
+            }
+        };
+    }
+
+    /**
+     * Converts this Series to an unmodifiable Java List.
+     * @return A List containing all elements of the Series.
+     */
+    default java.util.List<T> toList() {
+        // This is an eager conversion, potentially costly for very large series.
+        // For true lazy List-like behavior, consider a custom AbstractList implementation.
+        return new AbstractList<T>() {
+            @Override
+            public T get(int index) {
+                return Series.this.get(index);
+            }
+
+            @Override
+            public int size() {
+                return Series.this.size();
+            }
+        };
+    }
+
+    // Concrete immutable implementation as a record
+    record ImmutableSeries<T>(Integer first, IntFunction<T> second) implements Series<T> {
+        @Override
+        public String toString() {
+            // For potentially large series, limit toString to avoid OOM
+            return "Series(size=" + first + ", elements=" +
+                   (first > 10 ? "[" + IntStream.range(0, 5).mapToObj(second).collect(java.util.stream.Collectors.toList()) + ", ...]" :
+                           IntStream.range(0, first).mapToObj(second).collect(java.util.stream.Collectors.toList())) + ")";
+        }
+
+        @Override
+        public boolean equals(Object o) {
+            if (this == o) return true;
+            if (o == null || getClass() != o.getClass()) return false;
+            ImmutableSeries<?> that = (ImmutableSeries<?>) o;
+            // Equality for Series is deep, comparing elements
+            if (!Objects.equals(first, that.first)) return false;
+            if (first == 0) return true; // Both empty
+            // Compare elements eagerly
+            for (int i = 0; i < first; i++) {
+                if (!Objects.equals(second.apply(i), that.second.apply(i))) {
+                    return false;
+                }
+            }
+            return true;
+        }
+
+        @Override
+        public int hashCode() {
+            // HashCode for Series should depend on elements, not just provider instance.
+            // Eagerly compute hash for elements, or implement a lazy hash.
+            int result = Objects.hash(first);
+            for (int i = 0; i < Math.min(first, 100); i++) { // Limit for practical hash
+                result = 31 * result + Objects.hashCode(second.apply(i));
+            }
+            return result;
+        }
+    }
+
+    /**
+     * A simple record to represent an integer range (inclusive start, exclusive end).
+     * Used for `slice` operations.
+     */
+    record IntRange(int start, int end) {
+        public IntRange {
+            if (start < 0 || end < start) {
+                throw new IllegalArgumentException("Invalid range: " + start + ".." + end);
+            }
+        }
+    }
+}
+```
+
+**`bikeshed/src/main/java/com/yourdomain/bikeshed/core/Twin.java`**
+(Specialized `Join` for symmetric pairs.)
+
+```java
+package com.yourdomain.bikeshed.core;
+
+/**
+ * A specialized {@link Join} for symmetric pairs, where both elements are of the same type.
+ * Type alias equivalent: {@code typealias Twin<T> = Join<T, T>}
+ *
+ * @param <T> The type of both elements.
+ */
+public interface Twin<T> extends Join<T, T> {
+
+    /**
+     * Factory method for creating a Twin instance.
+     * Glyph: `Twin.of`, `D.tw`
+     * @param t1 The first element.
+     * @param t2 The second element.
+     * @param <T> The type of both elements.
+     * @return An immutable Twin instance.
+     */
+    static <T> Twin<T> of(T t1, T t2) {
+        return new ImmutableTwin<>(t1, t2);
+    }
+
+    // Concrete immutable implementation as a record
+    record ImmutableTwin<T>(T first, T second) implements Twin<T> {
+        @Override
+        public String toString() {
+            return "Twin(" + first + ", " + second + ")";
+        }
+
+        @Override
+        public boolean equals(Object o) {
+            if (this == o) return true;
+            if (o == null || getClass() != o.getClass()) return false;
+            ImmutableTwin<?> that = (ImmutableTwin<?>) o;
+            return Objects.equals(first, that.first) &&
+                   Objects.equals(second, that.second);
+        }
+
+        @Override
+        public int hashCode() {
+            return Objects.hash(first, second);
+        }
+    }
+}
+```
+
+**`bikeshed/src/main/java/com/yourdomain/bikeshed/dsel/D.java`**
+(The omnibus enum for DSEL operations and "extension functions".)
+
+```java
+package com.yourdomain.bikeshed.dsel;
+
+import com.yourdomain.bikeshed.core.Join;
+import com.yourdomain.bikeshed.core.Series;
+import com.yourdomain.bikeshed.core.Twin;
+
+import java.util.function.Function;
+import java.util.function.IntFunction;
+import java.util.function.Predicate;
+
+/**
+ * {@code D} serves as the omnibus enum for global DSEL operations and extension-like functions.
+ * It provides concise, glyph-based shorthands for common operations on {@link Join} and {@link Series},
+ * promoting a Kotlin-inspired meta-programming style in Java.
+ * All methods are static to mimic extension functions and provide a single entry point for DSEL operations.
+ */
+public enum D {
+    // This enum conceptually acts as a singleton for static methods.
+    // The enum entry itself (e.g., INSTANCE) is often not used directly for stateless utility enums.
+    // We add a placeholder entry to satisfy enum requirements, though it's not strictly necessary for utility enums.
+    INSTANCE;
+
+    /**
+     * Creates a {@link Join} instance.
+     * Glyph: `jn`
+     * @param f The first element.
+     * @param s The second element.
+     * @param <F> Type of the first element.
+     * @param <S> Type of the second element.
+     * @return An immutable Join instance.
+     */
+    public static <F, S> Join<F, S> jn(F f, S s) {
+        return Join.of(f, s);
+    }
+
+    /**
+     * Creates a {@link Twin} instance.
+     * Glyph: `tw`
+     * @param t1 The first element.
+     * @param t2 The second element.
+     * @param <T> Type of both elements.
+     * @return An immutable Twin instance.
+     */
+    public static <T> Twin<T> tw(T t1, T t2) {
+        return Twin.of(t1, t2);
+    }
+
+    /**
+     * Creates a {@link Series} instance.
+     * Glyph: `sr`
+     * @param size The number of elements in the series.
+     * @param provider A function that provides an element given its index.
+     * @param <T> The type of elements.
+     * @return A new Series instance.
+     */
+    public static <T> Series<T> sr(int size, IntFunction<T> provider) {
+        return Series.of(size, provider);
+    }
+
+    // --- Join Operations (Compositional) ---
+
+    /**
+     * Maps the first element of a Join.
+     * Glyph: `mapFst` (from Join interface, but also exposed here for discoverability)
+     * @param join The original Join.
+     * @param mapper The function to apply to the first element.
+     * @param <F> Original type of the first element.
+     * @param <S> Type of the second element.
+     * @param <R> New type of the first element.
+     * @return A new Join with the transformed first element.
+     */
+    public static <F, S, R> Join<R, S> mapFst(Join<F, S> join, Function<? super F, ? extends R> mapper) {
+        return join.mapFst(mapper);
+    }
+
+    /**
+     * Maps the second element of a Join.
+     * Glyph: `mapSnd` (from Join interface, but also exposed here for discoverability)
+     * @param join The original Join.
+     * @param mapper The function to apply to the second element.
+     * @param <F> Type of the first element.
+     * @param <S> Original type of the second element.
+     * @param <R> New type of the second element.
+     * @return A new Join with the transformed second element.
+     */
+    public static <F, S, R> Join<F, R> mapSnd(Join<F, S> join, Function<? super S, ? extends R> mapper) {
+        return join.mapSnd(mapper);
+    }
+
+    /**
+     * Swaps the elements of a Join.
+     * Glyph: `swap` (from Join interface, but also exposed here for discoverability)
+     * @param join The original Join.
+     * @param <F> Type of the first element.
+     * @param <S> Type of the second element.
+     * @return A new Join with elements swapped.
+     */
+    public static <F, S> Join<S, F> swap(Join<F, S> join) {
+        return join.swap();
+    }
+
+    // --- Series Operations (Compositional) ---
+
+    /**
+     * Applies a mapping function to each element of a Series.
+     * Glyph: `α` (alpha)
+     * @param series The input Series.
+     * @param mapper The function to apply to each element.
+     * @param <T> Original type of elements.
+     * @param <R> New type of elements.
+     * @return A new Series with the mapped elements.
+     */
+    public static <T, R> Series<R> α(Series<T> series, Function<? super T, ? extends R> mapper) {
+        return series.map(mapper);
+    }
+
+    /**
+     * Filters elements of a Series based on a predicate.
+     * Glyph: `filter` (from Series interface, but also exposed here for discoverability)
+     * @param series The input Series.
+     * @param predicate The predicate to test elements.
+     * @param <T> Type of elements.
+     * @return A new Series containing only elements that pass the predicate.
+     */
+    public static <T> Series<T> filter(Series<T> series, Predicate<? super T> predicate) {
+        return series.filter(predicate);
+    }
+
+    /**
+     * Provides an {@link Iterable} view of a {@link Series}.
+     * Glyph: `▶` (play button / iterator)
+     * @param series The Series to iterate over.
+     * @param <T> The type of elements in the series.
+     * @return An Iterable view.
+     */
+    public static <T> Iterable<T> ▶(Series<T> series) {
+        return series; // Series implements Iterable directly
+    }
+
+    /**
+     * Retrieves an element from a Series.
+     * Glyph: `get` (from Series interface, but also exposed here for discoverability)
+     * @param series The Series.
+     * @param index The index.
+     * @param <T> The type of elements.
+     * @return The element at the specified index.
+     */
+    public static <T> T get(Series<T> series, int index) {
+        return series.get(index);
+    }
+
+    /**
+     * Creates a slice of a Series.
+     * Glyph: `slice` (from Series interface, but also exposed here for discoverability)
+     * @param series The Series.
+     * @param range The index range.
+     * @param <T> The type of elements.
+     * @return A new Series representing the slice.
+     */
+    public static <T> Series<T> slice(Series<T> series, Series.IntRange range) {
+        return series.slice(range);
+    }
+
+    // Example of infix-like operation using nested static methods (less common for public API)
+    // public static <T, R> Series<R> mapOp(Series<T> series, Function<T, R> mapper) { return series.map(mapper); }
+}
+```
+
+**`bikeshed/src/main/java/com/yourdomain/bikeshed/types/TypeMemento.java`**
+(Base interface for type information.)
+
+```java
+package com.yourdomain.bikeshed.types;
+
+/**
+ * Interface for capturing type information within the DSEL, particularly for I/O and serialization.
+ * It defines the network size in bytes for fixed-size types.
+ */
+public interface TypeMemento {
+    /**
+     * Returns the fixed size in bytes for this type when serialized over a network or to disk.
+     * Returns {@code null} for variable-length types (e.g., String, Byte Array),
+     * which require external length management (e.g., a lookup table for `IoString`).
+     * @return The size in bytes, or {@code null} for variable-length types.
+     */
+    Integer networkSize();
+}
+```
