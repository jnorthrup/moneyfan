+**`bikeshed/src/main/java/com/yourdomain/bikeshed/core/Series.java`**
+(Cursor-based collection, representing `Join<Integer, Function<Integer, T>>`)
+
+```java
+package com.yourdomain.bikeshed.core;
+
+import java.util.AbstractList;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.Iterator;
+import java.util.List;
+import java.util.Objects;
+import java.util.function.Function;
+import java.util.function.IntFunction;
+import java.util.function.Predicate;
+import java.util.stream.IntStream;
+import java.util.stream.Stream;
+
+/**
+ * Represents a cursor-based collection, foundational for `Cursor` and `RowVec`.
+ * Conceptually, it's a {@code Join<Integer, Function<Integer, T>>}, where the integer
+ * is the size and the function provides elements by index. This design is optimized
+ * for ISAM data access patterns and memory-mapped files by providing lazy access.
+ *
+ * All operations on Series must be compositional, producing new instances.
+ *
+ * @param <T> The type of elements in the series.
+ */
+public interface Series<T> extends Join<Integer, IntFunction<T>>, Iterable<T> {
+
+    /**
+     * Gets the element at the specified index.
+     *
+     * @param index The index of the element.
+     * @return The element at the given index.
+     * @throws IndexOutOfBoundsException if the index is out of bounds.
+     */
+    default T get(int index) {
+        if (index < 0 || index >= size()) {
+            throw new IndexOutOfBoundsException("Index " + index + " out of bounds for size " + size());
+        }
+        return getSnd().apply(index);
+    }
+
+    /**
+     * Returns the size of the series.
+     * Alias: `size()`
+     *
+     * @return The number of elements in the series.
+     */
+    default int size() {
+        return getFst();
+    }
+
+    /**
+     * Checks if the series is empty.
+     *
+     * @return `true` if the series contains no elements, `false` otherwise.
+     */
+    default boolean isEmpty() {
+        return size() == 0;
+    }
+
+    /**
+     * Creates a new Series by applying a mapping function to each element.
+     * Compositional operation.
+     * Glyph: `α` (alpha for map/transform)
+     *
+     * @param mapper The function to apply to each element.
+     * @param <R>    The new type of elements in the series.
+     * @return A new `Series` with transformed elements.
+     */
+    default <R> Series<R> map(Function<? super T, ? extends R> mapper) {
+        int currentSize = size();
+        return Series.of(currentSize, index -> mapper.apply(get(index)));
+    }
+
+    /**
+     * Filters elements of the series based on a predicate, producing a new Series.
+     * The new series will maintain a mapping to the original indices for lazy evaluation.
+     *
+     * @param predicate The predicate to filter elements.
+     * @return A new `Series` containing only elements that satisfy the predicate.
+     */
+    default Series<T> filter(Predicate<? super T> predicate) {
+        List<Integer> matchingIndices = new ArrayList<>();
+        for (int i = 0; i < size(); i++) {
+            if (predicate.test(get(i))) {
+                matchingIndices.add(i);
+            }
+        }
+        return Series.of(matchingIndices.size(), index -> get(matchingIndices.get(index)));
+    }
+
+    /**
+     * Creates a new Series representing a slice of the current series.
+     * Compositional operation.
+     *
+     * @param start The starting index (inclusive).
+     * @param end   The ending index (exclusive).
+     * @return A new `Series` representing the specified slice.
+     * @throws IndexOutOfBoundsException if start or end are out of valid bounds.
+     */
+    default Series<T> slice(int start, int end) {
+        if (start < 0 || end > size() || start > end) {
+            throw new IndexOutOfBoundsException("Slice range [" + start + ", " + end + ") is invalid for size " + size());
+        }
+        int newSize = end - start;
+        return Series.of(newSize, index -> get(start + index));
+    }
+
+    /**
+     * Returns an `Iterable` view of this Series.
+     * Glyph: `▶` (play/forward arrow for iterable view)
+     *
+     * @return An `Iterable` that can be used in enhanced for-loops.
+     */
+    default Iterable<T> iterable() {
+        return this; // This interface already implements Iterable
+    }
+
+    @Override
+    default Iterator<T> iterator() {
+        return new Iterator<T>() {
+            private int currentIndex = 0;
+
+            @Override
+            public boolean hasNext() {
+                return currentIndex < size();
+            }
+
+            @Override
+            public T next() {
+                if (!hasNext()) {
+                    throw new java.util.NoSuchElementException();
+                }
+                return get(currentIndex++);
+            }
+        };
+    }
+
+    /**
+     * Converts the Series to a standard Java `List`.
+     * Note: This materializes the entire series into memory.
+     *
+     * @return A `List` containing all elements of the series.
+     */
+    default List<T> toList() {
+        class SeriesAsList extends AbstractList<T> {
+            @Override
+            public T get(int index) {
+                return Series.this.get(index);
+            }
+
+            @Override
+            public int size() {
+                return Series.this.size();
+            }
+        }
+        // Return a new ArrayList initialized from the AbstractList for a true copy
+        return new ArrayList<>(new SeriesAsList());
+    }
+
+    /**
+     * Factory method to create a `Series` instance.
+     *
+     * @param size     The total number of elements in the series.
+     * @param provider A function that provides the element at a given index.
+     * @param <T>      The type of elements in the series.
+     * @return A new `Series` instance.
+     */
+    static <T> Series<T> of(int size, IntFunction<T> provider) {
+        return new ImmutableSeries<>(size, provider);
+    }
+
+    /**
+     * Internal immutable implementation of `Series`.
+     */
+    class ImmutableSeries<T> implements Series<T> {
+        private final int size;
+        private final IntFunction<T> provider;
+
+        private ImmutableSeries(int size, IntFunction<T> provider) {
+            this.size = size;
+            this.provider = provider;
+        }
+
+        @Override
+        public Integer getFst() {
+            return size;
+        }
+
+        @Override
+        public IntFunction<T> getSnd() {
+            return provider;
+        }
+
+        @Override
+        public boolean equals(Object o) {
+            if (this == o) return true;
+            if (o == null || getClass() != o.getClass()) return false;
+            ImmutableSeries<?> that = (ImmutableSeries<?>) o;
+            // For equality, we need to compare elements, not just the provider function itself
+            // This can be expensive for large series, but necessary for semantic equality.
+            if (size != that.size) return false;
+            for (int i = 0; i < size; i++) {
+                if (!Objects.equals(get(i), that.get(i))) {
+                    return false;
+                }
+            }
+            return true;
+        }
+
+        @Override
+        public int hashCode() {
+            // Hash code based on elements, similar to List.hashCode()
+            int result = 1;
+            for (int i = 0; i < size; i++) {
+                result = 31 * result + (get(i) == null ? 0 : get(i).hashCode());
+            }
+            return result;
+        }
+
+        @Override
+        public String toString() {
+            // Lazy toString to avoid materializing entire series
+            return "Series(size=" + size + ", firstFew=" +
+                    IntStream.range(0, Math.min(size, 5))
+                            .mapToObj(this::get)
+                            .collect(Collectors.toList()) +
+                    (size > 5 ? ", ..." : "") + ")";
+        }
+    }
+}
+```
