+package com.yourdomain.bikeshed.core;
+
+import com.yourdomain.bikeshed.types.ColumnMeta;
+
+import java.util.Objects;
+import java.util.function.Function;
+import java.util.function.IntFunction;
+import java.util.function.Supplier;
+
+/**
+ * Represents a row of data with associated metadata.
+ * Internally, it's a `Series<Join<Object, () -> ColumnMeta>>`.
+ * Each element in the Series is a Join of a value and a supplier function for its ColumnMeta.
+ * This allows for lazy loading of metadata if needed, or simply provides a consistent structure.
+ */
+public class RowVec extends Series<Join<Object, Supplier<ColumnMeta>>> {
+
+    /**
+     * Constructs a RowVec.
+     * @param size The number of columns in the row.
+     * @param provider A function to provide a Join<Object, Supplier<ColumnMeta>> for each column index.
+     */
+    public RowVec(int size, IntFunction<Join<Object, Supplier<ColumnMeta>>> provider) {
+        super(size, provider);
+    }
+
+    /**
+     * Factory method to create a RowVec from an array of (value, metadataSupplier) pairs.
+     * @param valuesAndMeta An array of Join instances, each containing a value and a supplier for its ColumnMeta.
+     * @return A new RowVec instance.
+     */
+    @SafeVarargs
+    public static RowVec of(Join<Object, Supplier<ColumnMeta>>... valuesAndMeta) {
+        Objects.requireNonNull(valuesAndMeta, "valuesAndMeta array must not be null");
+        return new RowVec(valuesAndMeta.length, i -> valuesAndMeta[i]);
+    }
+
+    /**
+     * Convenience method to get the value at a specific column index.
+     * @param index The column index.
+     * @return The value at that column.
+     */
+    public Object getValue(int index) {
+        return get(index).first();
+    }
+
+    /**
+     * Convenience method to get the ColumnMeta for a specific column index.
+     * The supplier is invoked to get the actual ColumnMeta object.
+     * @param index The column index.
+     * @return The ColumnMeta for that column.
+     */
+    public ColumnMeta getMeta(int index) {
+        return get(index).second().get(); // Call the supplier to get the ColumnMeta
+    }
+
+    /**
+     * Maps the values of the RowVec, returning a new Series of the transformed values.
+     * The metadata suppliers are preserved (by returning the original Join with only the first element mapped),
+     * or can be mapped if explicitly needed by a more complex mapper.
+     *
+     * @param mapper Function to apply to each value.
+     * @param <R> New type of the values.
+     * @return A new Series where each element is the transformed value.
+     */
+    public <R> Series<R> mapValues(Function<Object, R> mapper) {
+        Objects.requireNonNull(mapper, "mapper must not be null");
+        return this.map(join -> mapper.apply(join.first()));
+    }
+}
