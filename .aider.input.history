+```java
+package com.yourdomain.bikeshed.cursor;
+
+import com.yourdomain.bikeshed.core.Join;
+
+/**
+ * Represents metadata for a data column, containing its name and type information.
+ * This is a foundational interface for defining schemas in a flexible way.
+ * It is backed by a {@link Join} for its two primary components.
+ *
+ * This effectively acts as a type alias for `Join<String, TypeMemento>`.
+ */
+public interface ColumnMeta extends Join<String, TypeMemento> {
+
+    /**
+     * Returns the name of the column.
+     *
+     * @return The column name.
+     */
+    default String getName() {
+        return getFst();
+    }
+
+    /**
+     * Returns the type memento for the column, which contains information
+     * about its data type and serialization properties.
+     *
+     * @return The column's type memento.
+     */
+    default TypeMemento getType() {
+        return getSnd();
+    }
+
+    /**
+     * Factory method to create a ColumnMeta instance.
+     *
+     * @param name The column name.
+     * @param type The type memento.
+     * @return A new ColumnMeta instance.
+     */
+    static ColumnMeta of(String name, TypeMemento type) {
+        return new ImmutableColumnMeta(name, type);
+    }
+
+    /**
+     * Internal immutable implementation for ColumnMeta.
+     */
+    class ImmutableColumnMeta extends Join.ImmutableJoin<String, TypeMemento> implements ColumnMeta {
+        private ImmutableColumnMeta(String name, TypeMemento type) {
+            super(name, type);
+        }
+    }
+}
