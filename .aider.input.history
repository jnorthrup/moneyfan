+import java.time.Instant;
+import java.time.LocalDate;
+import java.util.HashMap;
+import java.util.Map;
+import java.util.Objects;
+import java.util.function.Function;
+
+public enum IOMemento implements TypeMemento {
+    IoBoolean(1), IoByte(1), IoShort(2), IoInt(4), IoLong(8), IoFloat(4), IoDouble(8), IoChar(2),
+    IoLocalDate(8) { // epoch days (long)
+        @Override public Function<ByteBuffer, Object> createDecoder(int size) { return buffer -> { /* dummy */ return LocalDate.ofEpochDay(buffer.getLong()); }; }
+        @Override public Function<Object, ByteBuffer> createEncoder(int size) { return value -> { /* dummy */ ByteBuffer buf = ByteBuffer.allocate(size); buf.putLong(((LocalDate)value).toEpochDay()); buf.flip(); return buf; }; }
+    },
+    IoInstant(12) { // 8 bytes for epoch seconds (long), 4 bytes for nanos (int)
+        @Override public Function<ByteBuffer, Object> createDecoder(int size) { return buffer -> { /* dummy */ long epochSeconds = buffer.getLong(); int nanos = buffer.getInt(); return Instant.ofEpochSecond(epochSeconds, nanos); }; }
+        @Override public Function<Object, ByteBuffer> createEncoder(int size) { return value -> { /* dummy */ Instant inst = (Instant)value; ByteBuffer buf = ByteBuffer.allocate(size); buf.putLong(inst.getEpochSecond()); buf.putInt(inst.getNano()); buf.flip(); return buf; }; }
+    },
+    IoString(null), IoByteArray(null), IoNothing(0);
+
+    private final Integer networkSize;
+    IOMemento(Integer networkSize) { this.networkSize = networkSize; }
+    @Override public Integer getNetworkSize() { return networkSize; }
+
+    public Function<ByteBuffer, Object> createDecoder(int size) {
+        return buffer -> {
+            Integer actualSize = Objects.requireNonNullElse(networkSize, size);
+            if (buffer.remaining() < actualSize) throw new IllegalStateException("Not enough bytes for " + name());
+            return switch (this) {
+                case IoBoolean -> buffer.get() != 0; case IoByte -> buffer.get(); case IoShort -> buffer.getShort();
+                case IoInt -> buffer.getInt(); case IoLong -> buffer.getLong(); case IoFloat -> buffer.getFloat();
+                case IoDouble -> buffer.getDouble(); case IoChar -> buffer.getChar();
+                case IoString -> { byte[] bytes = new byte[size]; buffer.get(bytes); yield new String(bytes); }
+                case IoByteArray -> { byte[] bytes = new byte[size]; buffer.get(bytes); yield bytes; }
+                case IoNothing -> null;
+                default -> throw new UnsupportedOperationException("Decoder not implemented for " + this.name());
+            };
+        };
+    }
+    public Function<Object, ByteBuffer> createEncoder(int size) {
+        return value -> {
+            ByteBuffer buffer = ByteBuffer.allocate(Objects.requireNonNullElse(networkSize, size));
+            switch (this) {
+                case IoBoolean: buffer.put((byte) (((Boolean) value) ? 1 : 0)); break; case IoByte: buffer.put((Byte) value); break;
+                case IoShort: buffer.putShort((Short) value); break; case IoInt: buffer.putInt((Integer) value); break;
+                case IoLong: buffer.putLong((Long) value); break; case IoFloat: buffer.putFloat((Float) value); break;
+                case IoDouble: buffer.putDouble((Double) value); break; case IoChar: buffer.putChar((Character) value); break;
+                case IoString: byte[] strBytes = ((String) value).getBytes(); buffer.put(strBytes, 0, Math.min(strBytes.length, size)); for (int i = strBytes.length; i < size; i++) buffer.put((byte)0); break;
+                case IoByteArray: byte[] bArr = (byte[]) value; buffer.put(bArr, 0, Math.min(bArr.length, size)); for (int i = bArr.length; i < size; i++) buffer.put((byte)0); break;
+                case IoNothing: break;
+                default: throw new UnsupportedOperationException("Encoder not implemented for " + this.name());
+            }
+            buffer.flip(); return buffer;
+        };
+    }
+    public static Map<String, Integer> STRING_LENGTH_CONFIG = new HashMap<>(); static { STRING_LENGTH_CONFIG.put("defaultString", 255); }
+}
