+package com.yourdomain.bikeshed.cursor;
+
+/**
+ * Interface for type information within the DSEL, providing metadata
+ * necessary for serialization and deserialization, especially for ISAM integration.
+ */
+public interface TypeMemento {
+    /**
+     * Returns the fixed size in bytes for network/disk serialization, if applicable.
+     * For variable-length types (e.g., strings), this should be {@code null}.
+     *
+     * @return The network size in bytes, or {@code null} for variable-length types.
+     */
+    Integer getNetworkSize();
