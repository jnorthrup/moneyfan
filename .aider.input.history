+package com.yourdomain.bbcursive;
+
+import java.nio.ByteBuffer;
+import java.util.function.Function;
+
+/**
+ * Represents a parser function that takes a ByteBuffer and produces a result of type T.
+ * It's a functional interface for composable parsing operations.
+ *
+ * @param <T> The type of the parsed result.
+ */
+@FunctionalInterface
+public interface Cursive<T> extends Function<ByteBuffer, T> {
+    // apply(ByteBuffer buffer) method is inherited from Function.
+    // This interface serves as a marker and semantic clarification.
+}
