+        //        Sine() {
+        //            // no-op
+        //        }
+        /**
+         * Returns sine(input).
+         */
+        override fun invoke(input: Double ): Double = sin(input)
+
+        override fun applyDiff(x: Double ): Double = cos(x)
+
+        /**
+        getMaxValue
