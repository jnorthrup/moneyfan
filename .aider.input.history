+//         */
+//        override fun apply(input: Double Array, bias: Double ): Double {
+//            if (input.size > 0) {
+//                if (input.size < 2) {
+//                    return input[0]
+//                }
+//                val v = input[0] / input[1]
+//                if (java.lang.Double .isNaN(v) || java.lang.Double .isInfinite(v)) {
+//                    val pos = sign(input[0]) == sign(input[1])
+//                    return (if (pos) Double .MAX_VALUE else -Double .MAX_VALUE)
+//                }
+//                return max(-Double .MAX_VALUE, min(Double .MAX_VALUE, v))
+//            }
+//            return 0.0
+//        }
+//
+//        /**
