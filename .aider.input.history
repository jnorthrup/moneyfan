+                                CONN_DENSITY = 0.00001,
+                                0.0
+                        )
+
+                        Population(Array<Gnome>(Environment.sim.POPULATION) { Gnome() }.toList())
+                        rb  = (runtime.freeMemory()-baseFree.toDouble()).absoluteValue.toLong()
+                        rk  = rb.absoluteValue / 1024
