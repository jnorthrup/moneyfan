+    @DisplayName("ingest should handle empty lines and trailing newlines")
+    void testIngestWithEmptyLines() {
+        String csvData = "h1,h2\nval1,val2\n\nval3,val4\n";
+        ByteBuffer buffer = ByteBuffer.wrap(csvData.getBytes(StandardCharsets.UTF_8));
+
+        Cursor cursor = CsvProcessor.ingest(buffer, true, (byte) ',');
+
+        assertNotNull(cursor);
+        assertEquals(2, cursor.size()); // Expecting 2 data rows, skipping empty
+        assertEquals("val1", cursor.get(0).getValue(0));
+        assertEquals("val3", cursor.get(1).getValue(0));
+    }
+
+    @Test
+    @DisplayName("ingest should handle different delimiters")
+    void testIngestWithDifferentDelimiter() {
+        String csvData = "name|age\nAlice|30\nBob|25";
+        ByteBuffer buffer = ByteBuffer.wrap(csvData.getBytes(StandardCharsets.UTF_8));
+
+        Cursor cursor = CsvProcessor.ingest(buffer, true, (byte) '|');
+
+        assertNotNull(cursor);
+        assertEquals(2, cursor.size());
+        assertEquals("name", cursor.get(0).getMeta(0).name());
+        assertEquals("Alice", cursor.get(0).getValue(0));
+        assertEquals("30", cursor.get(0).getValue(1));
+    }
+
+    @Test
+    @DisplayName("ingest should return empty Cursor for empty input")
+    void testIngestEmptyInput() {
+        String csvData = "";
+        ByteBuffer buffer = ByteBuffer.wrap(csvData.getBytes(StandardCharsets.UTF_8));
+        Cursor cursor = CsvProcessor.ingest(buffer, true, (byte) ',');
+        assertNotNull(cursor);
+        assertEquals(0, cursor.size());
+    }
+
+    // Direct tests for the internal bbcursive-based parsers used by CsvProcessor.ingest
+    @Test
+    @DisplayName("csvFieldParser should parse a field until delimiter or newline")
+    void testCsvFieldParser() {
+        ByteBuffer buffer = ByteBuffer.wrap("field1,field2\n".getBytes(StandardCharsets.UTF_8));
+        Cursive<String> parser = CsvProcessor.csvFieldParser((byte) ',');
+        assertEquals("field1", parser.apply(buffer));
+        assertEquals(6, buffer.position()); // Position after "field1"
+    }
+
