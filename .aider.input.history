+        // Test decoding
+        ByteBuffer bufferTrue = ByteBuffer.wrap(new byte[]{1});
+        assertTrue((Boolean) IOMemento.IoBoolean.createDecoder(1).apply(bufferTrue));
+
+        ByteBuffer bufferFalse = ByteBuffer.wrap(new byte[]{0});
+        assertFalse((Boolean) IOMemento.IoBoolean.createDecoder(1).apply(bufferFalse));
+    }
+
+    @Test
+    @DisplayName("IoInt should have networkSize 4 and correctly encode/decode")
+    void testIoInt() {
+        assertEquals(4, IOMemento.IoInt.getNetworkSize());
+
+        // Test encoding
+        int testInt = 123456789;
+        ByteBuffer encoded = IOMemento.IoInt.createEncoder(4).apply(testInt);
+        assertEquals(4, encoded.remaining());
+        assertEquals(testInt, encoded.getInt());
+
+        // Test decoding
+        ByteBuffer buffer = ByteBuffer.allocate(4).putInt(987654321).flip();
+        assertEquals(987654321, IOMemento.IoInt.createDecoder(4).apply(buffer));
