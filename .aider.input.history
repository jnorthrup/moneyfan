+**`bikeshed/src/main/java/com/yourdomain/bikeshed/core/MutableSeries.java`**
+(Mutable Series interface for COW patterns)
+
+```java
+package com.yourdomain.bikeshed.core;
+
+/**
+ * Defines a mutable interface for a {@link Series}.
+ * Implementations of this interface are expected to support modification operations,
+ * often in a Copy-On-Write (COW) manner to maintain functional purity and immutability
+ * at a higher level, while providing mutability locally.
+ *
+ * All methods that modify the series should, in a COW implementation, return a new instance
+ * or trigger an internal copy, ensuring that existing references to the series remain immutable.
+ *
+ * @param <T> The type of elements in the series.
+ */
+public interface MutableSeries<T> extends Series<T> {
+
+    /**
+     * Sets the element at the specified index to the given item.
+     *
+     * @param index The index of the element to set.
+     * @param item  The new item to place at the index.
+     * @throws IndexOutOfBoundsException if the index is out of bounds.
+     */
+    void set(int index, T item);
+
+    /**
+     * Appends the specified item to the end of the series.
+     *
+     * @param item The item to add.
+     */
+    void add(T item);
+
+    /**
+     * Inserts the specified item at the specified position in this series.
+     * Shifts the element currently at that position (if any) and any subsequent
+     * elements to the right (adds one to their indices).
+     *
+     * @param index The index at which to insert the item.
+     * @param item  The item to be inserted.
+     * @throws IndexOutOfBoundsException if the index is out of range
+     *                                   ({@code index < 0 || index > size()}).
+     */
+    void add(int index, T item);
+
+    /**
+     * Removes the element at the specified index from this series.
+     * Shifts any subsequent elements to the left (subtracts one from their indices).
+     *
+     * @param index The index of the element to be removed.
+     * @return The element that was removed from the series.
+     * @throws IndexOutOfBoundsException if the index is out of bounds.
+     */
+    T removeAt(int index);
+
+    /**
+     * Removes the first occurrence of the specified item from this series, if it is present.
+     * If the series does not contain the item, it is unchanged.
+     *
+     * @param item The item to be removed.
+     * @return `true` if the item was found and removed, `false` otherwise.
+     */
+    boolean remove(T item);
+
+    /**
+     * Removes all of the elements from this series.
+     * The series will be empty after this call returns.
+     */
+    void clear();
+
+    /**
+     * Appends an item to the series (operator style).
+     *
+     * @param item The item to append.
+     * @return The modified mutable series.
+     */
+    MutableSeries<T> plus(T item);
+
+    /**
+     * Removes the first occurrence of an item from the series (operator style).
+     *
+     * @param item The item to remove.
+     * @return The modified mutable series.
+     */
+    MutableSeries<T> minus(T item);
+
+    /**
+     * Appends an item to the series (compound assignment operator style).
+     *
+     * @param item The item to append.
+     */
+    void plusAssign(T item);
+
+    /**
+     * Removes the first occurrence of an item from the series (compound assignment operator style).
+     *
+     * @param item The item to remove.
+     */
+    void minusAssign(T item);
+}
+
+```
