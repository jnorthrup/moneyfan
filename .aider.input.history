+**2.4. `bbcursive/src/main/java/com/yourdomain/bbcursive/BBCombinator.java`**
+```java
+package com.yourdomain.bbcursive;
+
+import java.nio.ByteBuffer;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Optional;
+import java.util.Objects;
+
+/**
+ * Utility enum for higher-order ByteBuffer parsing functions (combinators).
+ * These compose `Cursive` instances to build more complex parsers.
+ */
+public enum BBCombinator {
+    // No specific instances needed, just static utility methods.
+    ;
+
+    /**
+     * Creates a Cursive parser that sequences multiple parsers.
+     * The parsers are applied in order, and their results are collected into a List.
+     * If any parser in the sequence fails, the entire sequence fails, and the buffer
+     * position is reset to its state before the sequence attempt.
+     *
+     * @param parsers An array of Cursive parsers.
+     * @param <T> The common supertype of the results of the parsers.
+     * @return A Cursive parser that returns a List of results.
+     */
+    @SafeVarargs
+    public static <T> Cursive<List<T>> sequence(Cursive<? extends T>... parsers) {
+        return buffer -> {
+            Objects.requireNonNull(buffer, "ByteBuffer must not be null");
+            int originalPosition = buffer.position();
+            List<T> results = new ArrayList<>();
+            try {
+                for (Cursive<? extends T> parser : parsers) {
+                    results.add(parser.apply(buffer));
+                }
+                return results;
+            } catch (Exception e) {
+                buffer.position(originalPosition); // Rewind on failure
+                throw new IllegalStateException("Sequence parsing failed", e);
+            }
+        };
+    }
+
+    /**
+     * Creates a Cursive parser that tries multiple parsers in order until one succeeds.
+     * The buffer position is reset before trying the next parser if the current one fails.
+     *
+     * @param parsers An array of Cursive parsers.
+     * @param <T> The common supertype of the results of the parsers.
+     * @return A Cursive parser that returns an Optional containing the first successful result.
+     *         If no parser succeeds, an empty Optional is returned.
+     */
+    @SafeVarargs
+    public static <T> Cursive<Optional<T>> choice(Cursive<? extends T>... parsers) {
+        return buffer -> {
+            Objects.requireNonNull(buffer, "ByteBuffer must not be null");
+            int originalPosition = buffer.position();
+            for (Cursive<? extends T> parser : parsers) {
+                try {
+                    return Optional.of(parser.apply(buffer));
+                } catch (Exception e) {
+                    buffer.position(originalPosition); // Rewind if parser fails
+                }
+            }
+            return Optional.empty();
+        };
+    }
+
+    /**
+     * Creates a Cursive parser that makes a given parser optional.
+     * Returns an Optional containing the result if the parser succeeds, otherwise an empty Optional.
+     * If the parser fails, the buffer position is reset.
+     */
+    public static <T> Cursive<Optional<T>> optional(Cursive<T> parser) {
+        return buffer -> {
+            Objects.requireNonNull(buffer, "ByteBuffer must not be null");
+            Objects.requireNonNull(parser, "Parser must not be null");
+            int originalPosition = buffer.position();
+            try {
+                return Optional.of(parser.apply(buffer));
+            } catch (Exception e) {
+                buffer.position(originalPosition); // Rewind on failure
+                return Optional.empty();
+            }
+        };
+    }
+
+    /**
+     * Creates a Cursive parser that applies a given parser zero or more times.
+     * It consumes as much input as possible until the parser fails.
+     * The buffer position is reset on the last (failing) attempt.
+     */
+    public static <T> Cursive<List<T>> many(Cursive<T> parser) {
+        return buffer -> {
+            Objects.requireNonNull(buffer, "ByteBuffer must not be null");
+            Objects.requireNonNull(parser, "Parser must not be null");
+            List<T> results = new ArrayList<>();
+            while (true) {
+                int originalPosition = buffer.position();
+                try {
+                    results.add(parser.apply(buffer));
+                } catch (Exception e) {
+                    buffer.position(originalPosition); // Rewind on failure
+                    break; // Stop parsing if parser fails
+                }
+            }
+            return results;
+        };
+    }
+}
+```
+
